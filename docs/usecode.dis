L02F6:	db	'gold'
L02FA:	db	00
L02FB:	db	'all of these'
L0307:	db	00
L0308:	db	'"Dost thou have a suspect?"'
L0323:	db	00
L0324:	db	'"Well, continue to gather information until thou dost have o'
	db	'ne."*'
L0365:	db	00
L0366:	db	'gold'
L036A:	db	00
L036B:	db	'a medallion'
L0376:	db	00
L0377:	db	'a scroll'
L037F:	db	00
L0380:	db	'"Hmmm. I cannot believe that was all. Perhaps thou shouldst '
	db	'search again."*'
L03CB:	db	00
L03CC:	db	'none of these'
L03D9:	db	00
L03DA:	db	'"I do not believe thou hast searched properly."*'
L040A:	db	00
L040B:	db	'"What dost this villain look like?"'
L042E:	db	00
L042F:	db	'eyepatch'
L0437:	db	00
