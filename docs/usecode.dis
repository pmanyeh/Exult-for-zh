		.data
L0000:	db	'bye'
L0003:	db	00
L0004:	db	'Fellowship'
L000E:	db	00
L000F:	db	'job'
L0012:	db	00
L0013:	db	'name'
L0017:	db	00
L0018:	db	'"To have not the time to speak now. To talk after meeting."*'
L0054:	db	00
L0055:	db	'"To have not the time to speak now. To hurry to Fellowship m'
	db	'eeting."*'
L009A:	db	00
L009B:	db	'The gargoyle, a contented grin on his face, greets you with '
	db	'a handshake.'
L00E3:	db	00
L00E4:	db	'"To express happiness at your return," says Quaeven.'
L0118:	db	00
L0119:	db	'name'
L011D:	db	00
L011E:	db	'"To be known as Quaeven, human."'
L013E:	db	00
L013F:	db	'name'
L0143:	db	00
L0144:	db	'Quaeven'
L014B:	db	00
L014C:	db	'Quaeven'
L0153:	db	00
L0154:	db	'"To mean `problem finder.' To be an observant one.'
L0186:	db	00
L0187:	db	'Quaeven'
L018E:	db	00
L018F:	db	'job'
L0192:	db	00
L0193:	db	'"To be master of the Recreation Facility and Learning Center'
	db	'. To be in charge of much information valuable to the gargoy'
	db	'le race."'
L0214:	db	00
L0215:	db	'Learning Center'
L0224:	db	00
L0225:	db	'Recreation Facility'
L0238:	db	00
L0239:	db	'Recreation Facility'
L024C:	db	00
L024D:	db	'"To be a good place for gargoyles to go to exercise their mu'
	db	'scles. To have many resources available, including stuffed b'
	db	'ags to punch and practice fighting skills."'
L02F0:	db	00
L02F1:	db	'Recreation Facility'
L0304:	db	00
L0305:	db	'Learning Center'
L0314:	db	00
L0315:	db	'"To be located in the same building as the Recreation Center'
	db	'. To provide an excellent atmosphere for strengthening gargo'
	db	'yle minds. To have a large supply of books and educational m'
	db	'aterial."'
L03D2:	db	00
L03D3:	db	'Learning Center'
L03E2:	db	00
L03E3:	db	'Fellowship'
L03ED:	db	00
L03EE:	db	'"To be a member, too." He holds up his medallion. To have ne'
	db	'eded The Fellowship to become happy."'
L044F:	db	00
L0450:	db	'needed The Fellowship'
L0465:	db	00
L0466:	db	'"To want to know about the organization or the tenets?"'
L049D:	db	00
L049E:	db	'organization'
L04AA:	db	00
L04AB:	db	'tenets'
L04B1:	db	00
L04B2:	db	'Fellowship'
L04BC:	db	00
L04BD:	db	'organization'
L04C9:	db	00
L04CA:	db	'"To be a group of spiritual seekers striving to reach the hi'
	db	'ghest levels of gargoyle potential. To share with all gargoy'
	db	'les and humans."'
L0552:	db	00
L0553:	db	'share'
L0558:	db	00
L0559:	db	'organization'
L0565:	db	00
L0566:	db	'share'
L056B:	db	00
L056C:	db	'"To share tenets and material well-being."'
L0596:	db	00
L0597:	db	'material well-being'
L05AA:	db	00
L05AB:	db	'tenets'
L05B1:	db	00
L05B2:	db	'share'
L05B7:	db	00
L05B8:	db	'material well-being'
L05CB:	db	00
L05CC:	db	'"To support financially and personally a poorhouse in Paws. '
	db	'To organize feasts and festivals in Britannia to help morale'
	db	'. To be a much needed group by all gargoyles and men. To hav'
	db	'e needed The Fellowship myself!"'
L06A0:	db	00
L06A1:	db	'needed The Fellowship'
L06B6:	db	00
L06B7:	db	'material well-being'
L06CA:	db	00
L06CB:	db	'tenets'
L06D1:	db	00
L06D2:	db	'"To apply an optimistic order of thought through the Triad o'
	db	'f Inner Strength."'
L0720:	db	00
L0721:	db	'Triad'
L0726:	db	00
L0727:	db	'tenets'
L072D:	db	00
L072E:	db	'Triad'
L0733:	db	00
L0734:	db	'"To be the three concepts of Strive for Unity, Trust your Br'
	db	'other, and Worthiness Precedes Reward."'
L0797:	db	00
L0798:	db	'Triad'
L079D:	db	00
L079E:	db	'needed The Fellowship'
L07B3:	db	00
L07B4:	db	'"To have had poor life before The Fellowship. To have been p'
	db	'ained, ignored, and mistreated by many.~~"To be happy now in'
	db	' my new life and, to hope to hear the voice soon." His eyes '
	db	'widen in excitement. "To be bringing happiness to another's '
	db	'life soon."'
L08AF:	db	00
L08B0:	db	'another'
L08B7:	db	00
L08B8:	db	'voice'
L08BD:	db	00
L08BE:	db	'needed The Fellowship'
L08D3:	db	00
L08D4:	db	'voice'
L08D9:	db	00
L08DA:	db	'"To be a good voice that will help me make choices, and to h'
	db	'elp win on Buccaneer's Den."'
L0932:	db	00
L0933:	db	'voice'
L0938:	db	00
L0939:	db	'another'
L0940:	db	00
L0941:	db	'He continues on, excitedly.~~"To be working on my first conv'
	db	'ert. To know the joy and well-being I will bring. To feel co'
	db	'ntent and happy."'
L09CA:	db	00
L09CB:	db	'convert'
L09D2:	db	00
L09D3:	db	'working'
L09DA:	db	00
L09DB:	db	'another'
L09E2:	db	00
L09E3:	db	'working'
L09EA:	db	00
L09EB:	db	'"To need a little more persuasion," he looks down, "but to b'
	db	'e almost ready to join!"'
L0A3F:	db	00
L0A40:	db	'working'
L0A47:	db	00
L0A48:	db	'convert'
L0A4F:	db	00
L0A50:	db	'"To be Betra, the provisioner. To feel confident he will joi'
	db	'n soon."'
L0A94:	db	00
L0A95:	db	'convert'
L0A9C:	db	00
L0A9D:	db	'bye'
L0AA0:	db	00
L0AA1:	db	'"To hope for your well-being and happiness."*'
L0ACE:	db	00
