L04C2:	db	00
L04C3:	db	'cave'
L04C7:	db	00
L04C8:	db	'"Cave good. Warm. Safe."'
L04E0:	db	00
L04E1:	db	'"It's been good to us. It keeps us warm. We are able to find'
	db	' food. I do not miss the old life."'
