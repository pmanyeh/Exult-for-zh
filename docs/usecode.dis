		.data
L0000:	db	'The non-corporeal man stares past you, seemingly past the co'
	db	'nfines of the building, and, perhaps, of the world. Then, he'
	db	' suddenly shudders, as if he is filled with pain.*'
L00AA:	db	00
L00AB:	db	'bye'
L00AE:	db	00
L00AF:	db	'job'
L00B2:	db	00
L00B3:	db	'name'
L00B7:	db	00
L00B8:	db	'The ghostly man displays a face filled with pain.'
L00E9:	db	00
L00EA:	db	'"Greetings, '
L00F6:	db	00
L00F7:	db	'." Caine breathes deeply, apparently forcing back his tormen'
	db	't.'
L0135:	db	00
L0136:	db	'questions'
L013F:	db	00
L0140:	db	'need formula'
L014C:	db	00
