L0000:	db	'bye'
L0003:	db	00
L0004:	db	'job'
L0007:	db	00
L0008:	db	'name'
L000C:	db	00
L000D:	db	'The man before you shyly looks away.'
L0031:	db	00
L0032:	db	'"H-H-How m-m-may I h-h-help thee, '
L0054:	db	00
L0055:	db	'?"'
L0057:	db	00
L0058:	db	'stutter'
L005F:	db	00
L0060:	db	'stutter'
L0067:	db	00
L0068:	db	'"What st-st-stutter?"  He turns to leave.*'
L0092:	db	00
L0093:	db	'Moonglow'
L009B:	db	00
L009C:	db	'He points to the ground. "That is here!"'
L00C4:	db	00
L00C5:	db	'Moonglow'
L00CD:	db	00
L00CE:	db	'name'
L00D2:	db	00
L00D3:	db	'"M-M-Morz."'
L00DE:	db	00
L00DF:	db	'stutter'
L00E6:	db	00
L00E7:	db	'name'
L00EB:	db	00
L00EC:	db	'job'
L00EF:	db	00
L00F0:	db	'"I work with C-C-Cubolt, f-f-farming here."'
L011B:	db	00
L011C:	db	'here'
L0120:	db	00
L0121:	db	'stutter'
L0128:	db	00
L0129:	db	'C-C-Cubolt'
L0133:	db	00
L0134:	db	'Cubolt'
L013A:	db	00
L013B:	db	'here'
L013F:	db	00
L0140:	db	'"M-M-Moonglow."'
L014F:	db	00
L0150:	db	'Moonglow'
L0158:	db	00
L0159:	db	'here'
L015D:	db	00
L015E:	db	'T-T-Tolemac'
L0169:	db	00
L016A:	db	'C-C-Cubolt'
L0174:	db	00
L0175:	db	'"That is n-n-not f-f-funny!" He blushes, and angrily turns a'
	db	'way.*'
L01B6:	db	00
L01B7:	db	'Cubolt'
L01BD:	db	00
L01BE:	db	'"He is T-T-Tolemac's older br-br-brother. I t-t-trust him."'
L01F9:	db	00
L01FA:	db	'stutter'
L0201:	db	00
L0202:	db	'T-T-Tolemac'
L020D:	db	00
L020E:	db	'Tolemac'
L0215:	db	00
L0216:	db	'C-C-Cubolt'
L0220:	db	00
L0221:	db	'Cubolt'
L0227:	db	00
L0228:	db	'Tolemac'
L022F:	db	00
L0230:	db	'"T-T-Tolemac is m-m-my f-f-friend. I've kn-kn-known h-h-him '
	db	'f-f-for a long t-t-time. He just joined The F-F-Fellowship. '
	db	'He wants m-m-me t-t-to join, t-t-too."'
L02CE:	db	00
L02CF:	db	'Fellowship'
L02D9:	db	00
L02DA:	db	'T-T-Tolemac'
L02E5:	db	00
L02E6:	db	'Tolemac'
L02ED:	db	00
L02EE:	db	'Fellowship'
L02F8:	db	00
L02F9:	db	'"T-T-Tolemac says they d-d-do m-m-many g-g-good things and t'
	db	'hey would h-h-help m-m-me m-m-make f-f-friends m-m-more easi'
	db	'ly. C-C-Cubolt thinks they're b-b-bad. I d-d-do not kn-kn-kn'
	db	'ow what t-t-to d-d-do."'
L03C4:	db	00
L03C5:	db	'don't join'
L03CF:	db	00
L03D0:	db	'Fellowship'
L03DA:	db	00
L03DB:	db	'don't join'
L03E5:	db	00
L03E6:	db	'"Thou d-d-dost n-n-not think I should join? C-C-Cubolt does '
	db	'not want m-m-me t-t-to either. I s-s-suppose I won't. I than'
	db	'k thee."'
L0466:	db	00
L0467:	db	'don't join'
L0471:	db	00
L0472:	db	'bye'
L0475:	db	00
L0476:	db	'"B-b-bye."*'
