L0455:	db	00
L0456:	db	'hook'
L045A:	db	00
L045B:	db	'"That is not satisfactory. Thou must needs continue thy sear'
	db	'ch, Avatar."*'
L04A4:	db	00
L04A5:	db	'"Hmmm. Any leads on finding this villain?"'
L04CF:	db	00
L04D0:	db	'No one saw him'
