		.funcnumber	04A9H
		.data
L0000:	db	'bye'
L0003:	db	00
L0004:	db	'job'
L0007:	db	00
L0008:	db	'name'
L000C:	db	00
L000D:	db	'You see a simple peasant woman. Her face is etched with sorr'
	db	'ow.'
L004C:	db	00
L004D:	db	'"Good day, '
L0058:	db	00
L0059:	db	'," says Alina.'
L0067:	db	00
L0068:	db	'name'
L006C:	db	00
L006D:	db	'"I am Alina."'
L007A:	db	00
L007B:	db	'name'
L007F:	db	00
L0080:	db	'job'
L0083:	db	00
L0084:	db	'"I have none, '
L0092:	db	00
L0093:	db	', save for being the mother of my child. I am waiting for mi'
	db	'ne husband, Weston, to return from Britain."'
L00FB:	db	00
L00FC:	db	'Weston'
L0102:	db	00
L0103:	db	'child'
L0108:	db	00
L0109:	db	'child'
L010E:	db	00
L010F:	db	'"Cassie is my daughter. Just a wee babe, she is mine only jo'
	db	'y."'
L014E:	db	00
L014F:	db	'child'
L0154:	db	00
L0155:	db	'Weston'
L015B:	db	00
L015C:	db	'"Good news, '
L0168:	db	00
L0169:	db	'! Mine husband was pardoned by Lord British. He even provide'
	db	'd Weston with short-term employment so that he may return to'
	db	' me with money enough in his pockets to feed us for some tim'
	db	'e!~~"Excellent news, no?"'
L0236:	db	00
L0237:	db	'"Mine husband is imprisoned in Britain for stealing fruit fr'
	db	'om the Royal Orchards."'
L028A:	db	00
L028B:	db	'stealing'
L0293:	db	00
L0294:	db	'Weston'
L029A:	db	00
L029B:	db	'stealing'
L02A3:	db	00
L02A4:	db	'"Mine husband is no thief, '
L02BF:	db	00
L02C0:	db	'. He went there to buy fruit for the child and me so that we'
	db	' would have enough to eat. He has been wrongfully accused, I'
	db	' am certain of it!"'
L034B:	db	00
L034C:	db	'eat'
L034F:	db	00
L0350:	db	'stealing'
L0358:	db	00
L0359:	db	'eat'
L035C:	db	00
L035D:	db	'"We are very poor. My baby and I are presently living in the'
	db	' Fellowship shelter because we have nowhere else to go."'
L03D1:	db	00
L03D2:	db	'shelter'
L03D9:	db	00
L03DA:	db	'Fellowship'
L03E4:	db	00
L03E5:	db	'eat'
L03E8:	db	00
L03E9:	db	'Fellowship'
L03F3:	db	00
L03F4:	db	'"It was a member of The Fellowship that has accused mine hus'
	db	'band. Now they wish for me to join them."'
L0459:	db	00
L045A:	db	'accused'
L0461:	db	00
L0462:	db	'join them'
L046B:	db	00
L046C:	db	'"Mine husband is innocent, I know it!. He intended to buy th'
	db	'e fruit. Why must I join thy society in order for me to be t'
	db	'aken at my word?"'
L04F5:	db	00
L04F6:	db	'Fellowship'
L0500:	db	00
L0501:	db	'shelter'
L0508:	db	00
L0509:	db	'"We are fortunate that we are able to live by The Fellowship'
	db	''s good graces, but I do not know how long we will be allowe'
	db	'd to stay."'
L058C:	db	00
L058D:	db	'allowed'
L0594:	db	00
L0595:	db	'shelter'
L059C:	db	00
L059D:	db	'join them'
L05A6:	db	00
L05A7:	db	'"I cannot join The Fellowship without feeling that I am betr'
	db	'aying mine husband. How could I become one of those who have'
	db	' falsely accused him? Yet, if I do not, they will not allow '
	db	'my child and me to live here."~~She sobs and covers her face'
	db	' with her hands. "It is so unfair. I must choose between sta'
	db	'rvation and betrayal. If only Weston were here. I do not kno'
	db	'w what to do!"'
L071D:	db	00
L071E:	db	'join them'
L0727:	db	00
L0728:	db	'accused'
L072F:	db	00
L0730:	db	'"They say if I join they will attempt to free mine husband. '
	db	'But it was they who unjustly accused him. I cannot trust the'
	db	'm, but I fear I may have no choice."'
L07CC:	db	00
L07CD:	db	'accused'
L07D4:	db	00
L07D5:	db	'allowed'
L07DC:	db	00
L07DD:	db	'"They tell me the shelter is only for members of The Fellows'
	db	'hip. Unless I join soon, I shall be asked to leave. And I ha'
	db	've nowhere else to go."'
L086C:	db	00
L086D:	db	'allowed'
L0874:	db	00
L0875:	db	'bye'
L0878:	db	00
L0879:	db	'"Pleasant day to thee, '
L0890:	db	00
L0891:	db	'."*'
L0894:	db	00
