L02BF:	db	00
L02C0:	db	'fruits'
L02C6:	db	00
L02C7:	db	'"Fruits are pleasant-tasting, like the honey you gave us!"'
L0301:	db	00
L0302:	db	'fruits'
L0308:	db	00
L0309:	db	'Emps'
L030D:	db	00
L030E:	db	'"I am an Emp. Saralek is an Emp. Salamon is an Emp. You," he'
	db	' smiles, "are a human."'
