L0055:	db	00
L0056:	db	'blacksmith'
L0060:	db	00
L0061:	db	'"That is not right. Thou shouldst do some more work."*'
L0097:	db	00
L0098:	db	'"What didst thou find at the murder site?"'
L00C2:	db	00
L00C3:	db	'a bucket'
L00CB:	db	00
L00CC:	db	'a key'
L00D1:	db	00
L00D2:	db	'a body'
