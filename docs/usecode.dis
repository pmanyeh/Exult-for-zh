L0000:	db	'You are wary of conversing with that trickster Chuckles, but'
	db	' decide to anyway.'
L004E:	db	00
L004F:	db	'bye'
L0052:	db	00
L0053:	db	'job'
L0056:	db	00
L0057:	db	'name'
L005B:	db	00
L005C:	db	'"I will speak if thou dost play The Game, friend," Chuckles '
	db	'says.'
L009D:	db	00
L009E:	db	'Game'
L00A2:	db	00
L00A3:	db	'bye'
L00A6:	db	00
L00A7:	db	'job'
L00AA:	db	00
L00AB:	db	'name'
L00AF:	db	00
L00B0:	db	'"I must not say my name, lest I break the rule of The Game!"'
L00EC:	db	00
L00ED:	db	'name'
L00F1:	db	00
L00F2:	db	'Game'
L00F6:	db	00
L00F7:	db	'job'
L00FA:	db	00
L00FB:	db	'"I was, am, and shall be the Court...Fool! I could give thee'
	db	' a clue if I wish, but for now my job is to play The Game."'
L0172:	db	00
L0173:	db	'Game'
L0177:	db	00
L0178:	db	'clue'
L017C:	db	00
L017D:	db	'"Art thou sure thou canst play The Game?"'
L01A6:	db	00
L01A7:	db	'"Thou must play The Game to get the clue!"'
L01D1:	db	00
L01D2:	db	'"Oops. I did give thee one!"'
L01EE:	db	00
L01EF:	db	'clue'
L01F3:	db	00
L01F4:	db	'Game'
L01F8:	db	00
L01F9:	db	'"Thou must play The Game if thou dost want to speak with me.'
	db	'"'
L0236:	db	00
L0237:	db	'Explain it'
L0241:	db	00
L0242:	db	'I know The Game'
L0251:	db	00
L0252:	db	'What are the rules?'
