L01E3:	db	'lost'
L01E7:	db	00
L01E8:	db	'lost'
L01EC:	db	00
L01ED:	db	'"Well... I am sure it is not permanent." He blushes. "I just'
	db	' need to get my bearings, that's all," he says unconvincingl'
	db	'y.'
L0267:	db	00
L0268:	db	'lost'
L026C:	db	00
L026D:	db	'Abbey'
L0272:	db	00
L0273:	db	'"I am a monk of the Brotherhood of the Rose. I study geograp'
	db	'hy and nature with a brother named Taylor."'
L02DA:	db	00
L02DB:	db	'Abbey'
L02E0:	db	00
L02E1:	db	'Taylor'
L02E7:	db	00
L02E8:	db	'nature'
