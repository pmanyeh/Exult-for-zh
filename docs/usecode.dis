L02CE:	db	00
L02CF:	db	'Aurvidlem'
L02D8:	db	00
L02D9:	db	'For-Lem'
L02E0:	db	00
L02E1:	db	'"To perform assorted duties for town. To be a good, strong w'
	db	'orker."'
