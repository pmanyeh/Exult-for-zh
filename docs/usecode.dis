L0192:	db	'name'
L0196:	db	00
L0197:	db	'Balayna's accusation'
L01AB:	db	00
L01AC:	db	'job'
L01AF:	db	00
L01B0:	db	'"I am the new branch leader of The Fellowship here in Moongl'
	db	'ow."'
L01F0:	db	00
L01F1:	db	'voice'
L01F6:	db	00
L01F7:	db	'Balayna's accusation'
