L0228:	db	00
L0229:	db	'secret ore'
L0233:	db	00
L0234:	db	'blackrock'
L023D:	db	00
L023E:	db	'blackrock'
L0247:	db	00
L0248:	db	'"To be the lode located in a hidden area of the mine..." The'
	db	' gargoyle's eyes roll up into his head. He is obviously sick'
	db	'.'
L02C1:	db	00
L02C2:	db	'blackrock'
L02CB:	db	00
