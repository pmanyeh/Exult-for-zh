		.data
L0000:	db	'bye'
L0003:	db	00
L0004:	db	'job'
L0007:	db	00
L0008:	db	'name'
L000C:	db	00
L000D:	db	'leave'
L0012:	db	00
L0013:	db	'join'
L0017:	db	00
L0018:	db	'Lord Heather'
L0024:	db	00
L0025:	db	'heal'
L0029:	db	00
L002A:	db	'You are surprised to see your old companion Jaana, looking o'
	db	'nly slightly aged since your last visit.'
L008E:	db	00
L008F:	db	'"Yes, '
L0095:	db	00
L0096:	db	'?" Jaana asks.'
L00A4:	db	00
L00A5:	db	'name'
L00A9:	db	00
L00AA:	db	'"Why, I am Jaana. Thou shouldst remember me!"'
L00D7:	db	00
L00D8:	db	'name'
L00DC:	db	00
L00DD:	db	'Lord Heather'
L00E9:	db	00
L00EA:	db	'job'
L00ED:	db	00
L00EE:	db	'"I have been the Cove Healer for some time now, and can prov'
	db	'ide thee with mine healing services. Since magic is not reli'
	db	'able, I have been yearning to join a party of adventurers, s'
	db	'uch as mine old friends. I miss the old life!"'
L01D0:	db	00
L01D1:	db	'magic'
L01D6:	db	00
L01D7:	db	'friends'
L01DE:	db	00
L01DF:	db	'heal'
L01E3:	db	00
L01E4:	db	'join'
L01E8:	db	00
L01E9:	db	'heal'
L01ED:	db	00
L01EE:	db	'"I am sorry, I must wait a while before I can heal again."'
L0228:	db	00
L0229:	db	'friends'
L0230:	db	00
L0231:	db	'"Our old friends -- Iolo, Shamino, and Dupre. The men who co'
	db	'nquer evil in the name of Lord British!"'
L0295:	db	00
L0296:	db	'friends'
L029D:	db	00
L029E:	db	'Lord British'
L02AA:	db	00
L02AB:	db	'Dupre'
L02B0:	db	00
L02B1:	db	'Shamino'
L02B8:	db	00
L02B9:	db	'Iolo'
L02BD:	db	00
L02BE:	db	'join'
L02C2:	db	00
L02C3:	db	'"I would be honored to join thee, '
L02E5:	db	00
L02E6:	db	'!"'
L02E8:	db	00
L02E9:	db	'leave'
L02EE:	db	00
L02EF:	db	'join'
L02F3:	db	00
L02F4:	db	'"I do believe thou dost have too many members travelling in '
	db	'thy group. I shall wait until someone leaves and thou dost a'
	db	'sk me again."'
L0379:	db	00
L037A:	db	'leave'
L037F:	db	00
L0380:	db	'"Dost thou want me to wait here or should I go home?"'
L03B5:	db	00
L03B6:	db	'go home'
L03BD:	db	00
L03BE:	db	'wait here'
L03C7:	db	00
L03C8:	db	'wait here'
L03D1:	db	00
L03D2:	db	'"Very well. I shall wait until thou dost return."*'
L0404:	db	00
L0405:	db	'"I shall obey thy wish. I would be happy to re-join if thou '
	db	'shouldst ask. Goodbye."*'
L0459:	db	00
L045A:	db	'magic'
L045F:	db	00
L0460:	db	'"My magic has been affected by something in the air, but I h'
	db	'ave found that my senses are still with me. Hast thou notice'
	db	'd that the mages in the land are afflicted in the head? It i'
	db	's most disconcerting. Nevertheless, I can manage to cast a s'
	db	'pell or two most of the time."'
L056E:	db	00
L056F:	db	'"I feel that the ether is flowing smoothly now. Magic is ali'
	db	've again!"'
L05B5:	db	00
L05B6:	db	'magic'
L05BB:	db	00
L05BC:	db	'Lord Heather'
L05C8:	db	00
L05C9:	db	'Jaana blushes. "Yes, I have been seeing our Town Mayor for s'
	db	'ome time now."'
L0613:	db	00
L0614:	db	'Lord Heather'
L0620:	db	00
L0621:	db	'"I see that thou art leaving Cove for a while, my dear?"*'
L065A:	db	00
L065B:	db	'"Yes, milord. But I shall return. I promise thee."*'
L068E:	db	00
L068F:	db	'"I shall try not to worry about thee, but it will be difficu'
	db	'lt."*'
L06D0:	db	00
L06D1:	db	'"Do not worry. I shall be safe with the Avatar."*'
L0702:	db	00
L0703:	db	'"I do hope so." The Mayor embraces Jaana.*'
L072D:	db	00
L072E:	db	'Iolo'
L0732:	db	00
L0733:	db	'"Where is he? 'Twould be good to see him!"'
L075D:	db	00
L075E:	db	'"He looks the same to me! Perhaps he has a little more waist'
	db	'line than before... but that is to be expected if one stays '
	db	'away from adventuring for too long!"*'
L07FB:	db	00
L07FC:	db	'"What dost thou mean? 'Little more waistline' indeed!"*'
L0833:	db	00
L0834:	db	'"No offense intended, Iolo!"'
L0850:	db	00
L0851:	db	'Iolo'
L0855:	db	00
L0856:	db	'Shamino'
L085D:	db	00
L085E:	db	'"Oh, I would love to see him. I wonder where he might be."'
L0898:	db	00
L0899:	db	'"Shamino, thou dost not look like a 'kid' anymore! What dids'
	db	't happen? Didst thou reach the venerable age of thirty?"*'
L090E:	db	00
L090F:	db	'"Hmph. I am still a kid at heart."*'
L0932:	db	00
L0933:	db	'"That is a relief." She grins cheekily.'
L095A:	db	00
L095B:	db	'Shamino'
L0962:	db	00
L0963:	db	'Dupre'
L0968:	db	00
L0969:	db	'"I miss having a drink or two with that rogue! Let's go find'
	db	' that knight!"'
L09B3:	db	00
L09B4:	db	'"For someone recently knighted, he has retained his good loo'
	db	'ks and boyish charm, hasn't he?"*'
L0A11:	db	00
L0A12:	db	'"Thou dost mean 'mannish' charm, dost thou not?"*'
L0A43:	db	00
L0A44:	db	'"Oh, pardon -me-, sir. Thine immaturity confused me for a mo'
	db	'ment."*'
L0A87:	db	00
L0A88:	db	'"Art thou going to let her get away with that, '
L0AB7:	db	00
L0AB8:	db	'?"'
L0ABA:	db	00
L0ABB:	db	'Dupre is speechless and turns away in a huff.*'
L0AE9:	db	00
L0AEA:	db	'"Good!" Jaana winks at you from behind his back.*'
L0B1B:	db	00
L0B1C:	db	'Dupre'
L0B21:	db	00
L0B22:	db	'Lord British'
L0B2E:	db	00
L0B2F:	db	'"I have not seen our liege in many years."'
L0B59:	db	00
L0B5A:	db	'Lord British'
L0B66:	db	00
L0B67:	db	'bye'
L0B6A:	db	00
L0B6B:	db	'"Goodbye, '
L0B75:	db	00
L0B76:	db	'."*'
