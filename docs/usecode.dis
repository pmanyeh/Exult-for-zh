L0000:	db	'You see a wingless gargoyle with a terrible skin disease. It'
	db	' looks as if his face is falling off in patches.'
L006C:	db	00
L006D:	db	'"To want something else?" Fodus asks.'
L0092:	db	00
L0093:	db	'bye'
L0096:	db	00
L0097:	db	'job'
L009A:	db	00
L009B:	db	'name'
