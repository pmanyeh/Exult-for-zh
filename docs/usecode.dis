L0000:	db	'bye'
L0003:	db	00
L0004:	db	'job'
L0007:	db	00
L0008:	db	'name'
L000C:	db	00
L000D:	db	'You see a winged gargoyle with an authoritative disposition.'
L0049:	db	00
L004A:	db	'"To offer welcome for you, human," says Wis-Sur.'
L007A:	db	00
L007B:	db	'The winged gargoyle in front of you has a wild look about hi'
	db	'm.'
L00B9:	db	00
L00BA:	db	'"To go away, human! To have nothing you want!" screams Wis-S'
	db	'ur.'
L00F9:	db	00
L00FA:	db	'name'
L00FE:	db	00
L00FF:	db	'"To be named Wis-Sur, which means `wise sun.'"'
L012D:	db	00
L012E:	db	'name'
L0132:	db	00
L0133:	db	'job'
L0136:	db	00
L0137:	db	'"To sell magic to others."'
