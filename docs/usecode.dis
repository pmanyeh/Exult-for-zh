		.funcnumber	04D3H
		.data
L0000:	db	'bye'
L0003:	db	00
L0004:	db	'job'
L0007:	db	00
L0008:	db	'name'
L000C:	db	00
L000D:	db	'You are greeted with a smile from this gargoyle.'
L003D:	db	00
L003E:	db	'"To be pleased to again see you, human." Lap-Lem smiles.'
L0076:	db	00
L0077:	db	'give amulet'
L0082:	db	00
L0083:	db	'name'
L0087:	db	00
L0088:	db	'"To be known to you as Lap-Lem."'
L00A8:	db	00
L00A9:	db	'Lap-Lem'
L00B0:	db	00
L00B1:	db	'name'
L00B5:	db	00
L00B6:	db	'Blorn'
L00BB:	db	00
L00BC:	db	'Lap-Lem'
L00C3:	db	00
L00C4:	db	'"To mean `rock one.'"'
L00D9:	db	00
L00DA:	db	'Lap-Lem'
L00E1:	db	00
L00E2:	db	'job'
L00E5:	db	00
L00E6:	db	'"To be a miner. To be now the only miner of my race in this '
	db	'town."'
L0128:	db	00
L0129:	db	'town'
L012D:	db	00
L012E:	db	'race'
L0132:	db	00
L0133:	db	'only miner'
L013D:	db	00
L013E:	db	'race'
L0142:	db	00
L0143:	db	'"To know of many gargoyles who work in the other mines, but '
	db	'to see the Vesper mine has only humans now."'
L01AB:	db	00
L01AC:	db	'race'
L01B0:	db	00
L01B1:	db	'town'
L01B5:	db	00
L01B6:	db	'"To be called Vesper. To be the only place, other than parts'
	db	' of Britain, where gargoyles live with humans. To tell you t'
	db	'hat here are more conflicts." He sighs.~~"To wonder if Terfi'
	db	'n would be a better choice to maintain a home."'
L0299:	db	00
L029A:	db	'town'
L029E:	db	00
L029F:	db	'Terfin'
L02A5:	db	00
L02A6:	db	'conflicts'
L02AF:	db	00
L02B0:	db	'conflicts'
L02B9:	db	00
L02BA:	db	'"To see the humans grow in hostility to us. Sadly, to also s'
	db	'ee many gargoyles begin to show mutual feelings. To hope the'
	db	' situation never becomes violent."'
L0354:	db	00
L0355:	db	'conflicts'
L035E:	db	00
L035F:	db	'Terfin'
L0365:	db	00
L0366:	db	'"To be the gargoyle home city. To have been constructed two '
	db	'hundred years ago when the codex was placed in the void and '
	db	'the gargoyles were without places to live. Though not prohib'
	db	'ited, no humans reside there."'
L0438:	db	00
L0439:	db	'Terfin'
L043F:	db	00
L0440:	db	'only miner'
L044A:	db	00
L044B:	db	'"To tell you that there was another -- Anmanivas. To have le'
	db	'ft because of racial hatred. To sit now in tavern all day wi'
	db	'th brother, Foranamo. To feel bad for Anmanivas and brother,'
	db	' but to need job." He shrugs.~~ "To put up with hatred."'
L0537:	db	00
L0538:	db	'only miner'
L0542:	db	00
L0543:	db	'Blorn'
L0548:	db	00
L0549:	db	'"To know of incident?'
L055E:	db	00
L055F:	db	'"To be very sorry for attack, but was in defense of possessi'
	db	'on." He lowers his head as if ashamed.'
L05C1:	db	00
L05C2:	db	'"To be ashamed. To want nothing more than return of my posse'
	db	'ssion from human."'
L0610:	db	00
L0611:	db	'possession'
L061B:	db	00
L061C:	db	'Blorn'
L0621:	db	00
L0622:	db	'possession'
L062C:	db	00
L062D:	db	'"To have had an amulet with sentimental value. To have been '
	db	'stolen by the human." He looks down at his feet. "To want it'
	db	' back."'
L06AC:	db	00
L06AD:	db	'possession'
L06B7:	db	00
L06B8:	db	'give amulet'
L06C3:	db	00
L06C4:	db	'"To have returned with amulet?"'
L06E3:	db	00
L06E4:	db	'He grins widely as you return the jewelry to him.~~ "To than'
	db	'k you, human! To be an example for your race!"'
L074E:	db	00
L074F:	db	'"Oh. To not have amulet with you." He perks up and smiles. "'
	db	'To return later with amulet!"'
L07A8:	db	00
L07A9:	db	'give amulet'
L07B4:	db	00
L07B5:	db	'bye'
L07B8:	db	00
L07B9:	db	'"To hope to see you again soon."*'
L07DA:	db	00
