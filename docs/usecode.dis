L078A:	db	'"The slaughterhouse is closed. Come around when it is open f'
	db	'or business and I shall sell thee meats then."'
L07F4:	db	00
L07F5:	db	'buy meat'
L07FD:	db	00
L07FE:	db	'nothing'
