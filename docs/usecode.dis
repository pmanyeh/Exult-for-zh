L0C70:	db	'another'
L0C77:	db	00
L0C78:	db	'another'
L0C7F:	db	00
L0C80:	db	'"I know not who, '
L0C91:	db	00
L0C92:	db	', and Pendaran would not say!"'
L0CB0:	db	00
L0CB1:	db	'another'
L0CB8:	db	00
L0CB9:	db	'bye'
L0CBC:	db	00
L0CBD:	db	'"May fortune follow thee, '
