L00BA:	db	'name'
L00BE:	db	00
L00BF:	db	'job'
L00C2:	db	00
L00C3:	db	'"To be a digger in the mines. To be looking for iron ore and'
	db	' lead and..."'
L010C:	db	00
L010D:	db	'and...'
L0113:	db	00
L0114:	db	'and...'
L011A:	db	00
L011B:	db	'"The secret ore..."'
L012E:	db	00
L012F:	db	'A wave of delirium passes over the gargoyle. "To... to be go'
	db	'ing back to work now, Mikos!... To be working hard!... To ha'
	db	've no need to give me any more of the the silver fluid..."'
L01E1:	db	00
L01E2:	db	'and...'
L01E8:	db	00
L01E9:	db	'silver fluid'
L01F5:	db	00
L01F6:	db	'secret ore'
L0200:	db	00
L0201:	db	'secret ore'
L020B:	db	00
