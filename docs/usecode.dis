L0242:	db	00
L0243:	db	'gatherer'
L024B:	db	00
L024C:	db	'"No job is had by me."'
L0262:	db	00
L0263:	db	'gatherer'
L026B:	db	00
L026C:	db	'"All Emps are food-gatherers. Mainly fruits are sought by us'
	db	'."'
L02AA:	db	00
L02AB:	db	'gatherer'
L02B3:	db	00
L02B4:	db	'Emps'
