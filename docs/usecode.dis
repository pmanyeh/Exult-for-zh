L014A:	db	' gold altogether.'
L015B:	db	00
L015C:	db	'"It appears that thou dost not seem to have enough gold to t'
	db	'rain here. If thou couldst return later after thy pockets ar'
	db	'e filled..."'
L01E0:	db	00
