L00BF:	db	'name'
L00C3:	db	00
L00C4:	db	'"I am and always will be the one called Adjhar."'
L00F4:	db	00
L00F5:	db	'name'
L00F9:	db	00
L00FA:	db	'job'
L00FD:	db	00
L00FE:	db	'"Now that thou hast mastered the Principle of Love, I no lon'
