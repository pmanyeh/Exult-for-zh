L00E7:	db	'a body'
L00ED:	db	00
L00EE:	db	'"I know that! What ELSE didst thou find? Thou shouldst look '
	db	'again, Avatar!"*'
L013A:	db	00
L013B:	db	'a bucket'
L0143:	db	00
L0144:	db	'"Yes, obviously it is filled with poor Christopher's own blo'
	db	'od. But surely there was something else that might point us '
	db	'in the direction of the killer or killers - thou shouldst lo'
	db	'ok again, Avatar."*'
L020B:	db	00
L020C:	db	'nothing'
L0213:	db	00
L0214:	db	'"Thou shouldst look again, 'Avatar'!"*'
L023A:	db	00
L023B:	db	'"What did the key open?"'
L0253:	db	00
