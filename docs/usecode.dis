L09CF:	db	'resident of throne'
L09E1:	db	00
L09E2:	db	'"Thine ignorance doth make me skittish,~"surely thou hast he'
	db	'ard of wise Lord British."'
L0A38:	db	00
L0A39:	db	'resident of throne'
L0A4B:	db	00
L0A4C:	db	'woman'
L0A51:	db	00
L0A52:	db	'"The awakening of mine heart's idyll,~"Lies 'neath me for I '
	db	'see her still,~"No bard could e'er describe nor tell,~"the t'
	db	'enderness of my fair Nell."'
L0AE5:	db	00
L0AE6:	db	'woman'
L0AEB:	db	00
L0AEC:	db	'Nell'
L0AF0:	db	00
L0AF1:	db	'Nell'
L0AF5:	db	00
L0AF6:	db	'"'Tis said love is a fiery angel,~"Riding soft silk wings of'
	db	' pure redemption,~"My puppet's heart still as an anvil,~"At '
	db	'the wicked thrill of her attention.~"By mine angel Nell I am'
	db	' anointed,~"Humble cowardice felled by Passion's blade,~"As '
	db	'her beloved I was hence appointed,~"Perchance through destin'
	db	'y a marriage made."'
L0C35:	db	00
L0C36:	db	'Nell'
L0C3A:	db	00
L0C3B:	db	'marriage'
