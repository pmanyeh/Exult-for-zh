		.funcnumber	04E1H	;* Sintag
		.data
L0000:	db	'bye'
L0003:	db	00
L0004:	db	'job'
L0007:	db	00
L0008:	db	'name'
L000C:	db	00
L000D:	db	'Hook'
L0011:	db	00
L0012:	db	'You see the meanest, toughest-looking guard you have ever se'
	db	'en in Britannia.'
L005E:	db	00
L005F:	db	'"What?" Sintag grunts.'
L0075:	db	00
L0076:	db	'name'
L007A:	db	00
L007B:	db	'"Sintag," the man grunts.'
L0094:	db	00
L0095:	db	'name'
L0099:	db	00
L009A:	db	'job'
L009D:	db	00
L009E:	db	'"I am the guard at the House of Games. I rid the place of tr'
	db	'ouble-makers."'
L00E8:	db	00
L00E9:	db	'trouble-makers'
L00F7:	db	00
L00F8:	db	'House of Games'
L0106:	db	00
L0107:	db	'House of Games'
L0115:	db	00
L0116:	db	'"I have worked for the House of Games since The Mister agree'
	db	'd to pay me and asked me to stay. I know all who go in or ou'
	db	't. I see everything."'
L01A3:	db	00
L01A4:	db	'House of Games'
L01B2:	db	00
L01B3:	db	'The Mister'
L01BD:	db	00
L01BE:	db	'The Mister'
L01C8:	db	00
L01C9:	db	'"That would be Mister Gordy, the overseer of the House of Ga'
	db	'mes. Thou might find him in his office during business hours'
	db	'."'
L0243:	db	00
L0244:	db	'The Mister'
L024E:	db	00
L024F:	db	'trouble-makers'
L025D:	db	00
L025E:	db	'"We see all sorts of trouble-makers in this place. I especia'
	db	'lly do not like people who claim that they are the Avatar. I'
	db	' find it blasphemous. The last fellow who claimed to be an A'
	db	'vatar was caught cheating. He'll not be doin' that again!"'
L034C:	db	00
L034D:	db	'trouble-makers'
L035B:	db	00
L035C:	db	'not again'
L0365:	db	00
L0366:	db	'all sorts'
L036F:	db	00
L0370:	db	'all sorts'
L0379:	db	00
L037A:	db	'"There is a man named Robin who used to come in here and che'
	db	'at at the games. He had his two varlets named Battles and Le'
	db	'avell intimidate anyone who tried to stop him. One day my br'
	db	'others came to visit and we ran Robin, Battles and Leavell a'
	db	'll the way off the island! We have not seen them since!"'
L04A2:	db	00
L04A3:	db	'all sorts'
L04AC:	db	00
L04AD:	db	'not again'
L04B6:	db	00
L04B7:	db	'The Cube vibrates a little. "He is in the caverns, in the to'
	db	'rture chamber. What's left of him."'
L0516:	db	00
L0517:	db	'left of him'
L0522:	db	00
L0523:	db	'torture chamber'
L0532:	db	00
L0533:	db	'"Thou dost not need to know any more."'
L0559:	db	00
L055A:	db	'Sintag glares at you.'
L056F:	db	00
L0570:	db	'not again'
L0579:	db	00
L057A:	db	'torture chamber'
L0589:	db	00
L058A:	db	'The Cube vibrates. "It is where The Fellowship interrogates '
	db	'their prisoners."'
L05D7:	db	00
L05D8:	db	'"What torture chamber? Did I say torture chamber?"'
L060A:	db	00
L060B:	db	'torture chamber'
L061A:	db	00
L061B:	db	'left of him'
L0626:	db	00
L0627:	db	'"He has been in our care for a while now." Sintag smiles eni'
	db	'gmatically.'
L066E:	db	00
L066F:	db	'left of him'
L067A:	db	00
L067B:	db	'Hook'
L067F:	db	00
L0680:	db	'The Cube vibrates as Sintag speaks. "Hook lives in the caver'
	db	'n behind the House of Games. There is a locked door from the'
	db	' gaming room which leads there. I have the key. There is als'
	db	'o a secret door in Gordy's office which Hook uses to get hom'
	db	'e."'
L0773:	db	00
L0774:	db	'key'
L0777:	db	00
L0778:	db	'"I do not know any man by that description."'
L07A4:	db	00
L07A5:	db	'"Do I look like I am working now? Leave me alone. Come to th'
	db	'e House of Games during normal business hours."'
L0810:	db	00
L0811:	db	'Hook'
L0815:	db	00
L0816:	db	'key'
L0819:	db	00
L081A:	db	'"Dost thou want the key?"'
L0833:	db	00
L0834:	db	'"Here it is."'
L0841:	db	00
L0842:	db	'"Thou art carrying too much!"'
L085F:	db	00
L0860:	db	'"Suit thyself."'
L086F:	db	00
L0870:	db	'key'
L0873:	db	00
L0874:	db	'bye'
L0877:	db	00
L0878:	db	'Sintag grunts.*'
L0887:	db	00
L0888:	db	'@I am watching thine hands!@'
L08A4:	db	00
L08A5:	db	'@No cheating!@'
L08B3:	db	00
L08B4:	db	'@Keep thine hands where I can see 'em.@'
L08DB:	db	00
L08DC:	db	'@No funny stuff with the games.@'
L08FC:	db	00
