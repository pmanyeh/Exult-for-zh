	.dsize       03E5H
L0000:	db	'"To be able to heal, cure poison, and resurrect. To be inter'
	db	'ested in one of these services?"'
	db	00
L005D:	db	'"To need which of my services?"'
	db	00
L007D:	db	'resurrect'
	db	00
L0087:	db	'cure poison'
	db	00
L0093:	db	'heal'
	db	00
L0098:	db	'heal'
	db	00
L009D:	db	'cure poison'
	db	00
L00A9:	db	'heal'
	db	00
L00AE:	db	'healed'
	db	00
L00B5:	db	'cure poison'
	db	00
L00C1:	db	'cured of poison'
	db	00
L00D1:	db	'"To want to '
	db	00
L00DE:	db	' whom?"'
	db	00
L00E6:	db	'"To have no need for my healing."'
	db	00
L0108:	db	'resurrect'
	db	00
L0112:	db	'"To not see anyone who is in need of resurrection. To have t'
	db	'o see the body to save the spirit. To lay your companion on '
	db	'the ground so that I may return them to this world."*'
	db	00
L01C0:	db	'"To be sorely wounded. To attempt to restore them to this wo'
	db	'rld."'
	db	00
L0202:	db	'"To charge '
	db	00
L020E:	db	' gold. To still want my services?"'
	db	00
L0231:	db	'heal'
	db	00
L0236:	db	'"To have healed the wounds."'
	db	00
L0253:	db	'"To seem quite healthy!"'
	db	00
L026C:	db	'"To be already healthy!"'
	db	00
L0285:	db	'cure poison'
	db	00
L0291:	db	'"To have healed the wounds."'
	db	00
L02AE:	db	'"To not need curing!"'
	db	00
L02C4:	db	'resurrect'
	db	00
L02CE:	db	'"To not be able to save them. To give them a proper burial  '
	db	'  for you."'
	db	00
L0316:	db	'"To breathe again. To be alive!"'
	db	00
L0337:	db	'"To have not that much gold! To perhaps return with more and'
	db	' purchase the service then."'
	db	00
L0390:	db	'"Sorry. To look elsewhere for that service then."'
	db	00
L03C2:	db	'"To be here later if you need me."'
	db	00
