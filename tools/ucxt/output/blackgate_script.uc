L0093:	db	'"Surely thou dost recognize thine old companion, Mariah?"*'
	db	00
L00CE:	db	'"Hast thou already forgotten me, '
	db	00
L00F0:	db	'? I am Mariah."'
	db	00
L0100:	db	'name'
	db	00
L0105:	db	'job'
	db	00
L0109:	db	'"I sell spells, reagents, and sometimes a few potions here a'
	db	't the Lycaeum. Dost thou wish to buy any of these, '
	db	00
L0179:	db	'?"'
	db	00
L017C:	db	'Lycaeum'
	db	00
