	; Function at file offset 00070784H
	.funcnumber  044DH
	.data
	.msize       0CC8H
	.dsize       0A36H
L0000:	db	'bye'
	db	00
L0004:	db	'job'
	db	00
L0008:	db	'name'
	db	00
L000D:	db	'Nastassia'
	db	00
L0017:	db	'Lock Lake'
	db	00
L0021:	db	'bill'
	db	00
L0026:	db	'This regal gentleman epitomizes a well-liked politician.'
	db	00
L005F:	db	'"Hello! Lord British sent word that thou might come to visit'
	db	' us. Welcome to Cove, Avatar!"'
	db	00
L00BA:	db	'"Hello again, Avatar!" Lord Heather proclaims.'
	db	00
L00E9:	db	'name'
	db	00
L00EE:	db	'"I am Lord Heather. And I recognize thee, Avatar!"'
	db	00
L0121:	db	'name'
	db	00
L0126:	db	'job'
	db	00
L012A:	db	'"I am the Town Mayor of Cove, home of the Shrine of Compassi'
	db	'on."'
	db	00
L016B:	db	'Shrine'
	db	00
L0172:	db	'Cove'
	db	00
L0177:	db	'Cove'
	db	00
L017C:	db	'"It\'s a small place, I know. Many of our residents have mov'
	db	'ed away to the larger towns, especially Britain. But we have'
	db	' maintained a small core of loyal Covites."'
	db	00
L021F:	db	'Cove'
	db	00
L0224:	db	'Shrine'
	db	00
L022B:	db	'"We are proud of our Shrine. One of our residents takes good'
	db	' care of it. Thou must try and visit the Shrine if thou hast'
	db	' not already. It is a monument to all the lovers in town."'
	db	00
L02DE:	db	'lovers'
	db	00
L02E5:	db	'Shrine'
	db	00
L02EC:	db	'lovers'
	db	00
L02F3:	db	'"Britain may be the city of Compassion, but Cove has become '
	db	'the city of Passion. Everyone here seems to fall in love rat'
	db	'her easily. Thou wilt find that everyone loves someone. Almo'
	db	'st everyone, that is."'
	db	00
L03BE:	db	'lovers'
	db	00
L03C5:	db	'almost everyone'
	db	00
L03D5:	db	'everyone'
	db	00
L03DE:	db	'everyone'
	db	00
L03E7:	db	'"Well, let\'s see... I am in love with Jaana, our healer.\tA'
	db	'nd she is in love with me, of course. Then there is Zinaida,'
	db	' who runs the Emerald. She has an interest in De Maria, our '
	db	'local bard. And vice versa. Rayburt, our trainer, is courtin'
	db	'g Pamela, the innkeeper."'
	db	00
L04EF:	db	'"Sounds like bad theatre to me!"'
	db	00
L0510:	db	'"Any wenches mine own age around here?"*'
	db	00
L0539:	db	'everyone'
	db	00
L0542:	db	'"I see that thou art leaving Cove for a while, my dear?"*'
	db	00
L057C:	db	'"Yes, milord. But I shall return. I promise thee."*'
	db	00
L05B0:	db	'"I shall try not to worry about thee, but it will be difficu'
	db	'lt."*'
	db	00
L05F2:	db	'"Do not worry. I shall be safe with the Avatar."*'
	db	00
L0624:	db	'"I do hope so." The Mayor embraces Jaana.*'
	db	00
L064F:	db	'almost everyone'
	db	00
L065F:	db	'"Except for Nastassia."'
	db	00
L0677:	db	'almost everyone'
	db	00
L0687:	db	'Nastassia'
	db	00
L0691:	db	'Nastassia'
	db	00
L069B:	db	'"She is a lovely young woman who is always melancholy. De Ma'
	db	'ria can tell thee more about her. I suggest thou seekest him'
	db	' at the Emerald. \'Tis a sad but compelling tale."'
	db	00
L0745:	db	'someone'
	db	00
L074D:	db	'a man like thee'
	db	00
L075D:	db	'"I do hope thou canst help her. She needs '
	db	00
L0788:	db	' to bring her out of her depression."'
	db	00
L07AE:	db	'Nastassia'
	db	00
L07B8:	db	'bill'
	db	00
L07BD:	db	'"\'Tis about time that the government did something about th'
	db	'e awful stench coming from that lake! I shall be happy to si'
	db	'gn thy bill of law! Take it back to the Great Council post h'
	db	'aste!" Lord Heather signs the bill and hands it back to you.'
	db	00
L08AD:	db	'"But thou dost not have a bill of law!"'
	db	00
L08D5:	db	'"I thought I already signed that bill!"'
	db	00
L08FD:	db	'bill'
	db	00
L0902:	db	'Lock Lake'
	db	00
L090C:	db	'"It has gotten so putrid that on hot summer days the stink i'
	db	's suffocating. I believe that the Britannian Mining Company '
	db	'in Minoc is the source of the problem. Mining waste is being'
	db	' deposited in the Lake. Thou shouldst be glad it is nearly w'
	db	'inter!"'
	db	00
L0A04:	db	'Lock Lake'
	db	00
L0A0E:	db	'bye'
	db	00
L0A12:	db	'"Do come and visit again, Avatar!"*'
	db	00
