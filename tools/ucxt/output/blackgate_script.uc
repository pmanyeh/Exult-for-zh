	; Function at file offset 000E9A88H
	.funcnumber  04CBH
	.data
	.msize       0A81H
	.dsize       0824H
L0000:	db	'the Avatar'
	db	00
L000B:	db	'Fellowship'
	db	00
L0016:	db	'bye'
	db	00
L001A:	db	'job'
	db	00
L001E:	db	'name'
	db	00
L0023:	db	'Elizabeth and Abraham'
	db	00
L0039:	db	'You see a broad-shouldered man with a solemn look about him.'
	db	00
L0076:	db	'"Yes, '
	db	00
L007D:	db	'?" says Cador.'
	db	00
L008C:	db	'name'
	db	00
L0091:	db	'The man shakes your hand. "I am Cador."'
	db	00
L00B9:	db	'"And thy name is?"'
	db	00
L00CC:	db	'"What? Dost thou mean to tell me that thou art the one who b'
	db	'rought those gargoyles to our precious land?" He turns quite'
	db	' angry.~~"Daemon lover!"*'
	db	00
L015E:	db	'"I am happy to make thine acquaintance, '
	db	00
L0187:	db	'."'
	db	00
L018A:	db	'name'
	db	00
L018F:	db	'job'
	db	00
L0193:	db	'"I oversee the local branch of the Britannian Mining Company'
	db	' in Vesper. We mine many different minerals."'
	db	00
L01FD:	db	'minerals'
	db	00
L0206:	db	'We'
	db	00
L0209:	db	'Vesper'
	db	00
L0210:	db	'minerals'
	db	00
L0219:	db	'"Gold and lead."'
	db	00
L022A:	db	'minerals'
	db	00
L0233:	db	'Vesper'
	db	00
L023A:	db	'"That is the name of our town. Liana at town hall can give t'
	db	'hee any more information that thou mightest need, but I have'
	db	' lived here with my family since the branch opened."'
	db	00
L02E7:	db	'family'
	db	00
L02EE:	db	'Liana'
	db	00
L02F4:	db	'Vesper'
	db	00
L02FB:	db	'Fellowship'
	db	00
L0306:	db	'"It is a wonderful organization. They perform many works of '
	db	'charity and special events -- parades and such."  He points '
	db	'to his medallion. "As thou canst see, I am a member. I fully'
	db	' believe in the triad of inner strength."'
	db	00
L03E4:	db	'"As a matter of fact, two Fellowship officials were just her'
	db	'e. They said it was important to see how a town\'s economy w'
	db	'orked before starting a branch in that town. Dost thou reali'
	db	'ze what that means?" He smiles proudly. "They are going to b'
	db	'uild a Fellowship branch here in Vesper."'
	db	00
L04FD:	db	'triad'
	db	00
L0503:	db	'Fellowship'
	db	00
L050E:	db	'triad'
	db	00
L0514:	db	'"Those are The Fellowship\'s three basic principles: Strive '
	db	'for Unity, Trust thy Brother, and Worthiness Precedes Reward'
	db	'."'
	db	00
L058E:	db	'triad'
	db	00
L0594:	db	'Elizabeth and Abraham'
	db	00
L05AA:	db	'"They were the two Fellowship officials that were here! They'
	db	' only stayed for a minute or two. I have no idea where they '
	db	'are now."'
	db	00
L062C:	db	'Elizabeth and Abraham'
	db	00
L0642:	db	'We'
	db	00
L0645:	db	'"I work with Mara and a gargoyle named Lap-Lem."'
	db	00
L0676:	db	'Lap-Lem'
	db	00
L067E:	db	'Mara'
	db	00
L0683:	db	'We'
	db	00
L0686:	db	'Mara'
	db	00
L068B:	db	'"She is a fantastic worker. Better than most men I have mine'
	db	'd with."'
	db	00
L06D0:	db	'Mara'
	db	00
L06D5:	db	'Lap-Lem'
	db	00
L06DD:	db	'"Well, for a gargoyle, he is not too lazy. He works much har'
	db	'der than that other one who left, Anmanivas. But I would fai'
	db	'n let him go if we did not need the extra hand."'
	db	00
L0786:	db	'Lap-Lem'
	db	00
L078E:	db	'Liana'
	db	00
L0794:	db	'"She keeps the records at town hall."'
	db	00
L07BA:	db	'Liana'
	db	00
L07C0:	db	'family'
	db	00
L07C7:	db	'"Yes, my wife, Yvella, and my daughter, Catherine."'
	db	00
L07FB:	db	'family'
	db	00
L0802:	db	'bye'
	db	00
L0806:	db	'"It has been a pleasure, '
	db	00
L0820:	db	'."*'
	db	00
