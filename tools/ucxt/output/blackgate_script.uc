	; Function at file offset 00093E12H
	.funcnumber  0477H
	.data
	.msize       1277H
	.dsize       0F72H
L0000:	db	'bye'
	db	00
L0004:	db	'job'
	db	00
L0008:	db	'name'
	db	00
L000D:	db	'Though he does not seem hostile, the man greets you in a fig'
	db	'hting stance.'
	db	00
L0057:	db	'"What dost thou need?" asks De Snel.'
	db	00
L007C:	db	'Sprellic'
	db	00
L0085:	db	'duellists'
	db	00
L008F:	db	'honor flag'
	db	00
L009A:	db	'name'
	db	00
L009F:	db	'"I am called Master De Snel."'
	db	00
L00BD:	db	'name'
	db	00
L00C2:	db	'job'
	db	00
L00C6:	db	'"I operate the famous fighting school here in Jhelom, the Li'
	db	'brary of Scars. I also train fighters personally from time t'
	db	'o time, if they show potential."'
	db	00
L015F:	db	'potential'
	db	00
L0169:	db	'Library of Scars'
	db	00
L017A:	db	'Jhelom'
	db	00
L0181:	db	'potential'
	db	00
L018B:	db	'"I teach a fighting style of mine own invention. It enables '
	db	'one to gain complete mastery over his opponent. I could arra'
	db	'nge a little demonstration for thee..."'
	db	00
L022B:	db	'demonstration'
	db	00
L0239:	db	'potential'
	db	00
L0243:	db	'Jhelom'
	db	00
L024A:	db	'"This city is devoted to the art of combat. Not mere slavish'
	db	' military discipline, but pure violent confrontation. It is '
	db	'a place after mine own heart."'
	db	00
L02E1:	db	'Jhelom'
	db	00
L02E8:	db	'Library of Scars'
	db	00
L02F9:	db	'"An elite school of fighters with a long, proud history. Man'
	db	'y great fighters have trained within its walls. The group ev'
	db	'en has its own special weaponry."'
	db	00
L0393:	db	'weaponry'
	db	00
L039C:	db	'fighters'
	db	00
L03A5:	db	'"I do not feel like discussing business at the moment. Some '
	db	'other time perhaps."'
	db	00
L03F6:	db	'Library of Scars'
	db	00
L0407:	db	'fighters'
	db	00
L0410:	db	'"I train my students to be fierce and ruthless fighters!"'
	db	00
L044A:	db	'fighters'
	db	00
L0453:	db	'weaponry'
	db	00
L045C:	db	'He unsheathes his own sword and shows it to you. The sword h'
	db	'as an elaborate serpentine pattern engraved in it. "Thou may'
	db	'est recognize a weapon of the Library of Scars by its engrav'
	db	'ing. It is the sign of the snake. Striking quick, silent, de'
	db	'adly, as are we!"'
	db	00
L055E:	db	'weaponry'
	db	00
L0567:	db	'dagger'
	db	00
L056E:	db	'dagger'
	db	00
L0575:	db	'You produce the dagger found at the scene of the murders in '
	db	'Minoc. The serpentine engraving matches the markings of the '
	db	'Library of Scars exactly. De Snel looks at it and then back '
	db	'at you. He cannot conceal his surprise.~"From where didst th'
	db	'ou get that dagger?"'
	db	00
L067A:	db	'murder site'
	db	00
L0686:	db	'found it'
	db	00
L068F:	db	'found it'
	db	00
L0698:	db	'De Snel peers at you, obviously aware you are lying.'
	db	00
L06CD:	db	'murder site'
	db	00
L06D9:	db	'You look De Snel in the eye and tell him that you found it a'
	db	't the scene of the murders in Minoc. He gives you a curious '
	db	'look.'
	db	00
L0757:	db	'"That dagger was stolen from the Library of Scars weeks ago.'
	db	' I have no further knowledge of it."'
	db	00
L07B8:	db	'"By the way, hast thou had a demonstration of my training te'
	db	'chnique?"'
	db	00
L07FE:	db	'"Then perhaps thou shouldst have another."'
	db	00
L0829:	db	'"Then perhaps thou shouldst try one."'
	db	00
L084F:	db	'dagger'
	db	00
L0856:	db	'demonstration'
	db	00
L0864:	db	'demonstration'
	db	00
L0872:	db	'"Very well. Let us begin!"*'
	db	00
L088E:	db	'"I must apologize for the discourtesy, but mine unequaled ta'
	db	'lents demand that I charge thee 40 gold for a training demon'
	db	'stration. Wilt thou accept?"'
	db	00
L0923:	db	'"Very well, then!" His scowl indicates his displeasure. "If '
	db	'thou dost not like it, perhaps the Library of Scars is not t'
	db	'he place for thee."'
	db	00
L09AF:	db	'demonstration'
	db	00
L09BD:	db	'Sprellic'
	db	00
L09C6:	db	'"As thou hast probably seen, a few of our members had a disp'
	db	'ute with a local troublemaker over our honor flag. We of the'
	db	' Library of Scars have a fierce dedication to our institutio'
	db	'n. I do not know what exactly happened to this upstart, but '
	db	'I understand that he is now dead. I am not trying to suggest'
	db	' the Library of Scars had anything to do with it, of course.'
	db	' Only that it would be wise not to cross us."'
	db	00
L0B5C:	db	'Sprellic'
	db	00
L0B65:	db	'duellists'
	db	00
L0B6F:	db	'"I have heard that thou didst kill several of our members wh'
	db	'ile champion of a duel defending the thief of our honor flag'
	db	'." His eyes narrow as he stares at you intensely. "Outstandi'
	db	'ng! I am a man who values nothing higher than the applicatio'
	db	'n of skill. I salute thee on thy victory. Perhaps thou would'
	db	'st like to join our group?"'
	db	00
L0CB7:	db	'"Thy companions and thee look fit enough for an informal pra'
	db	'ctice session. Consider it a demonstration of my fighting st'
	db	'yle."'
	db	00
L0D35:	db	'demonstration'
	db	00
L0D43:	db	'"As my style of fighting is the superior style, I am only in'
	db	'terested in training the best. Perhaps thy companions and th'
	db	'ee qualify. We might find out, that is, if thou art courageo'
	db	'us enough."'
	db	00
L0E03:	db	'demonstration'
	db	00
L0E11:	db	'duellists'
	db	00
L0E1B:	db	'honor flag'
	db	00
L0E26:	db	'"Fortunately for Sprellic our honor flag was returned. If it'
	db	' had not been we would have had no choice but to regain our '
	db	'honor with his blood."'
	db	00
L0EB5:	db	'honor flag'
	db	00
L0EC0:	db	'bye'
	db	00
L0EC4:	db	'"Thou canst walk away so easy without a demonstration! Thou '
	db	'shalt have one anyway!"*'
	db	00
L0F19:	db	'"May thy stay in Jhelom be a memorable one," De Snel laughs '
	db	'as he turns and walks away.*'
	db	00
