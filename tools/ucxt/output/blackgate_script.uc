	; Function at file offset 0005849DH
	.funcnumber  042FH
	.data
	.msize       0978H
	.dsize       0789H
L0000:	db	'bye'
	db	00
L0004:	db	'job'
	db	00
L0008:	db	'name'
	db	00
L000D:	db	'Charles'
	db	00
L0015:	db	'This young, lovely tavern wench is sexy and sweet.'
	db	00
L0048:	db	'"Hello again!" bubbly Jeanette says.'
	db	00
L006D:	db	'name'
	db	00
L0072:	db	'"Jeanette, at thy service!"'
	db	00
L008E:	db	'name'
	db	00
L0093:	db	'job'
	db	00
L0097:	db	'"I work for Lucy at the Blue Boar. I serve food and drinks.'
	db	00
L00D3:	db	'"If there is anything thou wouldst like, please say so! And,'
	db	' er, I shall give thee a discount if thou dost buy from me!"'
	db	00
L014C:	db	'"Why, Sir Dupre! How good to see thee again!"*'
	db	00
L017B:	db	'"Hello milady! I thought I might re-sample The Blue Boar\'s '
	db	'fine beverages!"*'
	db	00
L01C8:	db	'"Any time, milord! Any time!"*'
	db	00
L01E7:	db	'buy'
	db	00
L01EB:	db	'drink'
	db	00
L01F1:	db	'food'
	db	00
L01F6:	db	'"I work during the day and evening hours. Thou shouldst come'
	db	' by the pub then and we shall talk more!"'
	db	00
L025C:	db	'food'
	db	00
L0261:	db	'"Lucy is a good cook. I recommend everything. Especially Sil'
	db	'verleaf."'
	db	00
L02A7:	db	'Silverleaf'
	db	00
L02B2:	db	'food'
	db	00
L02B7:	db	'Silverleaf'
	db	00
L02C2:	db	'"Wonderful dish. Try it!"'
	db	00
L02DC:	db	'Silverleaf'
	db	00
L02E7:	db	'drink'
	db	00
L02ED:	db	'"Thou dost look like thou dost need a good drink!"'
	db	00
L0320:	db	'drink'
	db	00
L0326:	db	'buy'
	db	00
L032A:	db	'Charles'
	db	00
L0332:	db	'"He spoke of me, did he? Well, he may think again! I cannot '
	db	'bring myself to socialize with the upper class. Those bourge'
	db	'oisie rich men are obnoxious and egotistical. Besides, I am '
	db	'in love with another."'
	db	00
L03FD:	db	'Charles'
	db	00
L0405:	db	'another'
	db	00
L040D:	db	'upper class'
	db	00
L0419:	db	'upper class'
	db	00
L0425:	db	'"They are all alike. They work in castles and have piles of '
	db	'gold and can have any woman they want! On the other hand, a '
	db	'humble merchant is the perfect man."'
	db	00
L04C2:	db	'upper class'
	db	00
L04CE:	db	'another'
	db	00
L04D6:	db	'"\'Tis Willy the Baker! But he does not know it yet!" she gi'
	db	'ggles.'
	db	00
L0518:	db	'"A moment, Jeanette! Thou hast it all wrong! Charles is a -s'
	db	'ervant-! Thou art an ignoramus! Charles is not \'upper class'
	db	'\'! He is as working class as thee! \'Tis Willy who is the r'
	db	'ich merchant! If thou dost ask me, \'tis Willy who is obnoxi'
	db	'ous and egotistical. Charles is a dream!"'
	db	00
L062E:	db	'You point out to Jeanette that Charles is a servant.'
	db	00
L0663:	db	'Jeanette thinks about what was said. "Thou art right! I cann'
	db	'ot believe I have been so blind! Oh, Charles! I can actually'
	db	' consider Charles! And he is... so handsome!" Jeanette squea'
	db	'ls with delight. "I shall have to flirt with him in earnest '
	db	'next time he is in the pub!"'
	db	00
L0770:	db	'another'
	db	00
L0778:	db	'bye'
	db	00
L077C:	db	'"Farewell!"*'
	db	00
