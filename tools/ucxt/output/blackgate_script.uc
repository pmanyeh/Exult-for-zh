	db	00
L0103:	db	'"I am De Maria, the Bard."'
	db	00
L011E:	db	'name'
	db	00
L0123:	db	'Zinaida'
	db	00
L012B:	db	'job'
	db	00
L012F:	db	'"I spin tales and sing songs!"'
	db	00
L014E:	db	'"I also know a good deal about the folks in Cove."'
	db	00
L0181:	db	'folks'
	db	00
L0187:	db	'song'
	db	00
L018C:	db	'tale'
	db	00
L0191:	db	'folks'
