	; Function at file offset 0015ABCDH
	.funcnumber  08AFH
	.data
	.msize       0364H
	.dsize       02C4H
L0000:	db	'"Is there a problem? Art thou confounded by thy task?"'
	db	00
L0037:	db	'"Well then, I suggest that thou hasten to finish thy task, l'
	db	'est the souls of the well perish before thou art done.*"'
	db	00
L00AC:	db	'"Canst thou not find the spirits of the town?"'
	db	00
L00DB:	db	'"Well then, I suggest that thou make haste, lest the souls o'
	db	'f the well perish."*'
	db	00
L012C:	db	'"Ah, then it is good that thou hast returned. The Mayor know'
	db	's most of the townsfolk and can tell thee of them."*'
	db	00
L019D:	db	'"Very good, now thou shalt take the Mayor to the well and he'
	db	' must enter it of his own free will. When he does that, the '
	db	'souls of the island and the well will be free to go on to th'
	db	'eir destiny. Unfortunately, Mayor Forsythe will be lost for '
	db	'all time."'
	db	00
L0298:	db	' He looks sadly at the ghostly gentleman.'
	db	00
L02C2:	db	'*'
	db	00
