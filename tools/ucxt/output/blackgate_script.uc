	; Function at file offset 00048C5BH
	.funcnumber  041CH
	.data
	.msize       09A1H
	.dsize       07B6H
L0000:	db	'bye'
	db	00
L0004:	db	'job'
	db	00
L0008:	db	'name'
	db	00
L000D:	db	'This is a tall, skinny actor with knobby knees.'
	db	00
L003D:	db	'He wears a woman\'s wig and is dressed in drag.'
	db	00
L006C:	db	' he says in falsetto.'
	db	00
	db	00
L0083:	db	'Jesse clears his throat. "Hello again!"'
	db	00
	db	00
L00AC:	db	'name'
	db	00
L00B1:	db	'The actor speaks in falsetto.'
	db	00
L00CF:	db	'"I am Jesse and I am a star."'
	db	00
L00ED:	db	'name'
	db	00
L00F2:	db	'He slaps his own face and speaks in a normal register, "Oops'
	db	', sorry! I am so entrenched in the role that I sometimes for'
	db	'get that I am not a woman!"'
	db	00
L0186:	db	'job'
	db	00
L018A:	db	'"I work at the Royal Theatre as an actor. I have played -all'
	db	'- the great roles in my career. I now have the chance to pla'
	db	'y the part of a lifetime -- the Avatar!"'
	db	00
L022B:	db	'Avatar'
	db	00
L0232:	db	'Royal Theatre'
	db	00
L0240:	db	'Royal Theatre'
	db	00
L024E:	db	'"Because it must cater to the masses, we never have the oppo'
	db	'rtunity to do experimental works -- only the traditional gru'
	db	'el of mediocrity. But \'tis a wonderful space and it has mar'
	db	'velous acoustics."'
	db	00
L0314:	db	'experimental works'
	db	00
L0327:	db	'masses'
	db	00
L032E:	db	'Royal Theatre'
	db	00
L033C:	db	'masses'
	db	00
L0343:	db	'"People like to see tales of heroic adventures, knights in a'
	db	'rmour, beautiful princesses, wise kings, wizards, evil monst'
	db	'ers. All that rot."'
	db	00
L03CF:	db	'masses'
	db	00
L03D6:	db	'Avatar'
	db	00
L03DD:	db	'"The role is very challenging. I have a plethora of lines an'
	db	'd I had to work with a trainer for weeks to prepare for the '
	db	'enormous amount of activity required. This role will make '
	db	'\'Jesse\' a household name!"'
	db	00
L04AA:	db	'lines'
	db	00
L04B0:	db	'challenging'
	db	00
L04BC:	db	'Avatar'
	db	00
L04C3:	db	'challenging'
	db	00
L04CF:	db	'"It is easily the most ambitious theatrical production ever '
	db	'conceived. There is over a hundred hours of play time. That '
	db	'is a long time for an audience."'
	db	00
L0568:	db	'challenging'
	db	00
L0574:	db	'lines'
	db	00
L057A:	db	'"My biggest lines are:~~"Name!"~~"Job!"~~"Bye!"'
	db	00
L05AA:	db	'lines'
	db	00
L05B0:	db	'experimental works'
	db	00
L05C3:	db	'"My favorite piece is something Raymundo wrote for me entitl'
	db	'ed \'Three on a Codpiece\'. I stand on stage and invite the '
	db	'audience to join me in tearing an undergarment into tiny pie'
	db	'ces, after which they are placed in funeral urns and mixed w'
	db	'ith wheat paste. The pieces of cloth, not the audience membe'
	db	'rs. Then the audience may glue the pieces anywhere on my bod'
	db	'y that they wish."'
	db	00
L073C:	db	'experimental works'
	db	00
L074F:	db	'bye'
	db	00
L0753:	db	'"Goodbye. Be sure to come to the show when it opens!"*'
	db	00
L078A:	db	'@Name!@'
	db	00
L0792:	db	'@Job!@'
	db	00
L0799:	db	'@Yes! Er, I mean No!@'
	db	00
L07AF:	db	'@Bye!@'
	db	00
