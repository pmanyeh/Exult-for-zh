	; Function at file offset 00080EEDH
	.funcnumber  045EH
	.data
	.msize       0D25H
	.dsize       0AA1H
L0000:	db	'murders'
	db	00
L0008:	db	'bye'
	db	00
L000C:	db	'job'
	db	00
L0010:	db	'name'
	db	00
L0015:	db	'gypsies'
	db	00
L001D:	db	'attractive'
	db	00
L0028:	db	'You see a stealthy-looking woman, dressed all in green. Ther'
	db	'e is a wicked grin on her face.'
	db	00
L0084:	db	'"How good to see thee again," says Karenna.'
	db	00
L00B0:	db	'name'
	db	00
L00B5:	db	'"I answer to Karenna, and to nothing else."'
	db	00
L00E1:	db	'name'
	db	00
L00E6:	db	'job'
	db	00
L00EA:	db	'"I am a teacher in Minoc, along with Jakher."'
	db	00
L0118:	db	'Jakher'
	db	00
L011F:	db	'Minoc'
	db	00
L0125:	db	'teacher'
	db	00
L012D:	db	'"An odd question to ask at such a time as this, '
	db	00
L015E:	db	'. Dost thou know that two people lie dead in that sawmill an'
	db	'd they are dead from the hand of perpetrator or perpetrators'
	db	' unknown?"'
	db	00
L01E1:	db	'murders'
	db	00
L01E9:	db	'Minoc'
	db	00
L01EF:	db	'"Minoc was usually busy, but quiet. Then our town was bother'
	db	'ed by this nonsense over Owen\'s monument, and now these mur'
	db	'ders."'
	db	00
L026D:	db	'murders'
	db	00
L0275:	db	'monument'
	db	00
L027E:	db	'Minoc'
	db	00
L0284:	db	'murders'
	db	00
L028C:	db	'"Shocking! Such things do not normally happen here. It well '
	db	'proves the value of knowing how to defend oneself."'
	db	00
L02FC:	db	'murders'
	db	00
L0304:	db	'Jakher'
	db	00
L030B:	db	'"He is quite an able trainer in his own right. Not as skille'
	db	'd as myself, obviously. But I do think he is cute, though I '
	db	'bid thee, do not tell him that I spoke of this. It will only'
	db	' encourage him."'
	db	00
L03D0:	db	'"Art thou speaking about me? Mine ears are burning!"*'
	db	00
L0406:	db	'"Nothing thou shouldst be concerned about, Jakher." She wink'
	db	's at you.*'
	db	00
L044D:	db	'Jakher'
	db	00
L0454:	db	'teacher'
	db	00
L045C:	db	'"I teach that singular skill which enables one to learn all '
	db	'the lessons of life without losing it in the process. Combat'
	db	'!~~"I would charge thee 20 gold for each training session. A'
	db	'rt thou still interested?"'
	db	00
L052B:	db	'"Very well. If thou art fortunate thou wilt not have cause t'
	db	'o regret it."'
	db	00
L0575:	db	'teacher'
	db	00
L057D:	db	'"Our establishment is now closed. Please come by during busi'
	db	'ness hours."'
	db	00
L05C6:	db	'teacher'
	db	00
L05CE:	db	'monument'
	db	00
L05D7:	db	'"I understand it is to be thirty feet high and will display '
	db	'our local shipwright as he holds aloft a sextant. Thou would'
	db	'st not believe a thing as benign as this could create such t'
	db	'rouble."'
	db	00
L0694:	db	'monument'
	db	00
L069D:	db	'trouble'
	db	00
L06A5:	db	'trouble'
	db	00
L06AD:	db	'"It would seem the increase in hostilities amongst the fair '
	db	'citizenry over our shipwright\'s monument has filled much of'
	db	' the local populace with a burning desire to acquire combati'
	db	've skills. Business has never been better!"'
	db	00
L078C:	db	'trouble'
	db	00
L0794:	db	'hostilities'
	db	00
L07A0:	db	'hostilities'
	db	00
L07AC:	db	'"Everyone in town is all up in arms about this and that. But'
	db	' surely others would know more of these local politics. I ca'
	db	're not."'
	db	00
L082D:	db	'hostilities'
	db	00
L0839:	db	'attractive'
	db	00
L0844:	db	'"Jakher told thee he doth find me attractive? He denies it, '
	db	'of course, but I have known for years that he doth have feel'
	db	'ings for me."'
	db	00
L08CA:	db	'"What? What didst thou say?"*'
	db	00
L08E8:	db	'"Nothing, Jakher. Go away." She giggles conspiratorally at y'
	db	'ou.*'
	db	00
L0929:	db	'attractive'
	db	00
L0934:	db	'gypsies'
	db	00
L093C:	db	'"Frederico, the leader of the Gypsies, and his wife, Tania, '
	db	'were good people. Why, the worst thing I ever knew either of'
	db	' them to do was a simple prank."'
	db	00
L09D5:	db	'gypsies'
	db	00
L09DD:	db	'prank'
	db	00
L09E3:	db	'prank'
	db	00
L09E9:	db	'"Once Frederico threw a rock through the window of the local'
	db	' Fellowship branch... Oh, well, I thought it was amusing!"'
	db	00
L0A60:	db	'prank'
	db	00
L0A66:	db	'bye'
	db	00
L0A6A:	db	'"Farewell. May all thy journeys be interesting ones."*'
	db	00
