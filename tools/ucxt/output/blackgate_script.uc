	; Function at file offset 000757FCH
	.funcnumber  0453H
	.data
	.msize       0798H
	.dsize       05DEH
L0000:	db	'bye'
	db	00
L0004:	db	'job'
	db	00
L0008:	db	'name'
	db	00
L000D:	db	'Tania'
	db	00
L0013:	db	'Frederico'
	db	00
L001D:	db	'murders'
	db	00
L0025:	db	'Sasha'
	db	00
L002B:	db	'You see a young, bewitching gypsy woman with wise, soul-peer'
	db	'ing eyes.'
	db	00
L0071:	db	'"Thou vishest to speak vith me again?" Margareta asks.'
	db	00
L00A8:	db	'"Very vell."'
	db	00
L00B5:	db	'"Very vell."*'
	db	00
L00C3:	db	'name'
	db	00
L00C8:	db	'"Margareta at thy service," she speaks slowly.'
	db	00
L00F7:	db	'name'
	db	00
L00FC:	db	'job'
	db	00
L0100:	db	'The gypsy woman smiles slightly. "To tell thy destiny."'
	db	00
L0138:	db	'destiny'
	db	00
L0140:	db	'murders'
	db	00
L0148:	db	'"I knew it vould happen. I varned Frederico. He vouldn\'t li'
	db	'sten."'
	db	00
L018A:	db	'murders'
	db	00
L0192:	db	'Frederico'
	db	00
L019C:	db	'"He vas my brother-in-law. His death makes me very sad."'
	db	00
L01D5:	db	'Frederico'
	db	00
L01DF:	db	'husband'
	db	00
L01E7:	db	'Tania'
	db	00
L01ED:	db	'"She vas Frederico\'s vife, but thou dost know that already,'
	db	' no? She vas a good voman."'
	db	00
L0244:	db	'Tania'
	db	00
L024A:	db	'Sasha'
	db	00
L0250:	db	'Margareta is silent a moment.~~"He has been led astray. It i'
	db	's unfortunate that he vill realize his mistake only as a res'
	db	'ult ov the death ov his parents."'
	db	00
L02EA:	db	'mistake'
	db	00
L02F2:	db	'astray'
	db	00
L02F9:	db	'Sasha'
	db	00
L02FF:	db	'astray'
	db	00
L0306:	db	'"There are many, many others like Sasha who have been led as'
	db	'tray. For them, I see no future."'
	db	00
L0364:	db	'astray'
	db	00
L036B:	db	'mistake'
	db	00
L0373:	db	'"Thou dost know vhat I mean.'
	db	00
L0390:	db	'"Thou art a member thyself."'
	db	00
L03AD:	db	'"The Fellowship."'
	db	00
L03BF:	db	'Fellowship'
	db	00
L03CA:	db	'mistake'
	db	00
L03D2:	db	'Fellowship'
	db	00
L03DD:	db	'Margareta sees your medallion and raises her eyes.'
	db	00
L0410:	db	'"I see thou art vearing vone ov their medallions, but thou a'
	db	'rt not truly a member, art thou? Bevare -- there are those i'
	db	'n The Fellowship that vill see through thy deception."'
	db	00
L04BF:	db	'"Thou vilt soon be enlightened about their true nature."'
	db	00
L04F8:	db	'"Thou shalt learn more about them in due time."'
	db	00
L0528:	db	'Fellowship'
	db	00
L0533:	db	'destiny'
	db	00
L053B:	db	'destiny'
	db	00
L0543:	db	'husband'
	db	00
L054B:	db	'"Jergi is mine husband, ov course. Now he has the veight ov '
	db	'guiding the gypsy race in these\ttroubled times."'
	db	00
L05B8:	db	'husband'
	db	00
L05C0:	db	'bye'
	db	00
L05C4:	db	'"Fairvell. Go in peace."*'
	db	00
