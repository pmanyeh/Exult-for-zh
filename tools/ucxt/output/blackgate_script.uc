L0000:	db	'@All the golems are alive now.@'
	db	00
L0020:	db	'*'
	db	00
L0022:	db	'in the pentacle of stones.@'
	db	00
L003E:	db	'@The golem must be centered'
	db	00
L005A:	db	' rock is'
	db	00
L0063:	db	' rocks are'
	db	00
L006E:	db	'@Only '
	db	00
L0075:	db	' covered.@'
	db	00
L0080:	db	'@Blood must cover the rocks.@'
	db	00
L009E:	db	'     Vas Flam Uus~~'
	db	00
L00B2:	db	'This scroll will permit thee to perform the ritual necessary'
	db	' to either create, or reconstruct, stone creatures and insti'
	db	'll within them the power of thought. First, gather the mater'
	db	'ials discussed in the previous chapters. After thou hast per'
	db	'formed said task, thou shouldst refer back to this scroll an'
	db	'd begin...'
	db	00
L01E9:	db	'@He gave up his heart... so that Adjhar may live!* Well, not'
	db	' to be morbid, but I suppose the incantation should work now'
	db	'.@'
	db	00
