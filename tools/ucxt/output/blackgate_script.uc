	; Function at file offset 000F26EDH
	.funcnumber  04D8H
	.data
	.msize       075AH
	.dsize       0556H
L0000:	db	'bye'
	db	00
L0004:	db	'job'
	db	00
L0008:	db	'name'
	db	00
L000D:	db	'You see a winged gargoyle with an authoritative disposition.'
	db	00
L004A:	db	'"To offer welcome for you, human," says Wis-Sur.'
	db	00
L007B:	db	'The winged gargoyle in front of you has a wild look about hi'
	db	'm.'
	db	00
L00BA:	db	'"To go away, human! To have nothing you want!" screams Wis-S'
	db	'ur.'
	db	00
L00FA:	db	'name'
	db	00
L00FF:	db	'"To be named Wis-Sur, which means `wise sun.\'"'
	db	00
L012E:	db	'name'
	db	00
L0133:	db	'job'
	db	00
L0137:	db	'"To sell magic to others."'
	db	00
L0152:	db	'magic'
	db	00
L0158:	db	'others'
	db	00
L015F:	db	'magic'
	db	00
L0165:	db	'"To be interested in spells, reagents, or potions?"'
	db	00
L0199:	db	'potions'
	db	00
L01A1:	db	'reagents'
	db	00
L01AA:	db	'spells'
	db	00
L01B1:	db	'magic'
	db	00
L01B7:	db	'spells'
	db	00
L01BE:	db	'reagents'
	db	00
L01C7:	db	'potions'
	db	00
L01CF:	db	'others'
	db	00
L01D6:	db	'"To be familiar with only the other gargoyles in Vesper. To '
	db	'tell you to ask Ansikart, who knows all other gargoyles here'
	db	'. To tell you about one of the following?"'
	db	00
L0279:	db	'others'
	db	00
L0280:	db	'Anmanivas'
	db	00
L028A:	db	'For-Lem'
	db	00
L0292:	db	'Lap-Lem'
	db	00
L029A:	db	'Aurvidlem'
	db	00
L02A4:	db	'Aurvidlem'
	db	00
L02AE:	db	'"To be a provisioner in Vesper."'
	db	00
L02CF:	db	'Aurvidlem'
	db	00
