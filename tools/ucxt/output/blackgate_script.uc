	; Function at file offset 0006B2D0H
	.funcnumber  0446H
	.data
	.msize       0E59H
	.dsize       0BA0H
L0000:	db	'bye'
	db	00
L0004:	db	'job'
	db	00
L0008:	db	'name'
	db	00
L000D:	db	'signed'
	db	00
L0014:	db	'This is a lovely, earthy woman with a warm smile.'
	db	00
L0046:	db	'"Word has spread quickly of thine arrival, Avatar! Welcome!"'
	db	00
L0083:	db	'"Hello, '
	db	00
L008C:	db	'," Miranda says. "Nice to see thee again."'
	db	00
L00B7:	db	'name'
	db	00
L00BC:	db	'"I am Miranda."'
	db	00
L00CC:	db	'name'
	db	00
L00D1:	db	'job'
	db	00
L00D5:	db	'"I serve on the Great Council. Today we are working on a bil'
	db	'l of law. When I am not here in the castle, I am kept busy w'
	db	'ith a young child."'
	db	00
L0161:	db	'child'
	db	00
L0167:	db	'bill'
	db	00
L016C:	db	'Great Council'
	db	00
L017A:	db	'Great Council'
	db	00
L0188:	db	'"The Great Council supports Lord British in the legislation '
	db	'of Britannia\'s laws. I am honored to be one of the three wo'
	db	'men serving on the Council."'
	db	00
L021C:	db	'women'
	db	00
L0222:	db	'Great Council'
	db	00
L0230:	db	'women'
	db	00
L0236:	db	'"I am particularly concerned about women\'s duties and privi'
	db	'leges and their available opportunities in the land. Our his'
	db	'tory has been kind to women in general, but there is still r'
	db	'oom for improvement."'
	db	00
L02FF:	db	'improvement'
	db	00
L030B:	db	'women'
	db	00
L0311:	db	'improvement'
	db	00
L031D:	db	'"More women could hold public office, for one thing. And I w'
	db	'ould personally like to be rid of those scantily-clad women '
	db	'in heroic fantasy paintings."'
	db	00
L03B3:	db	'improvement'
	db	00
L03BF:	db	'child'
	db	00
L03C5:	db	'Miranda smiles. "Yes, my son\'s name is Max.'
	db	00
L03F1:	db	'"He is probably in the Royal Nursery.'
	db	00
L0417:	db	'"He\'s right here! Say hello to the Avatar, Max."*'
	db	00
L0449:	db	'"Hi. I\'m a funny boy!"*'
	db	00
L0461:	db	'"He\'s quite precocious.'
	db	00
L0479:	db	'"I wonder where he could be...'
	db	00
L0498:	db	'"He is quite obviously his father\'s son. Perhaps thou hast '
	db	'met him? Raymundo -- the director of the Royal Theatre. We b'
	db	'elieve Max will be quite a performer when he\'s older."'
	db	00
L0546:	db	'child'
	db	00
L054C:	db	'bill'
	db	00
L0551:	db	'"Inwisloklem and I are drafting a bill which would make ille'
	db	'gal any distribution of waste products in Lock Lake, near Co'
	db	've. The lake is quite defiled."'
	db	00
L05E9:	db	'Cove'
	db	00
L05EE:	db	'"I would like to speak with thee about the new bill we are d'
	db	'rafting. Please come to the Council Chamber during normal wo'
	db	'rking hours and we shall talk."'
	db	00
L0686:	db	'bill'
	db	00
L068B:	db	'Cove'
	db	00
L0690:	db	'"Art thou travelling to Cove?"'
	db	00
L06AF:	db	'"That is good news! Perhaps thou couldst do us a great favor'
	db	'. We need this bill delivered to Lord Heather in Cove. He mu'
	db	'st read it and give us his approval by signing it. I know th'
	db	'ou hast far more important things to do than running errands'
	db	', but it would be greatly appreciated. Wilt thou do it?"'
	db	00
L07D8:	db	'"Wonderful! Here is the bill. Please bring it back to me whe'
	db	'n it is signed. And we thank thee."'
	db	00
L0838:	db	'"Thine hands are too full to take the bill!"'
	db	00
L0865:	db	'"Oh. All right. We know that thou art very busy. We shall fi'
	db	'nd another way to deliver the bill. Thank thee anyway."'
	db	00
L08D9:	db	'"Thou wilt not be travelling to Cove at all? Well, all right'
	db	' then. Never mind."'
	db	00
L0929:	db	'Cove'
	db	00
L092E:	db	'signed'
	db	00
L0935:	db	'"Didst thou have Lord Heather sign the bill?"'
	db	00
L0963:	db	'"Excellent! Let me see it."'
	db	00
L097F:	db	'"It looks in order! We thank thee, Avatar!"'
	db	00
L09AB:	db	'"Wait, where is it? Thou dost not have it. I hope thou hast '
	db	'not lost it. Thou shouldst go and find it. \'Tis an importan'
	db	't document!"'
	db	00
L0A2F:	db	'"Wait! Where is it? Thou dost not have it. I hope thou hast '
	db	'not lost it. Thou shouldst go and find it. \'Tis an importan'
	db	't document!"'
	db	00
L0AB3:	db	'"But thou hast not had the bill signed! Please do so, as soo'
	db	'n as possible, if thou wouldst."'
	db	00
L0B10:	db	'"Oh. Well, the next time thou art in Cove, perhaps thou wilt'
	db	' find time to see him."'
	db	00
L0B64:	db	'signed'
	db	00
L0B6B:	db	'bye'
	db	00
L0B6F:	db	'"We shall see thee again soon, I hope, Avatar."*'
	db	00
