	; Function at file offset 00054516H
	.funcnumber  042CH
	.data
	.msize       1911H
	.dsize       15D0H
L0000:	db	'bye'
	db	00
L0004:	db	'job'
	db	00
L0008:	db	'name'
	db	00
L000D:	db	'Nell with child'
	db	00
L001D:	db	'Charles is angry'
	db	00
L002E:	db	'You see a flamboyant-looking gentleman. He is very cheerful '
	db	'and outgoing, greeting you with a smile and a wave.'
	db	00
L009E:	db	'"In a wink, in a word,~"I do greet thee, Milord."'
	db	00
L00D0:	db	'"To greet thee, On this day,~"\'Tis my pleasure, Milady."'
	db	00
L0109:	db	'name'
	db	00
L010E:	db	'"From out the dawn, when sun doth rise,~"Until next morn whe'
	db	'n moon must go,~"I answer to thy beck and cries,~"thine humb'
	db	'le servant, Carrocio!"'
	db	00
L019D:	db	'name'
	db	00
L01A2:	db	'job'
	db	00
L01A6:	db	'"The puppet\'s curtain I unfurl,~"And from mine hands the st'
	db	'ory\'s told,~"For pleasure of a boy or girl,~"To see doth co'
	db	'st one coin of gold.~"To take good measure of thy power,~"Fo'
	db	'rged in fire of virtue\'s heart,~"To ring the bell this very'
	db	' hour,~"Do test thy strength \'til thy muscles smart."'
	db	00
L02C9:	db	'"And perhaps impress thine own sweetheart!" Carrocio winks a'
	db	't you.'
	db	00
L030C:	db	'"Or dost thou wish to be a king?~"Yonder sticks a sword in s'
	db	'tone.~"If thou canst only pull it out~ "Thou wilt be the nex'
	db	't upon the throne!"'
	db	00
L0398:	db	'strength test'
	db	00
L03A6:	db	'see'
	db	00
L03AA:	db	'puppet show'
	db	00
L03B6:	db	'puppet show'
	db	00
L03C2:	db	'"My childhood\'s eye spied father\'s toil,~"A puppet\'s show'
	db	' of splendor royal.~"Time\'s breeze has blown, My father\'s '
	db	'gone,~"His child has grown, Regrets anon,~"Gears and wheels '
	db	'move the moppets now, in need of no one,~"And so I keep his '
	db	'carnival song playing on and on alone."'
	db	00
L04D5:	db	'puppet show'
	db	00
L04E1:	db	'gears and wheels'
	db	00
L04F2:	db	'regrets'
	db	00
L04FA:	db	'strength test'
	db	00
L0508:	db	'"I am sorry to say~"I have called it a day.~"Come to the\tgr'
	db	'ounds to test thy fitness~"when I am, yea verily, open for b'
	db	'usiness."'
	db	00
L0589:	db	'"Take the hammer in thine hands and strike a blow upon the g'
	db	'round,~"If thine arms be possessed of might then thou shalt '
	db	'hear a ringing sound.~"Once thou hast struck if thou hearest'
	db	' naught then thou dost know thy strength is flagging.~"But i'
	db	'f thou dost win the strength test game thou shalt receive a '
	db	'stuffed dragon."'
	db	00
L06C6:	db	'strength test'
	db	00
L06D4:	db	'gears and wheels'
	db	00
L06E5:	db	'"I fear an end to my family craft, where the show is run by '
	db	'human heart,~"But bones do age, not so machines, and we cann'
	db	'ot simply replace a part.~"I carry on as best I can, A machi'
	db	'ne to play my father\'s role,~"Control the marionettes unsee'
	db	'n, struggling to imbue them with a soul."'
	db	00
L07FE:	db	'gears and wheels'
	db	00
L080F:	db	'regrets'
	db	00
L0817:	db	'"The faces pressed before me, fleeting moments chance of gle'
	db	'e, From the lowly mongrel beggar to the resident of throne,~'
	db	'"Each know their place and gave me chase to find the one for'
	db	' me, Woman whom my life may share, this heart that waits alo'
	db	'ne."'
	db	00
L090C:	db	'regrets'
	db	00
L0914:	db	'woman'
	db	00
L091A:	db	'resident of throne'
	db	00
L092D:	db	'mongrel beggar'
	db	00
L093C:	db	'mongrel beggar'
	db	00
L094B:	db	'"A beggar man called Snaz will come to watch my show, ~"to s'
	db	'teal and sell all my best jokes, mine own personal foe."'
	db	00
L09C0:	db	'mongrel beggar'
	db	00
L09CF:	db	'resident of throne'
	db	00
L09E2:	db	'"Thine ignorance doth make me skittish,~"surely thou hast he'
	db	'ard of wise Lord British."'
	db	00
L0A39:	db	'resident of throne'
	db	00
L0A4C:	db	'woman'
	db	00
L0A52:	db	'"The awakening of mine heart\'s idyll,~"Lies \'neath me for '
	db	'I see her still,~"No bard could e\'er describe nor tell,~"th'
	db	'e tenderness of my fair Nell."'
	db	00
L0AE6:	db	'woman'
	db	00
L0AEC:	db	'Nell'
	db	00
L0AF1:	db	'Nell'
	db	00
L0AF6:	db	'"\'Tis said love is a fiery angel,~"Riding soft silk wings o'
	db	'f pure redemption,~"My puppet\'s heart still as an anvil,~"A'
	db	't the wicked thrill of her attention.~"By mine angel Nell I '
	db	'am anointed,~"Humble cowardice felled by Passion\'s blade,~"'
	db	'As her beloved I was hence appointed,~"Perchance through des'
	db	'tiny a marriage made."'
	db	00
L0C36:	db	'Nell'
	db	00
L0C3B:	db	'marriage'
	db	00
L0C44:	db	'wicked thrill'
	db	00
L0C52:	db	'wicked thrill'
	db	00
L0C60:	db	'Carrocio looks as if he is lost in a memory. After a moment '
	db	'he returns to reality.~~"I would not be a gentleman if I spo'
	db	'ke of this more, Forgive me the candor of mine heart\'s open'
	db	' door."~He appears somewhat embarrassed and clears his throa'
	db	't loudly several times.'
	db	00
L0D67:	db	'wicked thrill'
	db	00
L0D75:	db	'marriage'
	db	00
L0D7E:	db	'"My coins are arrows rushing to make good,~"\'Til the day wh'
	db	'en the jeweller sells his ring,~"For my sure heart is not bu'
	db	't carved from wood,~"And she doth tend to the bed of a king.'
	db	'"'
	db	00
L0E33:	db	'marriage'
	db	00
L0E3C:	db	'Nell with child'
	db	00
L0E4C:	db	'Nell with child'
	db	00
L0E5C:	db	'Carrocio gives you a shocked look and drops to his knees bef'
	db	'ore you. "I beseech thee, '
	db	00
L0EB3:	db	', ~"Keep still thy tongue,~"My Nell has ne\'er harmed anyone'
	db	',~"It would cause grievous injury to her reputation,~"Throug'
	db	'h the town\'s wagging lips our secret to spread,~"\'Twould m'
	db	'ake a permanent end of mine occupation,~"And kill our hope o'
	db	'f a happy life dead." He looks you in the eyes, pleadingly. '
	db	'"In thee I must place mine hope and trust,~"Part, parcel and'
	db	' whole.~"To ne\'er again speak of the spoils of my lust, ~"T'
	db	'hou must not tell a soul!"'
	db	00
L106E:	db	'He looks at you awaiting some sort of indication. Will you k'
	db	'eep his secret?'
	db	00
L10BA:	db	'"Thou dost walk with honor,~"I know thou wilt not tell,~"Of '
	db	'dignity\'s stains I do not bother,~"My concerns are none sav'
	db	'e for Nell."'
	db	00
L113E:	db	'"Reconsider, I must insist of thee, Thou art too thin of hid'
	db	'e,~"If he knew, Nell\'s brother would murder me,~"And I woul'
	db	'd not see Nell widowed before having the chance to become a '
	db	'bride."'
	db	00
L11F9:	db	'Nell with child'
	db	00
L1209:	db	'Charles is angry'
	db	00
L121A:	db	'"I am grateful for thine honesty about thy lack of care,~"Bu'
	db	't why hast thou placed thyself in the center of our affair?~'
	db	'"For Nell\'s sake I could not bring myself to cause harm to '
	db	'her brother,~"I shall convince him of mine intentions,~"I lo'
	db	've Nell and no other.~"Leave me now for I must use this time'
	db	' to properly prepare."'
	db	00
L135C:	db	'see'
	db	00
L1360:	db	'"I am sorry to say~"I have called it a day.~"Come to the gro'
	db	'unds at daybreak~"when the puppets are, yea verily, up and a'
	db	'wake."'
	db	00
L13DF:	db	'"See foolish pride and love, brutality and sin, Carrocio\'s '
	db	'tiny world of moving dolls,~"Enough to make thee gasp, or cr'
	db	'y or grin,~"All who wish to see \'tis time to hear my calls,'
	db	'~"For now the puppet show is about to begin!"*'
	db	00
L14C0:	db	'see'
	db	00
L14C4:	db	'bye'
	db	00
L14C8:	db	'"Perchance to find in mercy\'s ear, A voice to know as gentl'
	db	'e friend,~"I bid thee well, but hark return, If thou wouldst'
	db	' see the puppet\'s play or test thy strength again."'
	db	00
L1573:	db	'@See the puppets!@'
	db	00
L1586:	db	'@Canst thou ring the bell?@'
	db	00
L15A2:	db	'@Next show starts soon!@'
	db	00
L15BB:	db	'@Measure thy might!@'
	db	00
