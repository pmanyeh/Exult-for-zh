L0091:	db	'"What wouldst thou like?"'
	db	00
L00AB:	db	'"Very well."'
	db	00
L00B8:	db	'"I have no more. For some reason, no one is sending Silverle'
	db	'af to us, so I cannot make a meal from it."'
	db	00
L0120:	db	'"^'
	db	00
L0123:	db	' Is that all right?"'
	db	00
L0138:	db	'How many '
	db	00
L0142:	db	'sets '
