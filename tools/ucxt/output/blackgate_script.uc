	; Function at file offset 0005A35BH
	.funcnumber  0432H
	.data
	.msize       081FH
	.dsize       060EH
L0000:	db	'bye'
	db	00
L0004:	db	'job'
	db	00
L0008:	db	'name'
	db	00
L000D:	db	'You see a friendly-looking farmer who waves at you as you ap'
	db	'proach.'
	db	00
L0051:	db	'"Hello again, '
	db	00
L0060:	db	'." says Fred.'
	db	00
L006E:	db	'name'
	db	00
L0073:	db	'"My name is Fred."'
	db	00
L0086:	db	'name'
	db	00
L008B:	db	'job'
	db	00
L008F:	db	'"I sell meats here at the Farmer\'s Market in Britain."'
	db	00
L00C6:	db	'Farmer\'s Market'
	db	00
L00D6:	db	'meats'
	db	00
L00DC:	db	'meats'
	db	00
L00E2:	db	'"They are the tastiest meats that thou canst buy. Do thyself'
	db	' a favor and try some."'
	db	00
L0136:	db	'meats'
	db	00
L013C:	db	'buy'
	db	00
L0140:	db	'Farmer\'s Market'
	db	00
L0150:	db	'"Here at the Farmer\'s Market we sell vegetables bought from'
	db	' the farmers just outside of town, as well as meats from the'
	db	' slaughterhouse in Paws."'
	db	00
L01E1:	db	'Farmer\'s Market'
	db	00
L01F1:	db	'Paws'
	db	00
L01F6:	db	'slaughterhouse'
	db	00
L0205:	db	'slaughterhouse'
	db	00
L0214:	db	'"It is run by a man named Morfin, a very successful merchant'
	db	' from Buccaneer\'s Den."'
	db	00
L0268:	db	'slaughterhouse'
	db	00
L0277:	db	'Buccaneer\'s Den'
	db	00
L0287:	db	'Morfin'
	db	00
L028E:	db	'Morfin'
	db	00
L0295:	db	'"Morfin is an unusual character. If I did not know any bette'
	db	'r I would say he was involved with a number of shady busines'
	db	's activities."'
	db	00
L031C:	db	'Morfin'
	db	00
L0323:	db	'Buccaneer\'s Den'
	db	00
L0333:	db	'"Morfin left that place because he saw all of the commerce t'
	db	'hat was developing there as competition to his own business '
	db	'activities and moved to Paws."'
	db	00
L03CA:	db	'Buccaneer\'s Den'
	db	00
L03DA:	db	'Paws'
	db	00
L03DF:	db	'"Paws is a good place to go to buy things for low prices. Ma'
	db	'ny of the people are rather poor, I am sorry to say. There i'
	db	's little active commerce there, however. In Paws, one must d'
	db	'eal with people on a more personal level."'
	db	00
L04BE:	db	'Paws'
	db	00
L04C3:	db	'buy'
	db	00
L04C7:	db	'"Thou must return when the Farmer\'s Market is open."'
	db	00
L04FC:	db	'"Wouldst thou like to buy some meats?"'
	db	00
L0523:	db	'"We have a fine selection of meats for thee today, '
	db	00
L0557:	db	'."'
	db	00
L055A:	db	'"Come back when thou art hungry and we shall serve thee then'
	db	'."'
	db	00
L0599:	db	'buy'
	db	00
L059D:	db	'bye'
	db	00
L05A1:	db	'"Goodbye, '
	db	00
L05AC:	db	'."*'
	db	00
L05B0:	db	'@Get thy vegetables here!@'
	db	00
L05CB:	db	'@Get thy meats here!@'
	db	00
L05E1:	db	'@Eggs for sale!@'
	db	00
L05F2:	db	'@Best prices in Britannia!@'
	db	00
