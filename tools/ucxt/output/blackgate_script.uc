L0005:	db	'the party'
	db	00
L000F:	db	'"^'
	db	00
L0012:	db	', I have weighed thine actions against thy former conduct. N'
	db	'ow that I am travelling with '
	db	00
L006C:	db	'...'
	db	00
L0070:	db	'I forgive thy misrepresentation at our first meeting."'
