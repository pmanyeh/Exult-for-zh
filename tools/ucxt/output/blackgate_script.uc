	; Function at file offset 000FD4EAH
	.funcnumber  04E6H
	.data
	.msize       0F01H
	.dsize       0C9DH
L0000:	db	'Avatar'
	db	00
L0007:	db	'a pseudonym'
	db	00
L0013:	db	'bye'
	db	00
L0017:	db	'job'
	db	00
L001B:	db	'name'
	db	00
L0020:	db	'Hook'
	db	00
L0025:	db	'You see a pirate who is elegantly dressed and obviously rich'
	db	'. He reeks of pomade.'
	db	00
L0077:	db	'"Yes?" Gordy asks.'
	db	00
L008A:	db	'name'
	db	00
L008F:	db	'"I am Gordy." He grins widely offering you his hand. You not'
	db	'ice that it is none too clean.'
	db	00
L00EA:	db	'name'
	db	00
L00EF:	db	'job'
	db	00
L00F3:	db	'"I am \'The Mister\' of the House of Games. Inside mine Hous'
	db	'e thou mayest challenge thy skill at games of chance." He ey'
	db	'es you carefully, measuring your worth and gullibility.'
	db	00
L01A1:	db	'"Enter and enjoy! But first thou must register. Please sign '
	db	'the book so that we may verify thy proclaimed worth." Which '
	db	'name do you sign?'
	db	00
L022B:	db	'You sign your name. "Very good, '
	db	00
L024C:	db	'. Welcome to the House of Games!" Gordy spreads his arms in '
	db	'an expansive gesture, obviously pleased to welcome your mone'
	db	'y to his gambling parlour.'
	db	00
L02DF:	db	'Gordy frowns when he sees what you wrote. "Avatar, eh? We ju'
	db	'st had one of them a week ago. He was caught cheating at the'
	db	' tables!" He takes a step back and glowers. "Art thou going '
	db	'to give us trouble?"'
	db	00
L03A8:	db	'"Then thou canst not enter!"*'
	db	00
L03C6:	db	'"We shall see about that!"'
	db	00
L03E1:	db	'You sign in a false name. "Fine, '
	db	00
L0403:	db	'. I be glad to welcome thee!" Gordy spreads his arms in an e'
	db	'xpansive gesture, obviously pleased to welcome your money to'
	db	' his gambling parlour.'
	db	00
L0492:	db	'"I hope to see thee there during business hours."'
	db	00
L04C4:	db	'"Ah, thou art a Fellowship member. Thou wilt surely find thy'
	db	' reward at these tables!" Gordy winks and nudges you, then g'
	db	'uffaws loudly.'
	db	00
L054B:	db	'skill'
	db	00
L0551:	db	'House of Games'
	db	00
L0560:	db	'The Mister'
	db	00
L056B:	db	'House of Games'
	db	00
L057A:	db	'"The House of Games was established six years ago with the f'
	db	'unds of... an interested party. It attracts people from all '
	db	'over Britannia who wish to live dangerously with their money'
	db	'. The business is very profitable." He pats his pouch, and c'
	db	'oins clink. "Very profitable." He grins.'
	db	00
L0693:	db	'House of Games'
	db	00
L06A2:	db	'profitable'
	db	00
L06AD:	db	'party'
	db	00
L06B3:	db	'The Mister'
	db	00
L06BE:	db	'"It refers to my being the overseer, but everyone here has a'
	db	'lways called me \'The Mister\'. I am not sure why. But it ap'
	db	'peals to me." He puffs up like a bantam rooster, trying to l'
	db	'ook important. He almost succeeds.'
	db	00
L0793:	db	'"And that is \'Mister\' Gordy, to thee!"'
	db	00
L07BA:	db	'The Mister'
	db	00
L07C5:	db	'Mister Gordy'
	db	00
L07D2:	db	'Mister Gordy'
	db	00
L07DF:	db	'"Yes, what can I do for thee?"'
	db	00
L07FE:	db	'He grins, very pleased with himself.'
	db	00
L0823:	db	'Mister Gordy'
	db	00
L0830:	db	'skill'
	db	00
L0836:	db	'"Each game requires a definite skill in determining the most'
	db	' profitable way to place a bet. Many visitors to the House o'
	db	'f Games find that they have a skill. Others, sadly, do not."'
	db	00
L08EB:	db	'He gestures toward your Fellowship medallion. "Thou shouldst'
	db	' not have any problem." He winks and wiggles his eyebrows.'
	db	00
L0962:	db	'skill'
	db	00
L0968:	db	'profitable'
	db	00
L0973:	db	'"Well, Buccaneer\'s Den is not in the jurisdiction of the Br'
	db	'itannian Tax Council. We are not subject to Britannia\'s tax'
	db	'es." Gordy smiles wickedly. "And that... is very profitable!'
	db	'"'
	db	00
L0A27:	db	'profitable'
	db	00
L0A32:	db	'Hook'
	db	00
L0A37:	db	'The Cube vibrates a moment. "Yes, I know Hook very well. He '
	db	'lives beneath the House of Games. Talk to Sintag. He can dir'
	db	'ect thee."'
	db	00
L0ABA:	db	'"I do not know anyone of that description." Gordy looks arou'
	db	'nd nervously and loosens his collar as though it has suddenl'
	db	'y gotten too tight.'
	db	00
L0B46:	db	'Hook'
	db	00
L0B4B:	db	'party'
	db	00
L0B51:	db	'The Cube vibrates a moment. "That would be The Fellowship, o'
	db	'f course."'
	db	00
L0B98:	db	'"Well, now,... that would be revealin\' the secret of my bus'
	db	'iness and profit, now wouldn\'t it?" His demeanor becomes th'
	db	'reatening as he leans closer to you and snarls, "Find thine '
	db	'own backers, whelp!"*'
	db	00
L0C60:	db	'party'
	db	00
L0C66:	db	'bye'
	db	00
L0C6A:	db	'"Farewell, friend. I look forward to thy return."*'
	db	00
