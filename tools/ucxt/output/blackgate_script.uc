	; Function at file offset 000D9C66H
	.funcnumber  04B9H
	.data
	.msize       1154H
	.dsize       0E52H
L0000:	db	'The gargoyle seems to be too busy conducting the Fellowship '
	db	'meeting to speak with you now.'
	db	00
L005B:	db	'bye'
	db	00
L005F:	db	'Fellowship'
	db	00
L006A:	db	'job'
	db	00
L006E:	db	'name'
	db	00
L0073:	db	'Elizabeth and Abraham'
	db	00
L0089:	db	'You see a winged gargoyle. Noticing you, he turns and says, '
	db	'"To be welcome, human. To need assistance?"'
	db	00
L00F1:	db	'"To ask how I may assist, human."'
	db	00
L0113:	db	'name'
	db	00
L0118:	db	'"To be the one named Quan."'
	db	00
L0134:	db	'name'
	db	00
L0139:	db	'Quan'
	db	00
L013E:	db	'Quan'
	db	00
L0143:	db	'"To have no meaning in Gargish. To be a special name, specif'
	db	'ic to me," he smiles.'
	db	00
L0195:	db	'Quan'
	db	00
L019A:	db	'job'
	db	00
L019E:	db	'"To head The Fellowship in Terfin."'
	db	00
L01C2:	db	'Terfin'
	db	00
L01C9:	db	'voice'
	db	00
L01CF:	db	'voice'
	db	00
L01D5:	db	'"To be the inner voice of guidance that lives in all creatur'
	db	'es. To become more distinct and frequent with stronger Fello'
	db	'wship ties."'
	db	00
L025A:	db	'voice'
	db	00
L0260:	db	'Terfin'
	db	00
L0267:	db	'"To be the only gargoyle city in Britannia. To have fewer ga'
	db	'rgoyles in the land than during your last visit to Britannia'
	db	', human." He shakes his head.'
	db	00
L02FD:	db	'gargoyles'
	db	00
L0307:	db	'fewer'
	db	00
L030D:	db	'Terfin'
	db	00
L0314:	db	'fewer'
	db	00
L031A:	db	'"To have succumbed to the effects of disease and famine that'
	db	' have recently struck Britannia. To tell you that gargoyles '
	db	'breed less frequently, and we have not had the time to make '
	db	'up for losses in our population.~~"To have new hope, however'
	db	'," he grins, "with The Fellowship."'
	db	00
L042E:	db	'fewer'
	db	00
L0434:	db	'gargoyles'
	db	00
L043E:	db	'"To suggest talking to Runeb, the Fellowship clerk, or Quaev'
	db	'en. To have jobs needing knowledge of others in Terfin." He '
	db	'grins apologetically.~~ "To be too busy to know all in Terfi'
	db	'n."'
	db	00
L04F6:	db	'gargoyles'
	db	00
L0500:	db	'Fellowship'
	db	00
L050B:	db	'"To hold meetings at 9 p.m., in unity with other branches, h'
	db	'uman. To be welcome at our meetings."'
	db	00
L056D:	db	'"To be a boon to gargoyles and humans alike. To have a philo'
	db	'sophy to help all creatures of all races reach their highest'
	db	' level of potential."'
	db	00
L05FB:	db	'philosophy'
	db	00
L0606:	db	'"To be a boon to gargoyles and humans alike. To have a philo'
	db	'sophy to help all creatures of all races reach their highest'
	db	' level of potential."'
	db	00
L0694:	db	'philosophy'
	db	00
L069F:	db	'altar conflicts'
	db	00
L06AF:	db	'Fellowship'
	db	00
L06BA:	db	'Elizabeth and Abraham'
	db	00
L06D0:	db	'"To have just missed the human Fellowship officials who were'
	db	' here collecting funds. To have left for the Meditation Retr'
	db	'eat near Serpent\'s Hold. To be sorry."'
	db	00
L076F:	db	'"To have not seen human Fellowship officials in many days."'
	db	00
L07AB:	db	'Elizabeth and Abraham'
	db	00
L07C1:	db	'philosophy'
	db	00
L07CC:	db	'An almost gleeful expression fills his visage.~~ "To be very'
	db	' similar to the altar of singularity. To have three principl'
	db	'es called the Triad of Inner Strength. To apply three princi'
	db	'ples in unison to be more creative and happy.~~ "To see the '
	db	'similarity? To have control, passion, and diligence mesh int'
	db	'o one -- singularity. To have Triad -- Strive for Unity, Tru'
	db	'st your Brother, and Worthiness Precedes Reward -- applied i'
	db	'n unison!"'
	db	00
L097B:	db	'philosophy'
	db	00
L0986:	db	'altar conflicts'
	db	00
L0996:	db	'"To understand not," he says, puzzled.'
	db	00
L09BD:	db	'altar destruction'
	db	00
L09CF:	db	'altar conflicts'
	db	00
L09DF:	db	'altar destruction'
	db	00
L09F1:	db	'"To know nothing of this! To believe it not! To be not possi'
	db	'ble.~~ "To know that all members are content with their live'
	db	's, and incapable of such acts, even if the altars be outdate'
	db	'd.~~ "To tell you to speak with members themselves to see an'
	db	'd believe."'
	db	00
L0AED:	db	'members'
	db	00
L0AF5:	db	'outdated'
	db	00
L0AFE:	db	'altar destruction'
	db	00
L0B10:	db	'Sarpling\'s note'
	db	00
L0B20:	db	'Runeb assassinate'
	db	00
L0B32:	db	'outdated'
	db	00
L0B3B:	db	'"To need the Triad for proper application to the individual '
	db	'gargoyle -- or person!"'
	db	00
L0B8F:	db	'outdated'
	db	00
L0B98:	db	'members'
	db	00
L0BA0:	db	'"To talk to Runeb, Sarpling, and Quaeven."'
	db	00
L0BCB:	db	'Quaeven'
	db	00
L0BD3:	db	'Sarpling'
	db	00
L0BDC:	db	'Runeb'
	db	00
L0BE2:	db	'members'
	db	00
L0BEA:	db	'Runeb'
	db	00
L0BF0:	db	'"To have been the clerk of The Fellowship here."'
	db	00
L0C21:	db	'"To be the clerk of The Fellowship here."'
	db	00
L0C4B:	db	'Runeb'
	db	00
L0C51:	db	'Sarpling'
	db	00
L0C5A:	db	'"To sell magics and such at his shop."'
	db	00
L0C81:	db	'Sarpling'
	db	00
L0C8A:	db	'Quaeven'
	db	00
L0C92:	db	'"To be in charge of the learning center."'
	db	00
L0CBC:	db	'Quaeven'
	db	00
L0CC4:	db	'Sarpling\'s note'
	db	00
L0CD4:	db	'"To be impossible for Runeb to be responsible." He smiles ki'
	db	'ndly. "To be a practical joke."'
	db	00
L0D30:	db	'Sarpling\'s note'
	db	00
L0D40:	db	'Runeb assassinate'
	db	00
L0D52:	db	'"To be too heinous a plot for Runeb." He frowns. "To be some'
	db	' kind of bad joke."'
	db	00
L0DA2:	db	'Runeb assassinate'
	db	00
L0DB4:	db	'bye'
	db	00
L0DB8:	db	'"To hope you find unity."*'
	db	00
L0DD3:	db	'The Cube did not vibrate once while speaking with Quan. You '
	db	'realize he is totally innocent of the dangerous powers above'
	db	' him.*'
	db	00
