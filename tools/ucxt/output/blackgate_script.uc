L0099:	db	'?"'
	db	00
L009C:	db	'My crime'
	db	00
L00A5:	db	'My deed'
	db	00
L00AD:	db	'My lie'
	db	00
L00B4:	db	'My lie'
	db	00
L00BB:	db	'My crime'
	db	00
L00C4:	db	'My deed'
	db	00
L00CC:	db	'My lie'
	db	00
L00D3:	db	'"Of what lie speakest thou? Art thou not '
	db	00
L00FD:	db	'?"'
	db	00
	db	00
L0101:	db	'"Perhaps thou art not '
	db	00
L0118:	db	', for I have never seen the '
	db	00
L0135:	db	'. Confess now thy true identity!"'
	db	00
L0157:	db	'Avatar'
	db	00
L015E:	db	'My deed'
	db	00
L0166:	db	'"Speak not of thy deed! Such deeds must deeds receive to equ'
	db	'al their merit."'
	db	00
L01B3:	db	'My crime'
	db	00
L01BC:	db	'"Crime most foul, most horrible!"'
	db	00
L01DE:	db	'Avatar'
	db	00
L01E5:	db	'Avatar'
	db	00
L01EC:	db	'"I doubt but thou deceivest me further. If true, thou dost s'
	db	'hame the title. Admit now thy true name!"'
	db	00
	db	00
L0253:	db	'"'
	db	00
L0255:	db	'! Perhaps honesty shall lift thee above the '
	db	00
L0282:	db	' '
	db	00
L0284:	db	'..."'
	db	00
	db	00
L028A:	db	'"^'
	db	00
L028D:	db	'! ^'
	db	00
L0291:	db	'! Thy soul shall wail in the catacombs of the netherworld!"'
	db	00
L02CD:	db	'"^'
	db	00
L02D0:	db	'! Fly from this place at once! I shall provide escort for th'
	db	'ee with my bow. Return at thy peril, '
	db	00
L0332:	db	'."'
	db	00
L0335:	db	'"I shall not take this deception lightly."'
	db	00
