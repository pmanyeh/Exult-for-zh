	; Function at file offset 00074B64H
	.funcnumber  0452H
	.data
	.msize       0C94H
	.dsize       0A45H
L0000:	db	'Gregor is busy concentrating on the Fellowship meeting and c'
	db	'annot talk now.*'
	db	00
L004D:	db	'"No time for idle chatter! I must get to the Fellowship Meet'
	db	'ing! I am late!"*'
	db	00
L009B:	db	'bye'
	db	00
L009F:	db	'job'
	db	00
L00A3:	db	'name'
	db	00
L00A8:	db	'Elynor'
	db	00
L00AF:	db	'You see an old man whose domineering disposition matches the'
	db	' hardened physique of his aged body.'
	db	00
L0110:	db	'"Art thou addressing me?" Gregor scowls.'
	db	00
L0139:	db	'name'
	db	00
L013E:	db	'"My name is Gregor."'
	db	00
L0153:	db	'name'
	db	00
L0158:	db	'job'
	db	00
L015C:	db	'"I am in charge of the Minoc branch of the Britannian Mining'
	db	' Company."'
	db	00
L01A3:	db	'Britannian Mining Company'
	db	00
L01BD:	db	'Minoc'
	db	00
L01C3:	db	'"Art thou fevered, '
	db	00
L01D7:	db	'? Dost thou not realize why we have gathered at this spot? '
	db	'\'Tis shameful, thine unaffected manner in the presence of s'
	db	'uch tragedy!"'
	db	00
L025B:	db	'murders'
	db	00
L0263:	db	'Minoc'
	db	00
L0269:	db	'"Our town is a major center of trade in Britannia, and it is'
	db	' a place of social change."'
	db	00
L02C1:	db	'Minoc'
	db	00
L02C7:	db	'social change'
	db	00
L02D5:	db	'trade'
	db	00
L02DB:	db	'Britannian Mining Company'
	db	00
L02F5:	db	'"The Britannian Mining Company produces a wide variety of mi'
	db	'nerals that are essential to the continuation of progress in'
	db	'\tBritannia."'
	db	00
L037A:	db	'Britannian Mining Company'
	db	00
L0394:	db	'trade'
	db	00
L039A:	db	'"Here in Minoc we have one of the largest mining operations '
	db	'in Britannia, a sawmill, an inn, the Artist\'s Guild, and a '
	db	'shipwright."'
	db	00
L041E:	db	'shipwright'
	db	00
L0429:	db	'Artist\'s Guild'
	db	00
L0438:	db	'inn'
	db	00
L043C:	db	'sawmill'
	db	00
L0444:	db	'trade'
	db	00
L044A:	db	'social change'
	db	00
L0458:	db	'"Here in Minoc we are erecting a monument to our good shipwr'
	db	'ight Owen, a master craftsman whose name will soon be known '
	db	'throughout Britannia. We also have a very active Fellowship '
	db	'branch."'
	db	00
L0515:	db	'social change'
	db	00
L0523:	db	'Fellowship'
	db	00
L052E:	db	'monument'
	db	00
L0537:	db	'sawmill'
	db	00
L053F:	db	'"A long-standing and profitable business. A shame it will be'
	db	'come more renowned for the murders that were committed there'
	db	' than for any of the fine work it does."'
	db	00
L05E0:	db	'sawmill'
	db	00
L05E8:	db	'inn'
	db	00
L05EC:	db	'"The Checquered Cork is famous for its rustic character and '
	db	'atmosphere. It is a fine place. Do not be put off by its app'
	db	'arent uncleanliness."'
	db	00
L067A:	db	'inn'
	db	00
L067E:	db	'Artist\'s Guild'
	db	00
L068D:	db	'"The Artist\'s Guild is a small collection of craftspeople w'
	db	'ho have huddled together to sell their little trinkets. They'
	db	' pride themselves on being the local dissenters of everythin'
	db	'g."'
	db	00
L0744:	db	'Artist\'s Guild'
	db	00
L0753:	db	'shipwright'
	db	00
L075E:	db	'"I may have already mentioned Owen, the shipwright. He build'
	db	's the finest ships that have ever set sail."'
	db	00
L07C7:	db	'shipwright'
	db	00
L07D2:	db	'monument'
	db	00
L07DB:	db	'"I helped to organize things with Mayor Burnside to get the '
	db	'monument built."'
	db	00
L0828:	db	'"It will be huge and made of the finest ore from our mine."'
	db	00
L0864:	db	'monument'
	db	00
L086D:	db	'Fellowship'
	db	00
L0878:	db	'"They have done immeasurable good for Minoc, helping to coun'
	db	'ter the disunity that can plague a town such as ours where s'
	db	'o many people are fixated upon monetary gain."'
	db	00
L091F:	db	'Fellowship'
	db	00
L092A:	db	'murders'
	db	00
L0932:	db	'"It is terrible! The gypsies Frederico and Tania have been f'
	db	'ound murdered in William\'s sawmill!"'
	db	00
L0993:	db	'murders'
	db	00
L099B:	db	'Elynor'
	db	00
L09A2:	db	'"Leave us in peace, damn thee! Elynor and I are in love and '
	db	'we wish to be alone together! Find thy cheap excitations els'
	db	'ewhere!"'
	db	00
L0A23:	db	'Elynor'
	db	00
L0A2A:	db	'bye'
	db	00
L0A2E:	db	'"Be on thy way then."*'
	db	00
