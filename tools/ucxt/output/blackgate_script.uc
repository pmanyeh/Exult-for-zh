L0000:	db	'@That appears to be fine cloth, no doubt it would fetch '
	db	00
L0039:	db	'a fair price in Minoc. Or, perhapse, thou couldst cut '
	db	00
L0070:	db	'it into bandages with shears.@'
	db	00
