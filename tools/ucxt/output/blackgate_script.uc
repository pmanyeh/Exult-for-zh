L0000:	db	'"To be my final offer -- '
	db	00
L001A:	db	'."'
	db	00
L001D:	db	'"To want '
	db	00
L0027:	db	' gold."'
	db	00
L002F:	db	'"To accept?"'
	db	00
L003C:	db	'"To have a deal."'
	db	00
L004E:	db	'"To wonder why you bothered me."'
	db	00
L006F:	db	'"To have another offer?"'
	db	00
L0088:	db	'"To notice you are obviously not interested."'
	db	00
L00B6:	db	'"To accept your offer."'
	db	00
L00CE:	db	'"To be happy," he says. "To have wanted to keep it anyway! T'
	db	'o tell you to leave."'
	db	00
L0120:	db	'"To be agreed!"'
	db	00
L0130:	db	'"To be foolish to accept so little!"'
	db	00
L0155:	db	'"To charge more next time. To have sold to you too cheaply!"'
	db	00
