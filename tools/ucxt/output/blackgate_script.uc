	; Function at file offset 000D709AH
	.funcnumber  04B5H
	.data
	.msize       06FFH
	.dsize       0505H
L0000:	db	'bye'
	db	00
L0004:	db	'job'
	db	00
L0008:	db	'name'
	db	00
L000D:	db	'The gargoyle has a pleasant expression on his face.'
	db	00
L0041:	db	'"To be pleased at your return, human," says Inforlem.'
	db	00
L0077:	db	'name'
	db	00
L007C:	db	'"To be known as Inforlem."'
	db	00
L0097:	db	'name'
	db	00
L009C:	db	'Inforlem'
	db	00
L00A5:	db	'Inforlem'
	db	00
L00AE:	db	'"To mean `make strong one.\'"'
	db	00
L00CB:	db	'Inforlem'
	db	00
L00D4:	db	'job'
	db	00
L00D8:	db	'"To train others in Terfin to be strong and powerful. To sel'
	db	'l some weapons, also."'
	db	00
L012B:	db	'buy'
	db	00
L012F:	db	'Terfin'
	db	00
L0136:	db	'others'
	db	00
L013D:	db	'train'
	db	00
L0143:	db	'conflicts'
	db	00
L014D:	db	'buy'
	db	00
L0151:	db	'"To sell during shop hours. To ask you to come back to me at'
	db	' that time, please."'
	db	00
L01A2:	db	'train'
	db	00
L01A8:	db	'"To be a better warrior or mage?"'
	db	00
L01CA:	db	'mage'
	db	00
L01CF:	db	'warrior'
	db	00
L01D7:	db	'"To train during training hours. To ask you to come back to '
	db	'me at that time, please."'
	db	00
L022D:	db	'warrior'
	db	00
L0235:	db	'"To charge 50 gold for each training session. To be all righ'
	db	't?"'
	db	00
L0275:	db	'"To apologize, but I must charge that amount!"'
	db	00
L02A4:	db	'mage'
	db	00
L02A9:	db	'"To charge 50 gold for each training session. To be acceptab'
	db	'le?"'
	db	00
L02EA:	db	'"To apologize, but I must charge that amount!"'
	db	00
L0319:	db	'conflicts'
	db	00
L0323:	db	'"To know of the conflicts between the altars and the Fellows'
	db	'hip, but to have no information. To suggest you see Quan, Th'
	db	'e Fellowship leader here and ask him."'
	db	00
L03C2:	db	'conflicts'
	db	00
L03CC:	db	'Terfin'
	db	00
L03D3:	db	'"To see there are troubles here, but to be unaware of the ca'
	db	'uses and solutions."'
	db	00
L0424:	db	'Terfin'
	db	00
L042B:	db	'others'
	db	00
L0432:	db	'"To tell you Forbrak knows much about Terfin and its residen'
	db	'ts, and," he says, "about its conflicts."'
	db	00
L0498:	db	'others'
	db	00
L049F:	db	'Forbrak'
	db	00
L04A7:	db	'conflicts'
	db	00
L04B1:	db	'Forbrak'
	db	00
L04B9:	db	'"To be the tavernkeeper."'
	db	00
L04D3:	db	'Forbrak'
	db	00
L04DB:	db	'bye'
	db	00
L04DF:	db	'"To expect to see you again, human."*'
	db	00
