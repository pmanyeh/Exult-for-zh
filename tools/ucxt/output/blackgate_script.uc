	; Function at file offset 00049600H
	.funcnumber  041DH
	.data
	.msize       0809H
	.dsize       0621H
L0000:	db	'bye'
	db	00
L0004:	db	'job'
	db	00
L0008:	db	'name'
	db	00
L000D:	db	'This actor has much stage presence and a booming voice.'
	db	00
L0045:	db	'Stuart looks down his nose at you. "Yes?"'
	db	00
L006F:	db	'name'
	db	00
L0074:	db	'"My real name is Stuart. My stage name is Laurence."'
	db	00
L00A9:	db	'name'
	db	00
L00AE:	db	'Laurence'
	db	00
L00B7:	db	'job'
	db	00
L00BB:	db	'"I am the greatest actor who ever lived," he proclaims with '
	db	'absolutely no modesty. "I am playing the character \'Iolo\' '
	db	'in the new play."'
	db	00
L0143:	db	'Iolo'
	db	00
L0148:	db	'Laurence'
	db	00
L0151:	db	'"\'Tis the name of a particular hero of mine."'
	db	00
L017F:	db	'Laurence'
	db	00
L0188:	db	'Iolo'
	db	00
L018D:	db	'Stuart\'s feathers are obviously ruffled. "Yes. I have been '
	db	'cast as second banana yet again! I am much more suited to pl'
	db	'ay the Avatar, but did Raymundo cast me? Noooo!"'
	db	00
L0235:	db	'"But thou art nothing like me!"*'
	db	00
L0256:	db	'"And who art thou, pray tell?"*'
	db	00
L0276:	db	'"Why, I am the -real- Iolo!"*'
	db	00
L0294:	db	'"Of course thou art. And I am really Lord British. Thou must'
	db	' take me for an ass to think I would believe that."*'
	db	00
L0305:	db	'Your friend whispers to you. "These actor types. A touchy bu'
	db	'nch, eh?"*'
	db	00
L034C:	db	'Avatar'
	db	00
L0353:	db	'Raymundo'
	db	00
L035C:	db	'Iolo'
	db	00
L0361:	db	'Raymundo'
	db	00
L036A:	db	'"I suppose he\'s a good director. He never casts me in the r'
	db	'ight roles, though. And to think I went to school with him! '
	db	'We were on our first stage crew together!"'
	db	00
L040C:	db	'Raymundo'
	db	00
L0415:	db	'Avatar'
	db	00
L041C:	db	'Stuart whispers to you, "Jesse is all wrong! Why, -thou- wou'
	db	'ldst make a better Avatar than he! And -thou- probably could'
	db	'st not act thy way out of a reagent bag! That is not a refle'
	db	'ction on thee, but on Jesse."'
	db	00
L04EE:	db	'act'
	db	00
L04F2:	db	'Avatar'
	db	00
L04F9:	db	'act'
	db	00
L04FD:	db	'"Acting is the highest form of art. It allows one to step ou'
	db	'tside oneself and become another person. \'Tis like a game!"'
	db	00
L0575:	db	'act'
	db	00
L0579:	db	'bye'
	db	00
L057D:	db	'"Goodbye. Be sure to come to the show when it opens!"*'
	db	00
L05B4:	db	'@I am Iolo, my liege!@'
	db	00
L05CB:	db	'@I hear something to the east!@'
	db	00
L05EB:	db	'@This is Dungeon Despise!@'
	db	00
L0606:	db	'@Ready the bow to use it!@'
	db	00
