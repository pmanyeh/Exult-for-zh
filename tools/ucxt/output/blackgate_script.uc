	; Function at file offset 00153034H
	.funcnumber  0893H
	.data
	.msize       0247H
	.dsize       01E6H
L0000:	db	'Adjhar appears to have resumed the stance of a more traditio'
	db	'nal golem guardian -- staunch and distant. However, it is im'
	db	'possible to miss the glimmer of intelligence in his eyes.'
	db	00
L00B2:	db	'bye'
	db	00
L00B6:	db	'job'
	db	00
L00BA:	db	'name'
	db	00
L00BF:	db	'name'
	db	00
L00C4:	db	'"I am and always will be the one called Adjhar."'
	db	00
L00F5:	db	'name'
	db	00
L00FA:	db	'job'
	db	00
L00FE:	db	'"Now that thou hast mastered the Principle of Love, I no lon'
	db	'ger serve a function."'
	db	00
L0151:	db	'job'
	db	00
L0155:	db	'bye'
	db	00
L0159:	db	'"Goodbye, Avatar. As always I thank thee for thy kindness in'
	db	' assisting two brothers in need. Forget not the lessons taug'
	db	'ht by the Shrines."*'
	db	00
