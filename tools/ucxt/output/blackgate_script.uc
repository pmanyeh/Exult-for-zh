	; Function at file offset 0003A289H
	.funcnumber  040DH
	.data
	.msize       0ADDH
	.dsize       0882H
L0000:	db	'bye'
	db	00
L0004:	db	'murder'
	db	00
L000B:	db	'job'
	db	00
L000F:	db	'name'
	db	00
L0014:	db	'password'
	db	00
L001D:	db	'Klog'
	db	00
L0022:	db	'Fellowship'
	db	00
L002D:	db	'ship'
	db	00
L0032:	db	'Hook'
	db	00
L0037:	db	'You see a grumpy fellow with a bloody bandage on his head.'
	db	00
L0072:	db	'"Dost thou need something else?" Gilberto asks. You notice h'
	db	'is wound is healing nicely.'
	db	00
L00CA:	db	'name'
	db	00
L00CF:	db	'"I am Gilberto."'
	db	00
L00E0:	db	'name'
	db	00
L00E5:	db	'job'
	db	00
L00E9:	db	'"I have the night watch at the dock gate."'
	db	00
L0114:	db	'murder'
	db	00
L011B:	db	'"It must have occurred shortly before I was knocked out."'
	db	00
L0155:	db	'knocked'
	db	00
L015D:	db	'murder'
	db	00
L0164:	db	'knocked'
	db	00
L016C:	db	'"It was just about sunrise. I was looking out to the sea. Al'
	db	'l of a sudden, I felt a blow on the back of mine head."~~ He'
	db	' winces in pain.'
	db	00
L01F5:	db	'pain'
	db	00
L01FA:	db	'blow'
	db	00
L01FF:	db	'knocked'
	db	00
L0207:	db	'pain'
	db	00
L020C:	db	'Gilberto still seems a little wobbly, but his gesture indica'
	db	'tes that he does not desire your aid.~"My skull is still rin'
	db	'ging, but I shall be all right momentarily."'
	db	00
L02B1:	db	'pain'
	db	00
L02B6:	db	'blow'
	db	00
L02BB:	db	'"The next thing I knew, I was on the ground. Johnson, the gu'
	db	'ard for the next watch, was shaking me. I had been out about'
	db	' ten minutes. I knew that because the sun had just peeked ov'
	db	'er the horizon. And \'The Crown Jewel\' had gone and sailed!'
	db	'"'
	db	00
L03AB:	db	'Crown Jewel'
	db	00
L03B7:	db	'Johnson'
	db	00
L03BF:	db	'blow'
	db	00
L03C4:	db	'Crown Jewel'
	db	00
L03D0:	db	'"Did I forget to say? That is a ship that was docked here al'
	db	'l night. I believe it was about to sail for Britain. Thou co'
	db	'uldst ask Gargan the Shipwright to make sure. Anyway, I did '
	db	'not see mine attackers," the guard grumbles.'
	db	00
L04B1:	db	'Gargan'
	db	00
L04B8:	db	'attackers'
	db	00
L04C2:	db	'Crown Jewel'
	db	00
L04CE:	db	'attackers'
	db	00
L04D8:	db	'"Hmmm. I wonder if they jumped onto the ship! They could be '
	db	'all the way to Britain by now!"'
	db	00
L0534:	db	'attackers'
	db	00
L053E:	db	'Gargan'
	db	00
L0545:	db	'"He is a good man but thou mayest not wish to stand too clos'
	db	'e to him. Thou mayest catch something."'
	db	00
L05A9:	db	'Gargan'
	db	00
L05B0:	db	'ship'
	db	00
L05B5:	db	'"If thou dost want a ship, thou must get a deed from the shi'
	db	'pwright. Thou must also have the password to leave town."'
	db	00
L062B:	db	'ship'
	db	00
L0630:	db	'password'
	db	00
L0639:	db	'password'
	db	00
L0642:	db	'"What is it?"'
	db	00
L0650:	db	'Please'
	db	00
L0657:	db	'Long live the king'
	db	00
L066A:	db	'Uhh, I don\'t know'
	db	00
L067C:	db	'Blackbird'
	db	00
L0686:	db	'Blackbird'
	db	00
L0690:	db	'"All right. Thou mayest pass."*'
	db	00
L06B0:	db	'"Thou mayest not pass."*'
	db	00
L06C9:	db	'"Thou dost not know the password. The Mayor can give thee th'
	db	'e proper password."'
	db	00
L0719:	db	'Johnson'
	db	00
L0721:	db	'"He takes the morning watch at the dock."'
	db	00
L074B:	db	'Johnson'
	db	00
L0753:	db	'Fellowship'
	db	00
L075E:	db	'He shrugs.~~"Thou art asking the wrong man. I suppose they a'
	db	're all right. I have never had trouble with them."'
	db	00
L07CD:	db	'Fellowship'
	db	00
L07D8:	db	'Hook'
	db	00
L07DD:	db	'The guard thinks a moment.~~"No. I cannot say that I saw a m'
	db	'an with a hook."'
	db	00
L082A:	db	'Hook'
	db	00
L082F:	db	'Klog'
	db	00
L0834:	db	'"I have not had many dealings with him."'
	db	00
L085D:	db	'Klog'
	db	00
L0862:	db	'bye'
	db	00
L0866:	db	'"Goodbye. Watch thy back."*'
	db	00
