	; Function at file offset 000EC287H
	.funcnumber  04CFH
	.data
	.msize       0D31H
	.dsize       09D3H
L0000:	db	'the Avatar'
	db	00
L000B:	db	'bye'
	db	00
L000F:	db	'job'
	db	00
L0013:	db	'name'
	db	00
L0018:	db	'"Ah, me good friend, Dupre. What kinna do fer ye this fine d'
	db	'ay?"'
	db	00
L0059:	db	'"Ah, master Yongi, always ready to offer a tankard of thy fi'
	db	'nest."'
	db	00
L009C:	db	'Tending the bar is a jovial-looking man. "Welcome ta the Gil'
	db	'ded Lizard."'
	db	00
L00E5:	db	'"Welcome back ta the Gilded Lizard. What may I do fer ye?" a'
	db	'sks Yongi.'
	db	00
L012C:	db	'name'
	db	00
L0131:	db	'"Me name is Yongi, '
	db	00
L0145:	db	'."'
	db	00
L0148:	db	'name'
	db	00
L014D:	db	'"And ye are?"'
	db	00
L015B:	db	'"Aye, '
	db	00
L0162:	db	'. Right ye are. If ye dinna care ta tell me, I don\'t mind a'
	db	' bit." He winks.'
	db	00
L01AE:	db	'"Welcome ta me tavern, '
	db	00
L01C6:	db	'."'
	db	00
L01C9:	db	'"Right ye are, '
	db	00
L01D9:	db	'. There\'s no need ta tell anyone yer name."'
	db	00
L0205:	db	'job'
	db	00
L0209:	db	'"Why, I tend me bar. And lend me ear ta the customers," he a'
	db	'dds, touching his right ear for emphasis.'
	db	00
L026F:	db	'buy'
	db	00
L0273:	db	'customers'
	db	00
L027D:	db	'Vesper'
	db	00
L0284:	db	'"Why, I wouldna wanna live anyplace else. \'Course, this tow'
	db	'n would be a better place if we could rid ourselves of those'
	db	' jackals, the gargoyles."'
	db	00
L0315:	db	'gargoyles'
	db	00
L031F:	db	'Vesper'
	db	00
L0326:	db	'gargoyles'
	db	00
L0330:	db	'"Gargoyles! What about them? They be the vilest, evilest, cr'
	db	'uelest, most despicable things ever ta crawl upon this great'
	db	' land. I kinna tell ye too well ta stay away from them. I ki'
	db	'n only imagine whata fine town this\'d be if there weren\'t '
	db	'na more gargoyles. \'Course, I know those dogs are probably '
	db	'sayin\' the same about us. Everybody knows they\'re gonna co'
	db	'me an\' kill allus in our sleep one evenin\'."'
	db	00
L04C0:	db	'"Why, only the other day one attacked Blorn. G\'won, ask him'
	db	' about it."'
	db	00
L0507:	db	'Blorn'
	db	00
L050D:	db	'gargoyles'
	db	00
L0517:	db	'customers'
	db	00
L0521:	db	'"Well, all I really know in Vesper are me regulars: Cador, M'
	db	'ara, and Blorn. Ye might be wantin\' ta talk to Auston, the '
	db	'mayor, or his clerk, Liana. Ah, now there\'s a fine, young l'
	db	'ass." He winks at you.'
	db	00
L05EA:	db	'Vesper'
	db	00
L05F1:	db	'Blorn'
	db	00
L05F7:	db	'Mara'
	db	00
L05FC:	db	'Cador'
	db	00
L0602:	db	'customers'
	db	00
L060C:	db	'Cador'
	db	00
L0612:	db	'"He used ta come here every night, \'til he was killed in a '
	db	'brawl." The bartender\'s eyes narrow as he talks.'
	db	00
L067E:	db	'"He be in here every night after work. Good man, hard worker'
	db	'."'
	db	00
L06BD:	db	'Cador'
	db	00
L06C3:	db	'Mara'
	db	00
L06C8:	db	'"She worked with Cador at the mines. She was more man than m'
	db	'ost men, that one was. An\' she died like it, too -- in a br'
	db	'awl here at the tavern!" He says, eyeing you suspiciously.'
	db	00
L077A:	db	'"She works with Cador at the mines. Hard as stone, that one.'
	db	' She be more man than most of the men in town."'
	db	00
L07E6:	db	'Mara'
	db	00
L07EB:	db	'Blorn'
	db	00
L07F1:	db	'"There be one who knows what\'s what. He knows what be wrong'
	db	' with this town! Gargoyles! That is what be wrong. He hates '
	db	'\'em, \'e does."'
	db	00
L0877:	db	'"He was even accosted by one of those jackals not too long a'
	db	'go. Ask \'im about it, why don\'t ye."'
	db	00
L08D8:	db	'gargoyles'
	db	00
L08E2:	db	'Blorn'
	db	00
L08E8:	db	'buy'
	db	00
L08EC:	db	'"Be ye wantin\' food or drink?"'
	db	00
L090B:	db	'drink'
	db	00
L0911:	db	'food'
	db	00
L0916:	db	'buy'
	db	00
L091A:	db	'food'
	db	00
L091F:	db	'food'
	db	00
L0924:	db	'drink'
	db	00
L092A:	db	'drink'
	db	00
L0930:	db	'bye'
	db	00
L0934:	db	'"May the road rise up ta meet ye!"*'
	db	00
L0958:	db	'@Zzzzz . . .@'
	db	00
L0966:	db	'@Refreshments here!@'
	db	00
L097B:	db	'@Get a fine cup o\' wine here!@'
	db	00
L099A:	db	'@We have the best spirits here!@'
	db	00
L09BB:	db	'@No gargoyles allowed!@'
	db	00
