	; Function at file offset 0013666EH
	.funcnumber  06F8H
	.data
	.msize       0C13H
	.dsize       0294H
L0000:	db	'@\'Tis sad that Erethian\'s lust for power has brought him t'
	db	'o this evil pass.@'
	db	00
L004D:	db	'@Perhaps, at last, he is at rest.@'
	db	00
L0070:	db	'@I am sure that Lord British even now awaits news of Exodus'
	db	'\' exile.@'
	db	00
L00B5:	db	'@It is time to leave this barren island behind.@'
	db	00
L00E6:	db	'"No! Thou must not do this!" Erethian\'s voice is full of an'
	db	'guish. He raises his arms and begins a powerful spell.'
	db	00
L0158:	db	'"Vas Ort Rel Tym..."'
	db	00
L016D:	db	'He stops mid-spell and begins another, pointing towards the '
	db	'Talisman of Infinity.'
	db	00
L01BF:	db	'"Vas An Ort Ailem!"'
	db	00
L01D3:	db	'You immediately recognize the resonance of a spell gone awry'
	db	', and apparently so does Erethian. A look of horror comes to'
	db	' his wrinkled features which appear to become more lined by '
	db	'the second.*'
	db	00
