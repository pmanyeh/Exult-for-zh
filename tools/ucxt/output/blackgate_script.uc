L027E:	db	'"I do not think that is correct."*'
	db	00
L02A1:	db	'"What didst thou find in the chest?"'
	db	00
L02C6:	db	'all of these'
	db	00
L02D3:	db	'none of these'
	db	00
L02E1:	db	'a scroll'
	db	00
L02EA:	db	'a medallion'
	db	00
L02F6:	db	'gold'
	db	00
L02FB:	db	'all of these'
	db	00
L0308:	db	'"Dost thou have a suspect?"'
	db	00
L0324:	db	'"Well, continue to gather information until thou dost have o'
	db	'ne."*'
	db	00
L0366:	db	'gold'
	db	00
L036B:	db	'a medallion'
	db	00
L0377:	db	'a scroll'
	db	00
