	; Function at file offset 000A2EE9H
	.funcnumber  0484H
	.data
	.msize       0D2DH
	.dsize       0A88H
L0000:	db	'bye'
	db	00
L0004:	db	'job'
	db	00
L0008:	db	'name'
	db	00
L000D:	db	'strangers'
	db	00
L0017:	db	'found'
	db	00
L001D:	db	'You see a scruffy young man who is obviously suffering from '
	db	'a broken heart.'
	db	00
L0069:	db	'Henry greets you. "It is good to speak with thee again, '
	db	00
L00A2:	db	'!"'
	db	00
L00A5:	db	'name'
	db	00
L00AA:	db	'"My name is Henry, '
	db	00
L00BE:	db	'."'
	db	00
L00C1:	db	'name'
	db	00
L00C6:	db	'job'
	db	00
L00CA:	db	'"Job?! Who can work when he has a broken heart?!"'
	db	00
L00FC:	db	'broken heart'
	db	00
L0109:	db	'"Although I am called a peddler, I have the greatest selecti'
	db	'on of items to be found in New Magincia."'
	db	00
L016F:	db	'New Magincia'
	db	00
L017C:	db	'New Magincia'
	db	00
L0189:	db	'"I have lived here all of my life and have never known anypl'
	db	'ace else. It is a basically a very nice place where people s'
	db	'till adhere to the old ways and values. The rest of the worl'
	db	'd must think it has passed us by, but it is they who have lo'
	db	'st what once was."'
	db	00
L028C:	db	'New Magincia'
	db	00
L0299:	db	'broken heart'
	db	00
L02A6:	db	'"I have been rejected by the woman I love."'
	db	00
L02D2:	db	'woman'
	db	00
L02D8:	db	'broken heart'
	db	00
L02E5:	db	'woman'
	db	00
L02EB:	db	'His eyes light up. "Her name is Constance, she is the most b'
	db	'eautiful woman in the world, and for a time we were in love.'
	db	'" His face falls, and he sighs deeply. "But that was before '
	db	'I made a terrible mistake..."'
	db	00
L03BD:	db	'mistake'
	db	00
L03C5:	db	'Constance'
	db	00
L03CF:	db	'woman'
	db	00
L03D5:	db	'Constance'
	db	00
L03DF:	db	'"She is the waterbearer of the town. She carries water from '
	db	'the well of Humility to all the homes in town."'
	db	00
L044B:	db	'Constance'
	db	00
L0455:	db	'mistake'
	db	00
L045D:	db	'"I promised to give her a very old and valuable locket as a '
	db	'token of mine affection. My childhood friend, Katrina, had g'
	db	'iven the locket to me."'
	db	00
L04ED:	db	'mistake'
	db	00
L04F5:	db	'Katrina'
	db	00
L04FD:	db	'locket'
	db	00
L0504:	db	'locket'
	db	00
L050B:	db	'"Before I could give her the locket, I lost it. I have searc'
	db	'hed everywhere but I cannot find it. Now, Constance thinks I'
	db	' am a cad and has forsaken me."'
	db	00
L05A3:	db	'locket'
	db	00
L05AA:	db	'lost'
	db	00
L05AF:	db	'Katrina'
	db	00
L05B7:	db	'"Katrina is a shepherd here on New Magincia. She has been a '
	db	'friend of mine since I was a boy."'
	db	00
L0616:	db	'"We have had some good memories, have we not, Henry?"'
	db	00
L064C:	db	'"Oh that we have! But thou wouldst not be my sweetheart, so '
	db	'we resigned ourselves to being \'just friends\' a long time '
	db	'ago, is that not true?"'
	db	00
L06DA:	db	'"Whatever thou dost say, dear Henry."'
	db	00
L0700:	db	'Katrina'
	db	00
L0708:	db	'lost'
	db	00
L070D:	db	'"I noticed I had lost the locket right after I spoke with th'
	db	'ose three strangers yesterday. Wouldst thou help me find it?'
	db	'"'
	db	00
L0787:	db	'"Oh, thank thee, '
	db	00
L0799:	db	'! If not for thee, I would be lost."'
	db	00
L07BE:	db	'"Oh, well... I know thou art busy on thine own quest. I than'
	db	'k thee for listening to my tale, '
	db	00
L081C:	db	'."'
	db	00
L081F:	db	'lost'
	db	00
L0824:	db	'strangers'
	db	00
L082E:	db	'"There are three other strangers in New Magincia. They arriv'
	db	'ed a few days before thee. Their ship was sunk and they bare'
	db	'ly made it here with their lives."'
	db	00
L08C9:	db	'strangers'
	db	00
L08D3:	db	'found'
	db	00
L08D9:	db	'"Thou hast found the locket!"'
	db	00
L08F7:	db	'You hand the locket to Henry. "Now I may give it to Constanc'
	db	'e and keep my promise to her! I cannot thank thee enough, Av'
	db	'atar!"'
	db	00
L0976:	db	'"I am glad that this situation has concluded in thy favor, d'
	db	'ear Henry."'
	db	00
L09BE:	db	'"My thanks to thee, Katrina."'
	db	00
L09DC:	db	'He looks distraught when you make no move to give it to him.'
	db	' "Where is it?! I need it if I am to prove myself to the wom'
	db	'an I love!"'
	db	00
L0A60:	db	'found'
	db	00
L0A66:	db	'bye'
	db	00
L0A6A:	db	'"Travel safely and be well."*'
	db	00
