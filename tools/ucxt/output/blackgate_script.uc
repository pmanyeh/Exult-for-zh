	db	'ngs: 2~~Crested helm: 3~~ Curved heater: 3~~Gauntlets: 2~~Go'
	db	'rget: 3~~Great helm: 4~~Greaves: 2~~ Kidney belt: 1~~Leather'
	db	' armour: 1~~Leather boots: 1~~Leather collar: 1~~ Leather gl'
	db	'oves: 1~~Leather helm: 1~~Leather leggings: 1~~Plate armour:'
	db	' 4~~ Plate leggings: 3~~Scale armour: 2~~Spiked shield: 2~~W'
	db	'ooden shield: 2*'
