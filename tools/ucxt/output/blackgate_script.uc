	; Function at file offset 000D5BABH
	.funcnumber  04B4H
	.data
	.msize       14EBH
	.dsize       1258H
L0000:	db	'bye'
	db	00
L0004:	db	'job'
	db	00
L0008:	db	'name'
	db	00
L000D:	db	'Inamo'
	db	00
L0013:	db	'Moongates'
	db	00
L001D:	db	'You see an aged gargoyle, bent and withered, with a regal be'
	db	'aring. He smiles gently.'
	db	00
L0072:	db	'"To be good to see you again, old friend. To be needing Drax'
	db	'inusom again so soon?"'
	db	00
L00C5:	db	'name'
	db	00
L00CA:	db	'"To have been many years. To be your old acquaintance, '
	db	00
L0102:	db	', Draxinusom."'
	db	00
L0111:	db	'name'
	db	00
L0116:	db	'job'
	db	00
L011A:	db	'"To ask about Job? To be unable to say that I truly have one'
	db	' at this time. To notice how the young ones no longer look t'
	db	'o me for guidance any more. To look more to Teregus, or, mor'
	db	'e often, to those in The Fellowship."'
	db	00
L01F4:	db	'Fellowship'
	db	00
L01FF:	db	'Teregus'
	db	00
L0207:	db	'Terfin'
	db	00
L020E:	db	'"To be quite comfortable for our needs. To be, however, unfo'
	db	'rtunate that it was thought necessary to isolate us from the'
	db	' humans. To have engendered resentment and tension in our yo'
	db	'unger generations. To remember not the old days, my friend -'
	db	'- the days when we had to work together to survive." He smil'
	db	'es, reliving old memories, then shakes his head.~~"To have h'
	db	'ad to give up many much when we moved."'
	db	00
L039E:	db	'give up'
	db	00
L03A6:	db	'Terfin'
	db	00
L03AD:	db	'give up'
	db	00
L03B5:	db	'"To have been many favorite possessions. To be too much trou'
	db	'ble to move so much." He sighs.'
	db	00
L0411:	db	'~"To especially regret selling my Ethereal Ring."'
	db	00
L0443:	db	'Ethereal Ring'
	db	00
L0451:	db	'selling'
	db	00
L0459:	db	'give up'
	db	00
L0461:	db	'Ethereal Ring'
	db	00
L046F:	db	'"Ah. To be, indeed, a lovely treasure. To have been quite us'
	db	'eful. A shame to have been, really, to have had to sell it. '
	db	'To have been one of my favorites."'
	db	00
L050A:	db	'Ethereal Ring'
	db	00
L0518:	db	'selling'
	db	00
L0520:	db	'"To have sold most of my treasures when we were... uh... ask'
	db	'ed, shall to say, to move to the island. To have all happene'
	db	'd rather quickly, you see. To have sold most to the Sultan o'
	db	'f Spektran."'
	db	00
L05E1:	db	'Sultan'
	db	00
L05E8:	db	'selling'
	db	00
L05F0:	db	'Sultan'
	db	00
L05F7:	db	'"To have seemed nice enough, for a human. To be a bit mad, h'
	db	'e is, even for a human. To tell you he lives on an island ju'
	db	'st to the west of us. To know, at least, that my prized poss'
	db	'essions would be safe in his hands."'
	db	00
L06D0:	db	'safe'
	db	00
L06D5:	db	'Sultan'
	db	00
L06DC:	db	'safe'
	db	00
L06E1:	db	'He nods his head. "To be rumored to have one of the best-gua'
	db	'rded vaults in all of Britannia. To be supposedly enchanted.'
	db	' To know not details."'
	db	00
L0770:	db	'safe'
	db	00
L0775:	db	'Inamo'
	db	00
L077B:	db	'Inamo'
	db	00
L0781:	db	'"To be a fine young gargoyle. To have been raised by Teregus'
	db	', keeper of the altars. To have left town because of the ten'
	db	'sion between the altar worshippers and The Fellowship. To ha'
	db	've been angry and distrustful of The Fellowship. To have new'
	db	's of him?"'
	db	00
L087C:	db	'"To be excellent! To have seen him? To know how he is faring'
	db	'? To be well?"'
	db	00
L08C7:	db	'well'
	db	00
L08CC:	db	'not well'
	db	00
L08D5:	db	'murdered'
	db	00
L08DE:	db	'"Ah. To be too bad. To tell you Teregus wanted to know how h'
	db	'e was doing."'
	db	00
L0928:	db	'well'
	db	00
L092D:	db	'"To be very good. To know Teregus will be pleased to learn t'
	db	'hat, as well!"'
	db	00
L0978:	db	'murdered'
	db	00
L0981:	db	'"To be terrible news! To have been such a fine gargoyle. To '
	db	'know Teregus will be heartbroken. To be wishing not for him '
	db	'to grieve, but to take to him the news immediately. To be be'
	db	'tter to hear it from you."'
	db	00
L0A50:	db	'Moongates'
	db	00
L0A5A:	db	'"Mine own Orb of the Moons exploded recently! To no longer b'
	db	'e able to travel via Moongates. To be strange!"'
	db	00
L0AC6:	db	'Moongates'
	db	00
L0AD0:	db	'not well'
	db	00
L0AD9:	db	'"To be a shame. To be taking the news to Teregus of his youn'
	db	'gling. To be wondering why we had not heard from Inamo recen'
	db	'tly."'
	db	00
L0B57:	db	'Teregus'
	db	00
L0B5F:	db	'"To be truly a fine young gargoyle. To be one of the most se'
	db	'nsible, too. To have seen fit to adhere to the old ways, the'
	db	' ways of the altars. To see that some of the youngest still '
	db	'look up to him, but the majority seem to have been wooed awa'
	db	'y by the glamor of The Fellowship."'
	db	00
L0C73:	db	'"To tell you that his weanling, Inamo, is in Trinsic at this'
	db	' time."'
	db	00
L0CB7:	db	'Inamo'
	db	00
L0CBD:	db	'Teregus'
	db	00
L0CC5:	db	'Fellowship'
	db	00
L0CD0:	db	'"To know not what to think of them and their tenets. To seem'
	db	' not dangerous, but not to be following the old ways, the wa'
	db	'ys of Passion, Diligence, and Control. To feign worship to t'
	db	'he shrines here in Terfin, of course, especially to Control,'
	db	' but not yet to trust them. To wait and see. To have forcefu'
	db	'l leaders who espouse doctrines of submission." He shrugs.~~'
	db	'"To be genuinely inspired, perhaps, and perhaps not."'
	db	00
L0E6E:	db	'leaders'
	db	00
L0E76:	db	'Terfin'
	db	00
L0E7D:	db	'Fellowship'
	db	00
L0E88:	db	'leaders'
	db	00
L0E90:	db	'"To inform you that The Fellowship is directed by two winged'
	db	' brethren. To be called Runeb and Quan."'
	db	00
L0EF5:	db	'Quan'
	db	00
L0EFA:	db	'Runeb'
	db	00
L0F00:	db	'leaders'
	db	00
L0F08:	db	'Runeb'
	db	00
L0F0E:	db	'"To mean, in your language, `Red Mist\'. To have been given '
	db	'that name because that is all he leaves behind of an adversa'
	db	'ry in battle. Before his conversion by The Fellowship, to ha'
	db	've been known as a particularly cruel and dangerous gargoyle'
	db	'."'
	db	00
L1000:	db	'"To be gone -- dead -- now."'
	db	00
L101D:	db	'Runeb'
	db	00
L1023:	db	'Quan'
	db	00
L1028:	db	'"Ah, to be an interesting one. To be a strong, powerful pers'
	db	'onality, to be from one of the families most able to claim n'
	db	'oble lineage in our society. To have been always most self-s'
	db	'erving, striving only to gain status and wealth for himself.'
	db	' To have certainly changed his tune since joining The Fellow'
	db	'ship. To have my doubts, however, that his goals have change'
	db	'd as well."'
	db	00
L119C:	db	'Quan'
	db	00
L11A1:	db	'bye'
	db	00
L11A5:	db	'"To bid farewell, old friend. To not be hesitating to return'
	db	' if there is aught else I can do for you. To be lonely here '
	db	'now for an old gargoyle dedicated to the ancient ways..."*'
	db	00
