L0000:	db	'"I am qualified to heal, cure poison, and resurrect. Art tho'
	db	'u interested in one of these services?"'
	db	00
L0064:	db	'"Which of my services dost thou have need of?"'
	db	00
L0093:	db	'resurrect'
	db	00
L009D:	db	'cure poison'
	db	00
L00A9:	db	'heal'
	db	00
L00AE:	db	'heal'
	db	00
L00B3:	db	'cure poison'
	db	00
L00BF:	db	'heal'
	db	00
L00C4:	db	'healed'
	db	00
L00CB:	db	'cure poison'
	db	00
L00D7:	db	'cured of poison'
	db	00
L00E7:	db	'"Who dost thou wish to have '
	db	00
L0104:	db	'?"'
	db	00
L0107:	db	'"Excellent, thou art uninjured!"'
	db	00
L0128:	db	'resurrect'
	db	00
L0132:	db	'"There seems to be no one who needs such assistance. Perhaps'
	db	', if I have overlooked anyone, thou couldst set him or her b'
	db	'efore me."*'
	db	00
L01B6:	db	'"Indeed, this individual needs restoration!"'
	db	00
L01E3:	db	'"My price is '
	db	00
L01F1:	db	' gold. Art thou interested?"'
	db	00
L020E:	db	'heal'
	db	00
L0213:	db	'cure poison'
	db	00
L021F:	db	'resurrect'
	db	00
L0229:	db	'"Thou dost not have enough gold! Mayhaps thou couldst return'
	db	' when thou hast more."'
	db	00
L027C:	db	'"Then thou must go elsewhere."'
	db	00
L029B:	db	'"If thou needest my services later, I will be here."'
	db	00
