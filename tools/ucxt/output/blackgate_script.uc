	db	00
L0001:	db	'@Welcome, Avatar.@'
	db	00
L0014:	db	'Perhaps thou shouldst use the crystal ball.'
	db	00
L0040:	db	'Are we there yet?'
	db	00
L0052:	db	'I could use a drink.'
	db	00
L0067:	db	'I am too old for this.'
	db	00
L007E:	db	'I heard something!'
	db	00
L0091:	db	'Oh no! Not more rain!'
	db	00
L00A7:	db	'We could use swamp boots!'
	db	00
L00C1:	db	'When can we rest?'
	db	00
L00D3:	db	'This is Dungeon Destard.'
	db	00
L00EC:	db	'This is Dungeon Despise.'
	db	00
L0105:	db	'This is Dungeon Deceit.'
	db	00
L011D:	db	'This is Bee Cave.'
	db	00
L012F:	db	'This is the Minoc Mine.'
	db	00
L0147:	db	'This is the Vesper Mine.'
	db	00
L0160:	db	'This looks interesting.'
	db	00
L0178:	db	'This place is creepy.'
	db	00
L018E:	db	'Wow...!'
	db	00
L0196:	db	'Let\'s sing a sea shanty!'
	db	00
L01AF:	db	'Let us win some gold!'
	db	00
L01C5:	db	'Avatar, they are doing a play about thee!'
	db	00
L01EF:	db	'Britain sure is big!'
	db	00
L0204:	db	'Be most careful. Who knows what may be lurking amongst the t'
	db	'rees...'
	db	00
L0248:	db	'Brushed up on thy Gargish?'
	db	00
L0263:	db	'Real fighters live here!'
	db	00
L027C:	db	'Thy old relics are here!'
	db	00
L0295:	db	'That bread smells good...'
	db	00
L02AF:	db	'That food smells good...'
	db	00
L02C8:	db	'That fruit looks good...'
	db	00
L02E1:	db	'I am getting sleepy...'
	db	00
L02F8:	db	'The Shrine of Compassion!'
	db	00
L0312:	db	'The Shrine of Honesty!'
	db	00
L0329:	db	'The Shrine of Justice!'
	db	00
L0340:	db	'The Shrine of Spirituality!'
	db	00
L035C:	db	'The Shrine of Honor!'
	db	00
L0371:	db	'The Shrine of Valor!'
	db	00
L0386:	db	'The Shrine of Sacrifice!'
	db	00
L039F:	db	'The Shrine of Humility!'
	db	00
L03B7:	db	'Watch for bridge trolls.'
	db	00
L03D0:	db	'Ah, home sweet home.'
	db	00
L03E5:	db	'The noise! Agh! It hurts!'
	db	00
L03FF:	db	'You left the small sphere!'
	db	00
L041A:	db	'You left the small cube!'
	db	00
L0433:	db	'You left the small tetrahedron!'
	db	00
