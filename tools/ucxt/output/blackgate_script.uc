L028B:	db	'"Very well, then!"'
	db	00
L029E:	db	'Nastassia'
	db	00
L02A8:	db	'"Oh. I thought thou wert curious. Never mind then."'
	db	00
L02DC:	db	'Nastassia'
	db	00
L02E6:	db	'Zinaida'
