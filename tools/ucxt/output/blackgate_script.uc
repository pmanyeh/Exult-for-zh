	; Function at file offset 0015B46BH
	.funcnumber  08B2H
	.data
	.msize       0394H
	.dsize       0300H
L0000:	db	'Horance looks at you curiously, "Thy task is done here in Sk'
	db	'ara Brae. Thou hast my respect and lifelong gratitude."'
	db	00
L0074:	db	'But...," he hesitates here as if unsure how to proceed, "...'
	db	'shouldst thou not return to the quest which brought thee her'
	db	'e?"'
	db	00
L00F0:	db	'quest'
	db	00
L00F6:	db	'bye'
	db	00
L00FA:	db	'Skara Brae'
	db	00
L0105:	db	'quest'
	db	00
L010B:	db	'"Why, yes. I sense that the spirit of Caine has not left the'
	db	' island yet. Is he not waiting for thy return?"'
	db	00
L0177:	db	'"Thou wert brought to Britannia for a reason, I surmise. If '
	db	'thou dost not know what it is, shouldst thou not seek it out'
	db	'?"'
	db	00
L01F2:	db	'quest'
	db	00
L01F8:	db	'Skara Brae'
	db	00
L0203:	db	'"I intend to restore this town and furthermore, make it a pl'
	db	'ace of beauty and renown. I enjoin thee to return in future '
	db	'times to see if my boast doth come to pass."'
	db	00
L02A8:	db	'Skara Brae'
	db	00
L02B3:	db	'bye'
	db	00
L02B7:	db	'"Goodbye, '
	db	00
L02C2:	db	'. I hope that thou farest well in thy quest." He turns away.'
	db	'*'
	db	00
