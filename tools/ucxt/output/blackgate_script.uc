	; Function at file offset 00113EA3H
	.funcnumber  04FCH
	.data
	.msize       0841H
	.dsize       0669H
L0000:	db	'bye'
	db	00
L0004:	db	'job'
	db	00
L0008:	db	'name'
	db	00
L000D:	db	'You see a rather reserved-looking gargoyle.'
	db	00
L0039:	db	'Kallibrus smiles and greets you with a nod.'
	db	00
L0065:	db	'name'
	db	00
L006A:	db	'"To be known as Kallibrus."'
	db	00
L0086:	db	'name'
	db	00
L008B:	db	'Kallibrus'
	db	00
L0095:	db	'Kallibrus'
	db	00
L009F:	db	'"To be not my true name. To have been given this name by Cai'
	db	'rbre, who could not pronounce my Gargish name."'
	db	00
L010B:	db	'Kallibrus'
	db	00
L0115:	db	'Cairbre'
	db	00
L011D:	db	'job'
	db	00
L0121:	db	'"To work as a warrior for hire most of the time. To be betwe'
	db	'en jobs now. To help friend Cosmo find unicorn."'
	db	00
L018E:	db	'job'
	db	00
L0192:	db	'unicorn'
	db	00
L019A:	db	'Cosmo'
	db	00
L01A0:	db	'Cairbre'
	db	00
L01A8:	db	'"To have been partners for many, many years. To have been bo'
	db	'nded for even longer!"'
	db	00
L01FB:	db	'*'
	db	00
L01FD:	db	'"He, uh, means by bonded, that we are very good friends." He'
	db	' turns to the gargoyle.~~"I told thee to be careful how thou'
	db	' dost phrase things. Thou couldst start many false rumors if'
	db	' thou wert not more specific."~~The gargoyle nods sheepishly'
	db	'.*'
	db	00
L02F0:	db	'Cairbre'
	db	00
L02F8:	db	'Cosmo'
	db	00
L02FE:	db	'"To have known him for many years, but not as long as Cairbr'
	db	'e. To be good friend."'
	db	00
L0351:	db	'Cosmo'
	db	00
L0357:	db	'Cairbre'
	db	00
L035F:	db	'unicorn'
	db	00
L0367:	db	'"To be unsure but to think it has something to do with a wom'
	db	'an and, to say how... sex?"'
	db	00
L03BF:	db	'unicorn'
	db	00
L03C7:	db	'sex'
	db	00
L03CB:	db	'woman'
	db	00
L03D1:	db	'sex'
	db	00
L03D5:	db	'"To know nothing about this word. To mean something similar '
	db	'to reproduce?"'
	db	00
L0420:	db	'"To tell you gargoyles reproduce differently than humans see'
	db	'm to, but to explain too poorly to be useful."'
	db	00
L048B:	db	'"To be quite confused." He shrugs.'
	db	00
L04AE:	db	'sex'
	db	00
L04B2:	db	'woman'
	db	00
L04B8:	db	'"To be related to difference in genders, I know, but to see '
	db	'no such thing in gargoyles. To believe there is a certain hu'
	db	'man... woman... who sent him here.~~"To have heard Cosmo say'
	db	', `love,\' but Cairbre claims there is no such thing. To com'
	db	'prehend not, but to help friends anyway."'
	db	00
L05D1:	db	'*'
	db	00
L05D3:	db	'"That is what I like about him, '
	db	00
L05F4:	db	', loyal to the end!" he says, patting the gargoyle on the sh'
	db	'oulder.*'
	db	00
L0639:	db	'woman'
	db	00
L063F:	db	'bye'
	db	00
L0643:	db	'"To say `til next time, '
	db	00
L065C:	db	'," he says.*'
	db	00
