	; Function at file offset 00089985H
	.funcnumber  046AH
	.data
	.msize       097DH
	.dsize       07D9H
L0000:	db	'bye'
	db	00
L0004:	db	'job'
	db	00
L0008:	db	'name'
	db	00
L000D:	db	'You see an unkempt, yet dapper man talking to himself.'
	db	00
L0044:	db	'"Eh, wot\'s that? Oh, it\'s you, '
	db	00
L0064:	db	'."'
	db	00
L0067:	db	'name'
	db	00
L006C:	db	'"M\'name\'s Tiery, '
	db	00
L007E:	db	'."'
	db	00
L0081:	db	'name'
	db	00
L0086:	db	'job'
	db	00
L008A:	db	'"Eh, \'ow\'s that? Oh, m\'job. Why, Oi take good care o\' me'
	db	' buddies in the graveyard \'ere in Empath Abbey, Oi do."'
	db	00
L00FA:	db	'buddies'
	db	00
L0102:	db	'Empath Abbey'
	db	00
L010F:	db	'Empath Abbey'
	db	00
L011C:	db	'"What do ye mean did Oi \'umpeth Abby. \'Course Oi didn\'t. '
	db	'Oi never went anywhere near Abby. \'Oo told ye that?"'
	db	00
L018A:	db	'\'Umpeth Abby'
	db	00
L0197:	db	'Empath Abbey'
	db	00
L01A4:	db	'\'Umpeth Abby'
	db	00
L01B1:	db	'"Empath Abbey? Why, this \'ere\'s Empath Abbey, '
	db	00
L01E0:	db	'. Oi don\'t mean to pry, but if ye knowest not where ye be, '
	db	'why \'ave ye come \'ere?" He shakes his head. "It\'s just as'
	db	' Oi was tellin\' Darek the other day, `If ye never want to b'
	db	'e lost,\' Oi said, `don\'t ever go nowheres.\'"'
	db	00
L02BC:	db	'\'Umpeth Abby'
	db	00
L02C9:	db	'buddies'
	db	00
L02D1:	db	'"What wrong with the bodies? Oi don\' do nothing more than b'
	db	'ury \'em! A fellow could get in lots o\' trouble spreading r'
	db	'umors like that."'
	db	00
L0358:	db	'bodies'
	db	00
L035F:	db	'bury'
	db	00
L0364:	db	'buddies'
	db	00
L036C:	db	'bury'
	db	00
L0371:	db	'"Barry? Oh, \'im. Oi don\'t know what ye\'s talkin\' about. '
	db	'Oi never met Barry\'s woife! \'Twas just a lie they\'s sprea'
	db	'din\' about me."'
	db	00
L03F2:	db	'bury'
	db	00
L03F7:	db	'Barry'
	db	00
L03FD:	db	'Barry'
	db	00
L0403:	db	'"Oi already told ye that\'s m\'job."'
	db	00
L0426:	db	'Barry'
	db	00
L042C:	db	'bodies'
	db	00
L0433:	db	'"That\'s right. M\'buddies! Oi bury \'em. It\'s m\'job." He '
	db	'squints at you. "Unless, '
	db	00
L0484:	db	', yer askin\' about the people \'ere?"'
	db	00
L04A9:	db	'people'
	db	00
L04B0:	db	'bodies'
	db	00
L04B7:	db	'people'
	db	00
L04BE:	db	'"No! Of course Oi don\'t use peep holes. What sort o\' quest'
	db	'ion is that to ask a fellow, '
	db	00
L0516:	db	'?"'
	db	00
L0519:	db	'peep hole'
	db	00
L0523:	db	'people'
	db	00
L052A:	db	'peep hole'
	db	00
L0534:	db	'"Well, Oi only know a few people \'ere, but Oi\'ll try an\' '
	db	'\'elp as best as Oi am able. \'Oo do ye want to know about? '
	db	'My two best friends are Garth an\' Darek, but Oi often talk '
	db	'to Nina an\' Bart when Oi get the chance.~~'
	db	00
L060D:	db	'"Recently, that Perrin fellow from across the way \'as been '
	db	'spendin\' some toime with me. \'E\'s a real nice chap. A l'
	db	'\'ttle brainy, perhaps, '
	db	00
L0697:	db	', but Oi like \'im just the same. Anyone else ye\'d like to '
	db	'know about?"'
	db	00
L06DE:	db	'"Well, that Perrin fellow\'d be a better one to ask than Oi'
	db	'\'d be, '
	db	00
L0720:	db	'. \'E knows a lot, that one does."'
	db	00
L0742:	db	'"All right then, glad Oi could introduce ye to a few o\' my '
	db	'friends."'
	db	00
L0787:	db	'peep hole'
	db	00
L0791:	db	'bye'
	db	00
L0795:	db	'"G\'day, '
	db	00
L079E:	db	'. \'Ave a pleasant journey. Oi\'ll tell Malc \'allo for ye."'
	db	'*'
	db	00
