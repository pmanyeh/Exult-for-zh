	; Function at file offset 000D109CH
	.funcnumber  04AFH
	.data
	.msize       0F28H
	.dsize       0B4AH
L0000:	db	'bye'
	db	00
L0004:	db	'job'
	db	00
L0008:	db	'name'
	db	00
L000D:	db	'thief'
	db	00
L0013:	db	'You see a beggar. You cannot tell from the look on his face '
	db	'whether he is about to laugh or cry.'
	db	00
L0074:	db	'"Beg thy pardon, '
	db	00
L0086:	db	'," Fenn says.'
	db	00
L0094:	db	'name'
	db	00
L0099:	db	'"My name is Fenn, '
	db	00
L00AC:	db	'."'
	db	00
L00AF:	db	'name'
	db	00
L00B4:	db	'thief'
	db	00
L00BA:	db	'After you tell him about finding the venom vial, he says, "T'
	db	'hou didst our town a service when thou didst uncover that no'
	db	' good brat Garritt as the thief! Perhaps now some people wil'
	db	'l start to realize the hypocrisy of the Fellowship!"'
	db	00
L01A3:	db	'"I know that boy Tobias is innocent of any wrong doing, no m'
	db	'atter what Feridwyn and his Fellowship says."'
	db	00
L020D:	db	'"Be wary for there is a thief in this town! Some silver serp'
	db	'ent venom was stolen from the merchant Morfin, who runs the '
	db	'slaughterhouse."'
	db	00
L0296:	db	'thief'
	db	00
L029C:	db	'job'
	db	00
L02A0:	db	'He looks away from you shamefully. "I have none, '
	db	00
L02D2:	db	'."'
	db	00
L02D5:	db	'none'
	db	00
L02DA:	db	'none'
	db	00
L02DF:	db	'"I used to be a farmer in more prosperous times. I used to w'
	db	'ork with Komor and Merrick."'
	db	00
L0338:	db	'give'
	db	00
L033D:	db	'Merrick'
	db	00
L0345:	db	'Komor'
	db	00
L034B:	db	'none'
	db	00
L0350:	db	'Komor'
	db	00
L0356:	db	'"He is my best friend and the bravest man I know."'
	db	00
L0389:	db	'*'
	db	00
L038B:	db	'"Oh, please! Thou art making mine eyes leak!"*'
	db	00
L03BA:	db	'Komor'
	db	00
L03C0:	db	'Merrick'
	db	00
L03C8:	db	'"Merrick joined The Fellowship so he could live in their she'
	db	'lter, the poor sod."'
	db	00
L0419:	db	'Fellowship'
	db	00
L0424:	db	'shelter'
	db	00
L042C:	db	'Merrick'
	db	00
L0434:	db	'Fellowship'
	db	00
L043F:	db	'"If The Fellowship truly wants to help people, why would the'
	db	'y let us starve just because we do not want to join? They ca'
	db	'nnot answer that one!"'
	db	00
L04CE:	db	'starve'
	db	00
L04D5:	db	'Fellowship'
	db	00
L04E0:	db	'shelter'
	db	00
L04E8:	db	'"Hmf! If thou art so unfortunate as to want to live there, t'
	db	'hou wouldst do better on the corner with Komor and I."'
	db	00
L055B:	db	'shelter'
	db	00
L0563:	db	'corner'
	db	00
L056A:	db	'corner'
	db	00
L0571:	db	'"Even when pockets are light, there is still some mercy left'
	db	' in this world. Begging for money is not a proud profession,'
	db	' but there are worse ones."'
	db	00
L0605:	db	'worse'
	db	00
L060B:	db	'corner'
	db	00
L0612:	db	'worse'
	db	00
L0618:	db	'"At least we do not have to do what Merrick does. He recruit'
	db	's for The Fellowship."'
	db	00
L066B:	db	'worse'
	db	00
L0671:	db	'starve'
	db	00
L0678:	db	'"Do not worry. We shall not starve. Camille sends her son To'
	db	'bias with food and clothing for us every so often."'
	db	00
L06E8:	db	'Tobias'
	db	00
L06EF:	db	'Camille'
	db	00
L06F7:	db	'starve'
	db	00
L06FE:	db	'Camille'
	db	00
L0706:	db	'"Camille is a good woman. She lives at the farm bordering th'
	db	'e dairy."'
	db	00
L074C:	db	'Camille'
	db	00
L0754:	db	'Tobias'
	db	00
L075B:	db	'"He is a fine lad, always willing to give us a hand. Unlike '
	db	'that rude urchin, Garritt."'
	db	00
L07B3:	db	'venom'
	db	00
L07B9:	db	'Garritt'
	db	00
L07C1:	db	'Tobias'
	db	00
L07C8:	db	'venom'
	db	00
L07CE:	db	'"Tobias would not become involved with that sort of affair. '
	db	'I know for certain he is no thief."'
	db	00
L082E:	db	'venom'
	db	00
L0834:	db	'involved'
	db	00
L083D:	db	'involved'
	db	00
L0846:	db	'"If thou art seeking out this venom thief, thou wouldst do w'
	db	'ell to ask Andrew about it."'
	db	00
L089F:	db	'Andrew'
	db	00
L08A6:	db	'involved'
	db	00
L08AF:	db	'Andrew'
	db	00
L08B6:	db	'"Andrew owns the dairy and lives across from Camille\'s farm'
	db	' and the slaughterhouse. He might have seen something."'
	db	00
L0929:	db	'Andrew'
	db	00
L0930:	db	'Garritt'
	db	00
L0938:	db	'"He is the son of Feridwyn and Brita, who run the shelter. G'
	db	'arritt crosses the road to avoid us."'
	db	00
L099A:	db	'*'
	db	00
L099C:	db	'"We would not want the likes of him walking down our side of'
	db	' the road anyway!"*'
	db	00
L09EC:	db	'Garritt'
	db	00
L09F4:	db	'give'
	db	00
L09F9:	db	'"Wilt thou give me a bit of money?"'
	db	00
L0A1D:	db	'How much?'
	db	00
L0A27:	db	'5'
	db	00
L0A29:	db	'4'
	db	00
L0A2B:	db	'3'
	db	00
L0A2D:	db	'2'
	db	00
L0A2F:	db	'1'
	db	00
L0A31:	db	'O'
	db	00
L0A33:	db	'0'
	db	00
L0A35:	db	'"Thank thee, '
	db	00
L0A43:	db	'."'
	db	00
L0A46:	db	'"It appears thou dost not have any money either!"'
	db	00
L0A78:	db	'"I am truly sorry if I have bothered thee, '
	db	00
L0AA4:	db	'."'
	db	00
L0AA7:	db	'Fenn hangs his head low.'
	db	00
L0AC0:	db	'give'
	db	00
L0AC5:	db	'bye'
	db	00
L0AC9:	db	'"Good fortune to ye, '
	db	00
L0ADF:	db	'."*'
	db	00
L0AE3:	db	'@A coin for some food?@'
	db	00
L0AFB:	db	'@Please aid a poor beggar!@'
	db	00
L0B17:	db	'@Show some generosity!@'
	db	00
L0B2F:	db	'@Help one less fortunate!@'
	db	00
