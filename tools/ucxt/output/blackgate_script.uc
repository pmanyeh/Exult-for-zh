	; Function at file offset 0015C234H
	.funcnumber  08B6H
	.data
	.msize       05D0H
	.dsize       0495H
L0000:	db	'"Ah! But thou hast not the practical experience to train wit'
	db	'h me at this time! Go and experience life and return later."'
	db	00
L0079:	db	'You gather your gold and count it, finding that you have '
	db	00
L00B3:	db	' gold altogether.'
	db	00
L00C5:	db	'"Hmm. Thou art a little short on gold. Perhaps thou couldst '
	db	'visit the House of Games, win some booty, then return!"'
	db	00
L0139:	db	'"Thou art already as talented as I! Thou hast no need of my '
	db	'services!"'
	db	00
L0180:	db	'You pay '
	db	00
L0189:	db	' gold, and the training session begins.'
	db	00
L01B1:	db	'Lucky produces a deck of cards, three sea shells and a rock,'
	db	' and a pair of dice. In turn, the pirate takes each item and'
	db	' begins to show various methods of utilizing them. He shows '
	db	'how to deal cards from the bottom of the deck, and how to do'
	db	' a false shuffle. With the shells and rock, he shows lightni'
	db	'ng-fast maneuvers which hide the rock under one of the shell'
	db	's, the one it couldn\'t possibly be under. Finally, he shows'
	db	' how to use saliva to weight the dice so that they always tu'
	db	'rn up lucky.'
	db	00
L039D:	db	'happily hands you back your Ankh, which had '
	db	00
L03CA:	db	'managed to slip from around your neck during '
	db	00
L03F8:	db	'the session.'
	db	00
L0405:	db	'happily holds out his hand to shake yours, '
	db	00
L0431:	db	'but pulls it away quickly when you proceed '
	db	00
L045D:	db	'to do so.'
	db	00
L0467:	db	'When the training session is over, Lucky '
	db	00
	db	00
L0492:	db	' '
	db	00
	db	00
