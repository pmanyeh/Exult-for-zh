	; Function at file offset 0004DC60H
	.funcnumber  0425H
	.data
	.msize       0B46H
	.dsize       0869H
L0000:	db	'Avatar'
	db	00
L0007:	db	'bye'
	db	00
L000B:	db	'job'
	db	00
L000F:	db	'name'
	db	00
L0014:	db	'buy'
	db	00
L0018:	db	'food'
	db	00
L001D:	db	'drink'
	db	00
L0023:	db	'You see an attractive woman in her fifties. She has a warm s'
	db	'mile. "Welcome! Who art thou, stranger?"'
	db	00
L0088:	db	'"Well, hello, '
	db	00
L0097:	db	'."'
	db	00
L009A:	db	'"Whoa! Hey everyone! This here is the Avatar!"'
	db	00
L00C9:	db	'Everyone in the Blue Boar laughs.'
	db	00
L00EB:	db	'"And I\'d bet thou dost need a drink, right?"'
	db	00
L0118:	db	'"Damn! How did she know?"'
	db	00
L0132:	db	'"Oh, really?" she says in mock surprise. "Why, I have always'
	db	' wanted to meet the Avatar!"'
	db	00
L018B:	db	'"What will it be, '
	db	00
L019E:	db	'?" Lucy asks.'
	db	00
L01AC:	db	'"What can I do for thee, '
	db	00
L01C6:	db	'?" Lucy asks.'
	db	00
L01D4:	db	'name'
	db	00
L01D9:	db	'"I\'m Lucy!"'
	db	00
L01E5:	db	'name'
	db	00
L01EA:	db	'job'
	db	00
L01EE:	db	'"I run The Blue Boar. Oldest tavern in Britannia."'
	db	00
L0221:	db	'"If thou dost want anything to eat or drink, just say so!"'
	db	00
L025C:	db	'Blue Boar'
	db	00
L0266:	db	'She addresses Dupre. "How about thou, handsome? Want somethi'
	db	'ng to eat?" She bats her eyelashes.*'
	db	00
L02C7:	db	'"My dear, thou wouldst make any man hungry!"*'
	db	00
L02F5:	db	'"I like thy friends, '
	db	00
L030B:	db	'."'
	db	00
L030E:	db	'"I shall be happy to serve thee something if thou dost come '
	db	'to the pub during open hours!"'
	db	00
L0369:	db	'Blue Boar'
	db	00
L0373:	db	'"Smashing place for a revel! It hath been here for ages! I i'
	db	'nherited it from my grandfather. I enjoy it because I love t'
	db	'o cook. And eat." She laughs. "And drink!" She laughs again.'
	db	'~~"But mostly I like it because I meet so many interesting p'
	db	'eople. Just like thee, '
	db	00
L047B:	db	'!"'
	db	00
L047E:	db	'Blue Boar'
	db	00
L0488:	db	'people'
	db	00
L048F:	db	'revel'
	db	00
L0495:	db	'revel'
	db	00
L049B:	db	'"Thou dost look like the kind of person who doth enjoy a fai'
	db	'r bit of revelry!'
	db	00
L04E9:	db	'"Come back to the pub in the evening to hear our house band,'
	db	' The Avatars!"'
	db	00
L0534:	db	'The Avatars'
	db	00
L0540:	db	'"Our house band The Avatars is performing in the other room!'
	db	'"'
	db	00
L057E:	db	'revel'
	db	00
L0584:	db	'revelry'
	db	00
L058C:	db	'revelry'
	db	00
L0594:	db	'Lucy laughs. "Revelry! Singing! Dancing! Eating! Drinking! A'
	db	'll in a time and place where one may stop and enjoy life! I '
	db	'can see it hath been too long since thou hast sampled the si'
	db	'mple pleasures of life in Britannia!"'
	db	00
L066E:	db	'revelry'
	db	00
L0676:	db	'The Avatars'
	db	00
L0682:	db	'"They are a popular local singing group. I am sure thou wilt'
	db	' like them, '
	db	00
L06CB:	db	'!"'
	db	00
L06CE:	db	'The Avatars'
	db	00
L06DA:	db	'people'
	db	00
L06E1:	db	'"Oh, I so enjoy meeting men who like to go out and \'kill\' '
	db	'things!"'
	db	00
L0724:	db	'people'
	db	00
L072B:	db	'food'
	db	00
L0730:	db	'"Everything I serve is delicious. I highly recommend that th'
	db	'ou tasteth the Silverleaf dish. Worth every gold piece spent'
	db	'!"'
	db	00
L07AB:	db	'food'
	db	00
L07B0:	db	'Silverleaf'
	db	00
L07BB:	db	'drink'
	db	00
L07C1:	db	'"I serve Britain\'s finest ale and wine."'
	db	00
L07EA:	db	'drink'
	db	00
L07F0:	db	'Silverleaf'
	db	00
L07FB:	db	'"It\'s made from the root of a very rare tree. Quite superb,'
	db	' it is!"'
	db	00
L083F:	db	'Silverleaf'
	db	00
L084A:	db	'buy'
	db	00
L084E:	db	'bye'
	db	00
L0852:	db	'"Talk to thee later!"*'
	db	00
