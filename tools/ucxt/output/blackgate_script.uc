	; Function at file offset 000F1BDAH
	.funcnumber  04D7H
	.data
	.msize       0B0FH
	.dsize       08D6H
L0000:	db	'bye'
	db	00
L0004:	db	'job'
	db	00
L0008:	db	'name'
	db	00
L000D:	db	'The winged gargoyle has a very calm air about him. As he fir'
	db	'st sees you, a smile of recognition appears on his face. "To'
	db	' present greetings, Avatar."'
	db	00
L00A2:	db	'"To ask how to help you?"'
	db	00
L00BC:	db	'name'
	db	00
L00C1:	db	'"To be called Ansikart."'
	db	00
L00DA:	db	'Ansikart'
	db	00
L00E3:	db	'name'
	db	00
L00E8:	db	'Ansikart'
	db	00
L00F1:	db	'"To mean `anti-dry-master.\'"'
	db	00
L010E:	db	'Ansikart'
	db	00
L0117:	db	'job'
	db	00
L011B:	db	'"To serve food and drink to others."'
	db	00
L0140:	db	'others'
	db	00
L0147:	db	'buy'
	db	00
L014B:	db	'buy'
	db	00
L014F:	db	'"To apologize, but to ask you to return when I am open."'
	db	00
L0188:	db	'others'
	db	00
L018F:	db	'"To know all the gargoyles in Vesper. To want to know about '
	db	'specific ones?"'
	db	00
L01DB:	db	'"To want information, perhaps, about the provisioner or the '
	db	'sage?'
	db	00
L021D:	db	'provisioner'
	db	00
L0229:	db	'sage'
	db	00
L022E:	db	'"To warn you that many hold resentment for their poor treatm'
	db	'ent. To be careful, please."'
	db	00
L0287:	db	'Vesper'
	db	00
L028E:	db	'others'
	db	00
L0295:	db	'Vesper'
	db	00
L029C:	db	'"To be a town full of hate -- to have the humans hate us and'
	db	' to know many hate them, especially Anmanivas and Foranamo. '
	db	'To be not a good thing." He appears saddened.'
	db	00
L0342:	db	'Foranamo'
	db	00
L034B:	db	'Anmanivas'
	db	00
L0355:	db	'Vesper'
	db	00
L035C:	db	'sage'
	db	00
L0361:	db	'"To be named Wis-Sur."'
	db	00
L0378:	db	'"To be a great mind, knowledgeable in many things."'
	db	00
L03AC:	db	'"To have once been a great mind. To be now paranoid and recl'
	db	'usive. To feel pity for Wis-Sur."'
	db	00
L040A:	db	'sage'
	db	00
L040F:	db	'provisioner'
	db	00
L041B:	db	'"To be Aurvidlem. To have become sullen lately, but to know '
	db	'not why."'
	db	00
L0461:	db	'provisioner'
	db	00
L046D:	db	'For-Lem'
	db	00
L0475:	db	'"To be a laborer for the town."'
	db	00
L0495:	db	'For-Lem'
	db	00
L049D:	db	'Lap-Lem'
	db	00
L04A5:	db	'"To mine for the Mining company here. To be the only gargoyl'
	db	'e still mining here." He nods his head.~~ "To be very tolera'
	db	'nt, like For-Lem."'
	db	00
L0530:	db	'For-Lem'
	db	00
L0538:	db	'tolerant'
	db	00
L0541:	db	'Lap-Lem'
	db	00
L0549:	db	'tolerant'
	db	00
L0552:	db	'"To work now with only humans, who hate and degrade him. To '
	db	'continue working, however, despite this. To be quite toleran'
	db	't of human intolerance." He nods, as if to emphasize his poi'
	db	'nt.'
	db	00
L060A:	db	'tolerant'
	db	00
L0613:	db	'Anmanivas'
	db	00
L061D:	db	'have been'
	db	00
L0627:	db	'"To have been killed by you in this very tavern. To remember'
	db	' not?~~"To have been his fault, but still, to tell you I fee'
	db	'l remorse for him and his brother."'
	db	00
L06C3:	db	'be'
	db	00
L06C6:	db	'"To have worked the mines with Lap-Lem, but to have left jus'
	db	't recently." He shakes his head.~~"To hate the humans who wo'
	db	'rk there, and who live on the other side of the oasis. To be'
	db	' too violent. To '
	db	00
L078C:	db	' no longer permitted on the other side."'
	db	00
L07B5:	db	'Lap-Lem'
	db	00
L07BD:	db	'Anmanivas'
	db	00
L07C7:	db	'Foranamo'
	db	00
L07D0:	db	'have been'
	db	00
L07DA:	db	'be'
	db	00
L07DD:	db	'"To be brother to Anmanivas and to have been raised by the s'
	db	'ame parent. To hate humans as much as Anmanivas, and," he si'
	db	'ghs, "to '
	db	00
L085F:	db	' allowed no longer to visit the human side."'
	db	00
L088C:	db	'Foranamo'
	db	00
L0895:	db	'bye'
	db	00
L0899:	db	'"To hope you will bring peace again to our people, Avatar."*'
	db	00
