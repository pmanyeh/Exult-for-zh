	; Function at file offset 0016C5FCH
	.funcnumber  08F3H
	.data
	.msize       07F7H
	.dsize       0693H
L0000:	db	'bye'
	db	00
L0004:	db	'valor in arms'
	db	00
L0012:	db	'enchantment'
	db	00
L001E:	db	'"Tell me something, if thou please. Many years have passed s'
	db	'ince I first learned my woodcraft. Such craft includes skill'
	db	' in arms, and I must know... Does the Avatar prefer mystical'
	db	' enchantment to overcome enemies, or physical strength and v'
	db	'alor in arms?"'
	db	00
L011D:	db	'enchantment'
	db	00
L0129:	db	'"I have suspected it! No skill have I in such deep matters, '
	db	'but perchance our speech might turn to enchantment when our '
	db	'quest is complete."'
	db	00
L01B5:	db	'valor in arms'
	db	00
L01C3:	db	'"I have often suspected it! I am honored to travel with thee'
	db	'. I shall watch thee diligently, for surely thou art the gre'
	db	'atest fighter who ever lived."'
	db	00
L025A:	db	'"When our quest is complete we shall regale each other with '
	db	'our exploits. Tell me, dost thou prefer hand to hand combat '
	db	'or ranged weaponry?"'
	db	00
L02E7:	db	'valor in arms'
	db	00
L02F5:	db	'enchantment'
	db	00
L0301:	db	'ranged weaponry'
	db	00
L0311:	db	'hand to hand'
	db	00
L031E:	db	'hand to hand'
	db	00
L032B:	db	'hand to hand'
	db	00
L0338:	db	'and thou seemest man enough for such close work'
	db	00
L0368:	db	'especially in women. The women of Britannia seldom have them'
	db	00
L03A5:	db	'"Such weapons require strength and daring! I admire such qua'
	db	'lities, '
	db	00
L03EA:	db	'."'
	db	00
L03ED:	db	'"But my preferences run to the bow. An ancient weapon, and e'
	db	'legant, a fine bow of Yew may bring down game sooner than a '
	db	'sword."'
	db	00
L046D:	db	'ranged weaponry'
	db	00
L047D:	db	'ranged weaponry'
	db	00
L048D:	db	'"Such is also my choice. Few are my peers in the art of arch'
	db	'ery. A keen eye and steady hand are required, and that is ra'
	db	're in the men of this day. Even rarer in women. Sad, that th'
	db	'e women of Britannia should be innocent of such art!"'
	db	00
L0577:	db	'"Take care with thy words, master woodsman."'
	db	00
L05A4:	db	'"I do not mean this gracious company! Surely thou art among '
	db	'the elite of Britannia and a rare figure of a woman."'
	db	00
L0616:	db	'"Thy speech does me service. Alas! Too few are the women who'
	db	' learn skill in arms."'
	db	00
L0669:	db	'bye'
	db	00
L066D:	db	'"Please, Avatar, I simply must know."'
	db	00
