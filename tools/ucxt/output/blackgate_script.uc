	; Function at file offset 0003396EH
	.funcnumber  0409H
	.data
	.msize       1408H
	.dsize       0FABH
L0000:	db	'bye'
	db	00
L0004:	db	'job'
	db	00
L0008:	db	'name'
	db	00
L000D:	db	'leave'
	db	00
L0013:	db	'Henry'
	db	00
L0019:	db	'locket'
	db	00
L0020:	db	'strangers'
	db	00
L002A:	db	'You see your old companion Katrina looking only slightly old'
	db	'er than when you saw her during your last visit.'
	db	00
L0097:	db	'"Hello again, '
	db	00
L00A6:	db	'!" Katrina greets you with a smile.'
	db	00
L00CA:	db	'name'
	db	00
L00CF:	db	'"Why," she blinks at you, "I know it has been a long time, b'
	db	'ut surely thou cannot have forgotten me. I am Katrina. One o'
	db	'f thine old companions."'
	db	00
L0160:	db	'You share a friendly laugh at your reunion.'
	db	00
L018C:	db	'time'
	db	00
L0191:	db	'old companions'
	db	00
L01A0:	db	'name'
	db	00
L01A5:	db	'old companions'
	db	00
L01B4:	db	'"Ah, yes, Iolo, Shamino, and Dupre."'
	db	00
L01D9:	db	'old companions'
	db	00
L01E8:	db	'Dupre'
	db	00
L01EE:	db	'Shamino'
	db	00
L01F6:	db	'Iolo'
	db	00
L01FB:	db	'time'
	db	00
L0200:	db	'"Although there is a vast difference in how time passes in o'
	db	'ur world and in this one, I am certain I have aged at least '
	db	'a bit," she says pleasantly.'
	db	00
L0295:	db	'time'
	db	00
L029A:	db	'job'
	db	00
L029E:	db	'"Why, after last accompanying thee on thine adventures I set'
	db	'tled down to the peaceful life of a shepherd in New Magincia'
	db	'."'
	db	00
L0319:	db	'New Magincia'
	db	00
L0326:	db	'shepherd'
	db	00
L032F:	db	'"If thou dost have need of me I could join thy party again."'
	db	00
L036C:	db	'join'
	db	00
L0371:	db	'"Following thee around, '
	db	00
L038A:	db	'! I shall never miss New Magincia!"'
	db	00
L03AE:	db	'New Magincia'
	db	00
L03BB:	db	'shepherd'
	db	00
L03C4:	db	'"I watch over my flock, and the townspeople as well, when th'
	db	'ey need me."'
	db	00
L040D:	db	'shepherd'
	db	00
L0416:	db	'join'
	db	00
L041B:	db	'"It would be an honor, '
	db	00
L0433:	db	'!"'
	db	00
L0436:	db	'leave'
	db	00
L043C:	db	'join'
	db	00
L0441:	db	'"I prefer smaller crowds, Avatar. Perhaps later."'
	db	00
L0473:	db	'join'
	db	00
L0478:	db	'leave'
	db	00
L047E:	db	'"Dost thou want me to wait here or shall I go on home?"'
	db	00
L04B6:	db	'go home'
	db	00
L04BE:	db	'wait here'
	db	00
L04C8:	db	'wait here'
	db	00
L04D2:	db	'"I shall be happy to wait here until thou dost return."*'
	db	00
L050B:	db	'"If thou dost think it best, I shall. If thou dost need me a'
	db	'gain thou dost have but to ask."*'
	db	00
L0569:	db	'New Magincia'
	db	00
L0576:	db	'"We are isolated here. We get no news from the world outside'
	db	'. Life is much the same as it was the last time thou didst v'
	db	'isit Britannia two hundred years ago. I have many friends he'
	db	're."'
	db	00
L062F:	db	'isolated'
	db	00
L0638:	db	'New Magincia'
	db	00
L0645:	db	'isolated'
	db	00
L064E:	db	'"That is the way we like it here. Now we have three other st'
	db	'rangers on the island -- besides thee. Of course, thou could'
	db	'st hardly be called a stranger. This is the largest number o'
	db	'f visitors we have had in years.~~"But, never fear, '
	db	00
L0737:	db	', I am seldom lonely."'
	db	00
L074E:	db	'isolated'
	db	00
L0757:	db	'visitors'
	db	00
L0760:	db	'lonely'
	db	00
L0767:	db	'lonely'
	db	00
L076E:	db	'"I have many friends here. When I am lonely, I speak with Al'
	db	'agner the Sage, Russell the shipwright, or Henry the peddler'
	db	'."'
	db	00
L07E9:	db	'lonely'
	db	00
L07F0:	db	'Henry'
	db	00
L07F6:	db	'Russell'
	db	00
L07FE:	db	'Alagner'
	db	00
L0806:	db	'Alagner'
	db	00
L080E:	db	'"He is a wise man who knows many things and tells wonderful '
	db	'stories. Alagner came here to retreat from the outside world'
	db	'. I know not why."'
	db	00
L0899:	db	'Alagner'
	db	00
L08A1:	db	'Russell'
	db	00
L08A9:	db	'"He has a sailor\'s heart, an artist\'s soul and a craftsman'
	db	'\'s hands. He never lived his dream of sailing the world. Hi'
	db	's ships do that for him."'
	db	00
L0938:	db	'Russell'
	db	00
L0940:	db	'Henry'
	db	00
L0946:	db	'"Henry has been a very dear friend for years. He is a simple'
	db	' but good man who does not have an ounce of hate in his hear'
	db	't for anyone. I am so fond of him that I gave him a valuable'
	db	' heirloom."'
	db	00
L0A06:	db	'Henry'
	db	00
L0A0C:	db	'heirloom'
	db	00
L0A15:	db	'heirloom'
	db	00
L0A1E:	db	'locket'
	db	00
L0A25:	db	'"Since he does not have much money, I gave Henry my gold loc'
	db	'ket so he could present it to his sweetheart Constance. I ha'
	db	've not talked to him lately, but I must confess I am worried'
	db	' about him."'
	db	00
L0AE6:	db	'locket'
	db	00
L0AED:	db	'heirloom'
	db	00
L0AF6:	db	'worried'
	db	00
L0AFE:	db	'worried'
	db	00
L0B06:	db	'"Soon after Henry left carrying the locket, I saw the three '
	db	'strangers on the island, wandering off in the same direction'
	db	'."'
	db	00
L0B81:	db	'worried'
	db	00
L0B89:	db	'strangers'
	db	00
L0B93:	db	'visitors'
	db	00
L0B9C:	db	'"The three visitors come from Buccaneer\'s Den. I met them s'
	db	'hortly after their arrival and we spoke briefly. Robin is th'
	db	'e one dressed like a gambler and the other two, Battles and '
	db	'Leavell, appear to be bullies."'
	db	00
L0C6F:	db	'visitors'
	db	00
L0C78:	db	'strangers'
	db	00
L0C82:	db	'Iolo'
	db	00
L0C87:	db	'"Iolo should be in our party adventuring with us."'
	db	00
L0CBA:	db	'"How hast thou been keeping thyself all these years, Iolo?"*'
	db	00
L0CF7:	db	'"The years have not been as kind to me as they obviously hav'
	db	'e been to thee, milady."*'
	db	00
L0D4D:	db	'"Ha! I see thou art still a scallywag, Iolo."*'
	db	00
L0D7C:	db	'Iolo'
	db	00
L0D81:	db	'Shamino'
	db	00
L0D89:	db	'"Shamino should be here with us."'
	db	00
L0DAB:	db	'"Is that a gray hair I see in thine hair, Shamino?"*'
	db	00
L0DE0:	db	'"It is not! Where?"*'
	db	00
L0DF5:	db	'"Perhaps it is but a trick of the light."*'
	db	00
L0E20:	db	'Shamino'
	db	00
L0E28:	db	'Dupre'
	db	00
L0E2E:	db	'"I cannot help but miss Dupre a little. I have not seen him '
	db	'since he was knighted."'
	db	00
L0E82:	db	'"Sir Dupre, hast thou finished thy studies yet?"*'
	db	00
L0EB4:	db	'Dupre looks confounded. "My studies, milady?"*'
	db	00
L0EE3:	db	'"Of all the various drinking establishments in Britannia!"*'
	db	00
L0F1F:	db	'"Oh, yes, of course, my studies! Continuing mine education h'
	db	'as always been of the utmost importance to me."*'
	db	00
L0F8C:	db	'Dupre'
	db	00
L0F92:	db	'bye'
	db	00
L0F96:	db	'"Pleasant days, '
	db	00
L0FA7:	db	'."*'
	db	00
