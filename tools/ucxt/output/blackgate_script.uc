	; Function at file offset 000DC952H
	.funcnumber  04BDH
	.data
	.msize       0FF5H
	.dsize       0C91H
L0000:	db	'bye'
	db	00
L0004:	db	'job'
	db	00
L0008:	db	'name'
	db	00
L000D:	db	'"To greet you, human," the gargoyle says to Dupre. "To ask h'
	db	'ow well the study is progressing?"'
	db	00
L006C:	db	'"Why \'tis progressing nicely, friend Forbrak."'
	db	00
L009B:	db	'"-What- study?"'
	db	00
L00AB:	db	'"Why, er, surely thou hast heard of the famous guides compil'
	db	'ed for Brommer!"'
	db	00
L00F8:	db	'"Aye, I have. But I\'ll be tarred if there is one detailing '
	db	'various drinking establishments!"'
	db	00
L0155:	db	'"Well, yes, er, \'tis, ah, something new. Now, how about a d'
	db	'rink!"'
	db	00
L0197:	db	'"New? \'Tis about as new as my backside...," mutters Shamino'
	db	'.'
	db	00
L01D4:	db	'The gargoyle tending bar lifts a tankard to you.'
	db	00
L0205:	db	'"To ask what brings you to this fine establishment?" asks Fo'
	db	'rbrak.'
	db	00
L0248:	db	'name'
	db	00
L024D:	db	'"To be Forbrak."'
	db	00
L025E:	db	'name'
	db	00
L0263:	db	'Forbrak'
	db	00
L026B:	db	'Forbrak'
	db	00
L0273:	db	'"To mean `strong arm\' in the language of the gargoyles."'
	db	00
L02AC:	db	'Forbrak'
	db	00
L02B4:	db	'gargoyles'
	db	00
L02BE:	db	'job'
	db	00
L02C2:	db	'He gestures around the room with an open hand.~~ "To serve f'
	db	'ood and drink at the Hall of Refreshment."'
	db	00
L0329:	db	'buy'
	db	00
L032D:	db	'buy'
	db	00
L0331:	db	'"To ask you to please come back when my shop is open."'
	db	00
L0368:	db	'gargoyles'
	db	00
L0372:	db	'"To know many of the residents in town, and some of the trou'
	db	'bles."'
	db	00
L03B5:	db	'troubles'
	db	00
L03BE:	db	'residents'
	db	00
L03C8:	db	'gargoyles'
	db	00
L03D2:	db	'troubles'
	db	00
L03DB:	db	'"To know of only two. To see the conflict between the shrine'
	db	's and The Fellowship, and to know of the struggles of the wi'
	db	'ngless ones."'
	db	00
L0461:	db	'wingless vs. winged'
	db	00
L0475:	db	'shrine vs. Fellowship'
	db	00
L048B:	db	'troubles'
	db	00
L0494:	db	'shrine vs. Fellowship'
	db	00
L04AA:	db	'"To believe there are disagreements between the old philosop'
	db	'hy and the new. To expect no violence, but to ask you to see'
	db	'k the trainer and healer. To know they are observant and may'
	db	' have seen something. To also suggest you speak with members'
	db	' of The Fellowship."'
	db	00
L05AF:	db	'shrine vs. Fellowship'
	db	00
L05C5:	db	'trainer'
	db	00
L05CD:	db	'healer'
	db	00
L05D4:	db	'members'
	db	00
L05DC:	db	'members'
	db	00
L05E4:	db	'"To recommend you talk to their leader and their clerk."'
	db	00
L061D:	db	'clerk'
	db	00
L0623:	db	'leader'
	db	00
L062A:	db	'members'
	db	00
L0632:	db	'wingless vs. winged'
	db	00
L0646:	db	'"To watch wingless friends be discontented with their lot. T'
	db	'o wonder why, but to never ask. To talk to the healer and th'
	db	'e trainer. To expect they will have seen evidence if there i'
	db	's evidence to be seen."'
	db	00
L0712:	db	'wingless vs. winged'
	db	00
L0726:	db	'healer'
	db	00
L072D:	db	'trainer'
	db	00
L0735:	db	'residents'
	db	00
L073F:	db	'"To know many gargoyles. To want to know about some of them?'
	db	'"'
	db	00
L077D:	db	'"To be sure you already know our leader. To wonder if you ha'
	db	've met Teregus, or the learning center head.~~"To be more pr'
	db	'actical, you may need the provisioner," he nods his head.'
	db	00
L082F:	db	'provisioner'
	db	00
L083B:	db	'Teregus'
	db	00
L0843:	db	'learning center'
	db	00
L0853:	db	'"To tell you about them later if you wish."'
	db	00
L087F:	db	'residents'
	db	00
L0889:	db	'trainer'
	db	00
L0891:	db	'"To be named Inforlem. To be very strong."'
	db	00
L08BC:	db	'trainer'
	db	00
L08C4:	db	'healer'
	db	00
L08CB:	db	'"To be named Inmanilem."'
	db	00
L08E4:	db	'healer'
	db	00
L08EB:	db	'leader'
	db	00
L08F2:	db	'"To be very friendly. To be called Quan."'
	db	00
L091C:	db	'leader'
	db	00
L0923:	db	'clerk'
	db	00
L0929:	db	'"To be extremely violent." He shakes his head. "To be named '
	db	'Runeb, which means `red mist.\' To be all that he leaves of '
	db	'a foe after combat."'
	db	00
L09B5:	db	'clerk'
	db	00
L09BB:	db	'"To be dead now, though."'
	db	00
L09D5:	db	'learning center'
	db	00
L09E5:	db	'"To be a wonderful place to gain knowledge and exercise. To '
	db	'be managed by a gargoyle name Quaeven. To be very educated, '
	db	'this Quaeven. Also, to be wingless, like Silamo."'
	db	00
L0A8F:	db	'learning center'
	db	00
L0A9F:	db	'Silamo'
	db	00
L0AA6:	db	'provisioner'
	db	00
L0AB2:	db	'"To be called Betra. To be one of two shopkeepers. To say th'
	db	'e other is Sarpling."'
	db	00
L0B04:	db	'provisioner'
	db	00
L0B10:	db	'Sarpling'
	db	00
L0B19:	db	'Teregus'
	db	00
L0B21:	db	'"To be a sage. To be very well-educated, like Quaeven. To li'
	db	've here a long time."'
	db	00
L0B73:	db	'Teregus'
	db	00
L0B7B:	db	'Silamo'
	db	00
L0B82:	db	'"To be the gardener who lives to the east of the mountains."'
	db	00
L0BBF:	db	'Silamo'
	db	00
L0BC6:	db	'Sarpling'
	db	00
L0BCF:	db	'"To know him little, and to have never been in his shop, and'
	db	', therefore, to be unable to tell you what he sells. To know'
	db	' his name means `snake tongue.\'"'
	db	00
L0C68:	db	'Sarpling'
	db	00
L0C71:	db	'bye'
	db	00
L0C75:	db	'"To wish you well, human."*'
	db	00
