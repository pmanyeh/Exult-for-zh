	; Function at file offset 0008F118H
	.funcnumber  0470H
	.data
	.msize       09E5H
	.dsize       07E8H
L0000:	db	'Nystul'
	db	00
L0007:	db	'Geoffrey'
	db	00
L0010:	db	'bye'
	db	00
L0014:	db	'job'
	db	00
L0018:	db	'name'
	db	00
L001D:	db	'You see a rough-looking man with a bitter expression on his '
	db	'face.'
	db	00
L005F:	db	'D\'Rel scowls at you. "What in the blazes do ye want?"'
	db	00
L0095:	db	'name'
	db	00
L009A:	db	'"What do ye care about the name of a wretch?"'
	db	00
L00C8:	db	'care'
	db	00
L00CD:	db	'wretch'
	db	00
L00D4:	db	'name'
	db	00
L00D9:	db	'wretch'
	db	00
L00E0:	db	'"They\'ve put me in here to rot, they have!"'
	db	00
L010C:	db	'wretch'
	db	00
L0113:	db	'rot'
	db	00
L0117:	db	'they'
	db	00
L011C:	db	'they'
	db	00
L0121:	db	'"The Britannian Tax Council done it. They and the two here -'
	db	'- Sir Jeff and Goth."'
	db	00
L0173:	db	'they'
	db	00
L0178:	db	'Goth'
	db	00
L017D:	db	'Sir Jeff'
	db	00
L0186:	db	'Britannian Tax Council'
	db	00
L019D:	db	'rot'
	db	00
L01A1:	db	'"They told me I\'d be here for the rest of my life. I have n'
	db	'o reason to doubt them either!"'
	db	00
L01FC:	db	'rot'
	db	00
L0200:	db	'Sir Jeff'
	db	00
L0209:	db	'"That stuffed cock believes he\'s above everyone in Britanni'
	db	'a. Just because he presides over the High Court he thinks he'
	db	' can pass judgement over any and everyone."'
	db	00
L02AC:	db	'Sir Jeff'
	db	00
L02B5:	db	'Goth'
	db	00
L02BA:	db	'"That thieving scoundrel belongs in here more than I do! Don'
	db	'\'t trust him if ye\'ve gotta choice."'
	db	00
L031B:	db	'Goth'
	db	00
L0320:	db	'Britannian Tax Council'
	db	00
L0337:	db	'"Thieves, the whole lot of \'em! Tryin\' to take a person\'s'
	db	' hard-earned gold. Mayhaps they wouldn\'t need to take all o'
	db	'f our money if they would go out and earn their own!"'
	db	00
L03E1:	db	'Britannian Tax Council'
	db	00
L03F8:	db	'care'
	db	00
L03FD:	db	'"Ye care, do ye? All right, then. I\'ll tell ye my name if y'
	db	'e tell me thine, deal?"'
	db	00
L0450:	db	'"'
	db	00
L0452:	db	', eh. Very well, a deal\'s a deal. I\'m D\'Rel."'
	db	00
L0480:	db	'"I thought as much."'
	db	00
L0495:	db	'care'
	db	00
L049A:	db	'job'
	db	00
L049E:	db	'"None now. But \'til I made this mine home, I was a sailor, '
	db	'a... privateer, out of Buccaneer\'s Den."'
	db	00
L0502:	db	'Buccaneer\'s Den'
	db	00
L0512:	db	'thine home'
	db	00
L051D:	db	'thine home'
	db	00
L0528:	db	'"Well, actually I am in here for not paying my taxes. After '
	db	'all, I... earned the money, why should I give it to the Brit'
	db	'annian Tax Council?"'
	db	00
L05B5:	db	'thine home'
	db	00
L05C0:	db	'Britannian Tax Council'
	db	00
L05D7:	db	'Buccaneer\'s Den'
	db	00
L05E7:	db	'"Thou hast heard of Buccaneer\'s Den, hast thou not? \'Tis t'
	db	'he island due east of the mainland. Home of the sort of men '
	db	'who walk with peg-legs, have hooks for hands, and carry parr'
	db	'ots on their shoulders! Har! Har!"'
	db	00
L06BC:	db	'Buccaneer\'s Den'
	db	00
L06CC:	db	'Hook'
	db	00
L06D1:	db	'Hook'
	db	00
L06D6:	db	'"Yeah, I know Hook. Lookin\' for him, are ye? He be from Buc'
	db	'caneer\'s Den. He usually travels with some gargoyle named F'
	db	'orskis or something like that. If ye see him, give him my...'
	db	' hello, for me." He gestures to his clenched fist.'
	db	00
L07BB:	db	'Hook'
	db	00
L07C0:	db	'bye'
	db	00
L07C4:	db	'"Aye, get thy face from my sight!"*'
	db	00
