	; Function at file offset 000BFB42H
	.funcnumber  049DH
	.data
	.msize       0C33H
	.dsize       0A26H
L0000:	db	'bye'
	db	00
L0004:	db	'Fellowship'
	db	00
L000F:	db	'job'
	db	00
L0013:	db	'name'
	db	00
L0018:	db	'"Get thee away! I\'ll hear no more of thy lies!"*'
	db	00
L0049:	db	'"I am trying to pay attention!" he says, glaring at you.'
	db	00
L0082:	db	'"Sorry, '
	db	00
L008B:	db	', I cannot talk now. I must get to the Fellowship meeting!"'
	db	00
L00C7:	db	'You see a friendly-looking farmer.'
	db	00
L00EA:	db	'"Good day, '
	db	00
L00F6:	db	'."'
	db	00
L00F9:	db	'reconvert'
	db	00
L0103:	db	'name'
	db	00
L0108:	db	'"I am called Tolemac, '
	db	00
L011F:	db	'."'
	db	00
L0122:	db	'name'
	db	00
L0127:	db	'reconvert'
	db	00
L0131:	db	'job'
	db	00
L0135:	db	'"I help my brother tend our farm here in Moonglow."'
	db	00
L0169:	db	'Moonglow'
	db	00
L0172:	db	'brother'
	db	00
L017A:	db	'brother'
	db	00
L0182:	db	'"My brother is Cubolt." He frowns for a moment. "He can be a'
	db	' bit overbearing at times, trying to `take care\' of me. But'
	db	'," he shrugs, "he means well, perhaps. I know I\'ve caused h'
	db	'im a bit of trouble every now and then," he says with a grin'
	db	', "but he deserves it."'
	db	00
L0288:	db	'brother'
	db	00
L0290:	db	'Moonglow'
	db	00
L0299:	db	'"Yes, '
	db	00
L02A0:	db	'. That is the name of the town thou art in. Dost thou have q'
	db	'uestions about the townspeople?"'
	db	00
L02FD:	db	'townspeople'
	db	00
L0309:	db	'Moonglow'
	db	00
L0312:	db	'townspeople'
	db	00
L031E:	db	'"I know only a few people here, '
	db	00
L033F:	db	'. My brother, Cubolt, runs the farm with me. Morz helps us, '
	db	'too -- we\'ve known him for many years. And now that I\'ve j'
	db	'oined The Fellowship, I\'ve met a few more people. Rankin is'
	db	' branch head here in Moonglow, and Balayna is his assistant.'
	db	' If thou dost want to know about other people, thou mayest w'
	db	'ant to ask the bartender. His name is Phearcy."'
	db	00
L0498:	db	'Fellowship'
	db	00
L04A3:	db	'Rankin'
	db	00
L04AA:	db	'Balayna'
	db	00
L04B2:	db	'Morz'
	db	00
L04B7:	db	'townspeople'
	db	00
L04C3:	db	'Rankin'
	db	00
L04CA:	db	'"Rankin is very intelligent. He is the one who persuaded me '
	db	'to join The Fellowship. I have much respect for him."'
	db	00
L053C:	db	'Rankin'
	db	00
L0543:	db	'Balayna'
	db	00
L054B:	db	'"She is the branch clerk. Most of the time, she is friendly.'
	db	' Sometimes, however, she seems a little cold."'
	db	00
L05B6:	db	'Balayna'
	db	00
L05BE:	db	'Morz'
	db	00
L05C3:	db	'"Morz and I grew up together. He is very sensitive about his'
	db	' stutter, though, so I would not bring it up."'
	db	00
L062E:	db	'stutter'
	db	00
L0636:	db	'Morz'
	db	00
L063B:	db	'stutter'
	db	00
L0643:	db	'"It is difficult to get him to talk about it. I think it was'
	db	' caused by an accident he had when he was a child. I barely '
	db	'remember the incident. My brother might remember more."'
	db	00
L06F3:	db	'stutter'
	db	00
L06FB:	db	'Fellowship'
	db	00
L0706:	db	'"Rankin or Balayna would be the best ones to ask, '
	db	00
L0739:	db	', but I can tell thee our main tenets.~~"We believe strongly'
	db	' in neo-realism, which is a form of optimistic outlook which'
	db	' may be reached through the triad of inner strength.~~"I am '
	db	'hoping that soon I will be able to hear the    voice that co'
	db	'mes with meeting one\'s higher potential.~~"Also, '
	db	00
L085B:	db	', The Fellowship sponsors many feasts and festivals. I stron'
	db	'gly recommend that thou ask Rankin about joining."'
	db	00
L08CA:	db	'Fellowship'
	db	00
L08D5:	db	'reconvert'
	db	00
L08DF:	db	'"Reconvert? Why would I want to do that? Did my brother requ'
	db	'est this? He has always had a problem with letting me make m'
	db	'ine own decisions. Nay, '
	db	00
L0970:	db	'. I will not abandon my beliefs. The Fellowship has done too'
	db	' much for my life."'
	db	00
L09C0:	db	'"And to think thou art a fellow member. There is no unity in'
	db	' thy speech!"'
	db	00
L0A0A:	db	'*'
	db	00
L0A0C:	db	'bye'
	db	00
L0A10:	db	'"\'Til next time, '
	db	00
L0A22:	db	'."*'
	db	00
