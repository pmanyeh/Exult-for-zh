	; Function at file offset 00070148H
	.funcnumber  044CH
	.data
	.msize       0638H
	.dsize       04C5H
L0000:	db	'bye'
	db	00
L0004:	db	'job'
	db	00
L0008:	db	'name'
	db	00
L000D:	db	'Pamela'
	db	00
L0014:	db	'You startle a fighter who seems lost in thought.'
	db	00
L0045:	db	'His dog seemed to be meditating as well.'
	db	00
L006E:	db	'"Hello again," Rayburt says.'
	db	00
L008B:	db	'name'
	db	00
L0090:	db	'"I am Rayburt."'
	db	00
L00A0:	db	'He turns to the dog. "And this is Regal."'
	db	00
L00CA:	db	'Regal'
	db	00
L00D0:	db	'name'
	db	00
L00D5:	db	'Pamela'
	db	00
L00DC:	db	'job'
	db	00
L00E0:	db	'"I am a trainer. I specialize in a style of combat that reli'
	db	'es on concentration and meditation. It shall boost thy dexte'
	db	'rity and intelligence, as well as thy combat skill."'
	db	00
L018D:	db	'train'
	db	00
L0193:	db	'meditation'
	db	00
L019E:	db	'Regal'
	db	00
L01A4:	db	'"He is an exceptionally smart animal. He understands the med'
	db	'itative way of life."~~Rayburt throws the dog a cookie, whic'
	db	'h is snarfed up in the blink of an eye. "He is cute, too," R'
	db	'ayburt says with complete seriousness.'
	db	00
L027F:	db	'Regal'
	db	00
L0285:	db	'Pamela'
	db	00
L028C:	db	'You see a hint of a smile on Rayburt\'s face. "She and I are'
	db	' one person."'
	db	00
L02D5:	db	'Pamela'
	db	00
L02DC:	db	'meditation'
	db	00
L02E7:	db	'"Most of all combat occurs in the mind before the first blow'
	db	' is ever struck. The key to victory is to first win the inne'
	db	'r battle in the mind. Winning that inner battle is what I he'
	db	'lp my students to learn."'
	db	00
L03B5:	db	'meditation'
	db	00
L03C0:	db	'train'
	db	00
L03C6:	db	'"I charge 60 gold for a session, but thou wilt benefit great'
	db	'ly. Is this agreeable?"'
	db	00
L041A:	db	'"It is not the first time I have been accused of being too e'
	db	'xpensive."'
	db	00
L0461:	db	'"Please come to my studio during business hours if thou wish'
	db	'est to train."'
	db	00
L04AC:	db	'train'
	db	00
L04B2:	db	'bye'
	db	00
L04B6:	db	'Rayburt bows.*'
	db	00
