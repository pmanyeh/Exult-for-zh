	; Function at file offset 0006CB57H
	.funcnumber  0448H
	.data
	.msize       0939H
	.dsize       076EH
L0000:	db	'Avatar'
	db	00
L0007:	db	'Nell will not speak to you.*'
	db	00
L0024:	db	'You see a servant girl who looks at you in wonder. "Thou dos'
	db	't look familiar. Who art thou?"'
	db	00
L0080:	db	'"Oh. Hello. I am Nell."'
	db	00
L0098:	db	'"I thought so! I have seen thy portrait before. And I had he'
	db	'ard that thou wouldst be visiting! I\'m Nell."'
	db	00
L0102:	db	'"Hello, '
	db	00
L010B:	db	'."'
	db	00
L010E:	db	'bye'
	db	00
L0112:	db	'job'
	db	00
L0116:	db	'name'
	db	00
L011B:	db	'name'
	db	00
L0120:	db	'"I told thee my name is Nell."'
	db	00
L013F:	db	'name'
	db	00
L0144:	db	'job'
	db	00
L0148:	db	'"I am a chambermaid. I am responsible for keeping the castle'
	db	' tidy. Just a servant girl, really."'
	db	00
L01A9:	db	'servant'
	db	00
L01B1:	db	'castle'
	db	00
L01B8:	db	'castle'
	db	00
L01BF:	db	'"It is very large. Keeps me very busy. Thou wouldst not beli'
	db	'eve how dusty it gets."'
	db	00
L0213:	db	'castle'
	db	00
L021A:	db	'servant'
	db	00
L0222:	db	'"I suppose I\'ll always be a servant. My parents are servant'
	db	's. My brother is a servant. My fiance is a servant. My child'
	db	' will probably be a servant."'
	db	00
L02B7:	db	'child'
	db	00
L02BD:	db	'fiance'
	db	00
L02C4:	db	'brother'
	db	00
L02CC:	db	'parents'
	db	00
L02D4:	db	'servant'
	db	00
L02DC:	db	'parents'
	db	00
L02E4:	db	'"They work in the castle as well. Boots is my mother. Bennie'
	db	' is my father. They have been here for years. I was born in '
	db	'this castle and played in the nursery."'
	db	00
L0384:	db	'parents'
	db	00
L038C:	db	'brother'
	db	00
L0394:	db	'"Thou mightest run into him. He is also a servant in the cas'
	db	'tle. Charles. Other than not being as smart as I am, he is a'
	db	'll right. For a bumbling ass, that is!" She laughs.'
	db	00
L0440:	db	'brother'
	db	00
L0448:	db	'fiance'
	db	00
L044F:	db	'"That would be Carrocio, that dear man who runs the Punch an'
	db	'd Judy Show. He writes the loveliest love poetry. We are get'
	db	'ting married as soon as Carrocio can afford a wedding ring."'
	db	00
L0504:	db	'fiance'
	db	00
L050B:	db	'child'
	db	00
L0511:	db	'Nell looks worried. "Shhh! I do not want anyone to know. \'T'
	db	'is not showing yet, is it? Carrocio and I are getting marrie'
	db	'd as soon as possible. He -is- the father. I think. Then aga'
	db	'in, it could be... no, probably not him. Or could it be...? '
	db	'Hmmm. That would be interesting! Wait! What am I saying? The'
	db	' father is most definitely Carrocio! Please do not tell anyo'
	db	'ne. \'Twould be embarrassing. All right?"'
	db	00
L06A1:	db	'"I know I can trust thee, '
	db	00
L06BC:	db	'."'
	db	00
L06BF:	db	'"But thou wouldst ruin my reputation! Please -- a servant gi'
	db	'rl needs all the self-esteem she can get without that burden'
	db	'!" Nell turns away from you.*'
	db	00
L0755:	db	'child'
	db	00
L075B:	db	'bye'
	db	00
L075F:	db	'"Goodbye, '
	db	00
L076A:	db	'."*'
	db	00
