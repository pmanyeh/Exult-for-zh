	; Function at file offset 000B6F2DH
	.funcnumber  0495H
	.data
	.msize       1168H
	.dsize       0CEAH
L0000:	db	'bye'
	db	00
L0004:	db	'job'
	db	00
L0008:	db	'name'
	db	00
L000D:	db	'You see a three-headed hydra. The head on the left speaks.~~'
	db	' "Wake up, there is something here."'
	db	00
L006E:	db	'The head on the right looks up and at you.~~"I wonder if it '
	db	'is good to eat."*'
	db	00
L00BC:	db	'The middle head wakes with a start, sees you, becomes alarme'
	db	'd, and begins to snort excitedly.*'
	db	00
L011B:	db	'"Fear not, brother; we know it\'s there."*'
	db	00
L0145:	db	'"I wonder if it talks?"*'
	db	00
L015E:	db	'"We are not talking to thee! We are trying to eat thee!"*'
	db	00
L0198:	db	'name'
	db	00
L019D:	db	'"My name is Shandu. My brother next to me is Shanda. My brot'
	db	'her next to him is Shando."*'
	db	00
L01F6:	db	'"It does not matter what our names are!"*'
	db	00
L0220:	db	'Shanda shakes his head and glares at you.*'
	db	00
L024B:	db	'name'
	db	00
L0250:	db	'Shando'
	db	00
L0257:	db	'Shanda'
	db	00
L025E:	db	'Shandu'
	db	00
L0265:	db	'Shandu'
	db	00
L026C:	db	'"That is me."~~Shandu smiles and licks his lips.~~ "I like i'
	db	't when my food says my name!"'
	db	00
L02C6:	db	'Shandu'
	db	00
L02CD:	db	'Shanda'
	db	00
L02D4:	db	'Shanda rolls his eyes and exhales a puff of smoke from his n'
	db	'ostrils.*'
	db	00
L031A:	db	'"Shanda says that thou shouldst refrain from saying his name'
	db	'. He does not like it when his food says his name."*'
	db	00
L038B:	db	'Shanda'
	db	00
L0392:	db	'Shando'
	db	00
L0399:	db	'"That is me. I am the oldest brother."*'
	db	00
L03C1:	db	'"We are all connected, Shando! Thou cannot be older!"*'
	db	00
L03F8:	db	'"Mine head was the first to breathe the air."*'
	db	00
L0427:	db	'Shandu spits.~~"What does it matter? Our food does not care '
	db	'which of us is the eldest!"*'
	db	00
L0480:	db	'Shando'
	db	00
L0487:	db	'job'
	db	00
L048B:	db	'"Job?"'
	db	00
L0492:	db	'Shanda opens his mouth wide and emits a burst of flame.*'
	db	00
L04CB:	db	'"He thinks that is a joke. Job! Ha! I think it is amusing, t'
	db	'oo. I have never heard my food tell jokes."*'
	db	00
L0534:	db	'"Ah, but brothers, we -do- have a job."*'
	db	00
L055D:	db	'"We do?"*'
	db	00
L0567:	db	'"We guard the Caddellite, do we not? Our purpose in life is '
	db	'to guard the Caddellite!"'
	db	00
L05BD:	db	'Caddellite'
	db	00
L05C8:	db	'Caddellite'
	db	00
L05D3:	db	'Shanda becomes excited and snorts as if he were saying sever'
	db	'al sentences.'
	db	00
L061D:	db	'Caddellite'
	db	00
L0628:	db	'What did he say?'
	db	00
L0639:	db	'"Thou dost want to know about Caddellite? Very well, I shall'
	db	' tell thee about Caddellite."~~The hydra shifts its weight a'
	db	' moment, then grins wickedly.~~"We are guarding it."'
	db	00
L06E6:	db	'Caddellite'
	db	00
L06F1:	db	'guarding'
	db	00
L06FA:	db	'What did he say?'
	db	00
L070B:	db	'"He wasn\'t talking to thee!"'
	db	00
L0728:	db	'What did he say?'
	db	00
L0739:	db	'Caddellite'
	db	00
L0744:	db	'guarding'
	db	00
L074D:	db	'"The creature seems to echo everything we say, Shandu."*'
	db	00
L0786:	db	'Shanda makes a horrid growling noise.*'
	db	00
L07AD:	db	'"Shanda says he is hungry!"*'
	db	00
L07CA:	db	'"So am I!"*'
	db	00
L07D6:	db	'"Now that thou dost mention it, I am feeling a few hunger pa'
	db	'ngs myself. If we did not have to protect the Caddellite, I '
	db	'would eat this creature in a single gulp!"'
	db	00
L0879:	db	'guarding'
	db	00
L0882:	db	'protect'
	db	00
L088A:	db	'echo'
	db	00
L088F:	db	'echo'
	db	00
L0894:	db	'"Hearing this creature repeat whatever we say is making me h'
	db	'ungry!"*'
	db	00
L08D9:	db	'"It amuses me! Obviously it is a creature of severely limite'
	db	'd intelligence!"*'
	db	00
L0927:	db	'Shanda lets out a low growl.*'
	db	00
L0945:	db	'"Shanda says he wants something to eat!"'
	db	00
L096E:	db	'echo'
	db	00
L0973:	db	'protect'
	db	00
L097B:	db	'"I suppose we must protect the Caddellite from creatures lik'
	db	'e thee who come around once every 1000 years or so wanting t'
	db	'o take it."*'
	db	00
L0A00:	db	'Shanda growls louder than before, then breathes a bit of fir'
	db	'e.*'
	db	00
L0A40:	db	'"Creature! Thou art making Shanda angry! He thinks that thou'
	db	' art attempting to steal the Caddellite! Beware!"*'
	db	00
L0AAF:	db	'protect'
	db	00
L0AB7:	db	'steal'
	db	00
L0ABD:	db	'steal'
	db	00
L0AC3:	db	'Shandu becomes enraged.~~"I knew it! It is trying to steal o'
	db	'ur Caddellite!"~~Shandu addresses his brothers.~~"We must no'
	db	't delay any longer."*'
	db	00
L0B51:	db	'Shanda roars angrily!*'
	db	00
L0B68:	db	'"That is a good idea, my brother!"~~Shandu turns to you.~~ ['
	db	'"This creature vaguely resembles a troll, only it smells a l'
	db	'ittle more pleasant. Dost thou think it might taste better t'
	db	'han a troll, Shando?"*'
	db	00
L0C33:	db	'"We shall not know until we try!"*'
	db	00
L0C56:	db	'Shanda nods his head furiously, licking his lips.*'
	db	00
L0C89:	db	'"Very well! Let\'s eat it!"*'
	db	00
L0CA5:	db	'bye'
	db	00
L0CA9:	db	'"Thou cannot say \'bye\' to us! How rude!"'
	db	00
L0CD2:	db	'bye'
	db	00
L0CD6:	db	'"Leaving so soon?"*'
	db	00
