	; Function at file offset 000EA50DH
	.funcnumber  04CCH
	.data
	.msize       08E2H
	.dsize       06CDH
L0000:	db	'the Avatar'
	db	00
L000B:	db	'bye'
	db	00
L000F:	db	'job'
	db	00
L0013:	db	'name'
	db	00
L0018:	db	'You see a well-muscled woman who lifts her head in acknowled'
	db	'gement of your presence.'
	db	00
L006D:	db	'"Yes, '
	db	00
L0074:	db	'?"'
	db	00
L0077:	db	'name'
	db	00
L007C:	db	'The woman grabs your hand and shakes vigorously. "Hello. M'
	db	'\'name\'s Mara."'
	db	00
L00C5:	db	'"What is thine?"'
	db	00
L00D6:	db	'"The Avatar!" she shouts angrily. "Why thou art the one resp'
	db	'onsible for bringing those wretched gargoyles into our fine '
	db	'land!"*'
	db	00
L0156:	db	'"\'Tis good to meet thee!"'
	db	00
L0170:	db	'name'
	db	00
L0175:	db	'job'
	db	00
L0179:	db	'She flexes proudly, "I am a miner in Vesper."'
	db	00
L01A7:	db	'Vesper'
	db	00
L01AE:	db	'Vesper'
	db	00
L01B5:	db	'"This used to be a pleasant town," she looks around, apparen'
	db	'tly checking if anyone is near, "\'til the gargoyles became '
	db	'so unruly. Now most of us have to spend far too much time wo'
	db	'ndering when the gargoyles will decide they want to kill us.'
	db	'"'
	db	00
L02A6:	db	'us'
	db	00
L02A9:	db	'gargoyles'
	db	00
L02B3:	db	'Vesper'
	db	00
L02BA:	db	'gargoyles'
	db	00
L02C4:	db	'She shrugs. "There is naught to say, except that they are a '
	db	'menace. This town would be a much better place without them.'
	db	'"'
	db	00
L033E:	db	'gargoyles'
	db	00
L0348:	db	'us'
	db	00
L034B:	db	'"Well, I know Cador feels as I do, as does his wife. I have '
	db	'heard the mayor express his concern about them. I don\'t rea'
	db	'lly know his clerk, Liana."'
	db	00
L03DE:	db	'Liana'
	db	00
L03E4:	db	'mayor'
	db	00
L03EA:	db	'wife'
	db	00
L03EF:	db	'Cador'
	db	00
L03F5:	db	'us'
	db	00
L03F8:	db	'wife'
	db	00
L03FD:	db	'"Yvella is a lovely woman. She spends her days caring for th'
	db	'eir daughter, Catherine."'
	db	00
L0453:	db	'wife'
	db	00
L0458:	db	'Liana'
	db	00
L045E:	db	'"I have only seen her a few times. I do not know her well en'
	db	'ough to say this, but I think she is angry about something, '
	db	'for she is always in a bad mood."'
	db	00
L04F8:	db	'Liana'
	db	00
L04FE:	db	'Cador'
	db	00
L0504:	db	'"He is in charge of managing the mines. Does a fair job, too'
	db	'. He usually joins me at the Gilded Lizard."'
	db	00
L056D:	db	'Gilded Lizard'
	db	00
L057B:	db	'Cador'
	db	00
L0581:	db	'mayor'
	db	00
L0587:	db	'"His name is Auston. I like him, but I suspect that Liana is'
	db	' the one who truly keeps Vesper in order."'
	db	00
L05EE:	db	'mayor'
	db	00
L05F4:	db	'Gilded Lizard'
	db	00
L0602:	db	'"That is the tavern here in Vesper. Yongi\'s the barkeeper. '
	db	'He serves a passing fair tankard of ale."'
	db	00
L0667:	db	'Gilded Lizard'
	db	00
L0675:	db	'bye'
	db	00
L0679:	db	'Mara shakes your hand and slaps you on the back, saying, "Fa'
	db	're thee well, friend!"*'
	db	00
