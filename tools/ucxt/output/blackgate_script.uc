	; Function at file offset 00031324H
	.funcnumber  0407H
	.data
	.msize       123EH
	.dsize       0E0BH
L0000:	db	'bye'
	db	00
L0004:	db	'job'
	db	00
L0008:	db	'name'
	db	00
L000D:	db	'leave'
	db	00
L0013:	db	'You see a dashing, slender man, stylishly dressed, with a lo'
	db	't of flair.'
	db	00
L005B:	db	'"How may I help thee, '
	db	00
L0072:	db	'?" Sentri asks.'
	db	00
L0082:	db	'name'
	db	00
L0087:	db	'"Thou dost not remember me? I am Sentri! We have gone advent'
	db	'uring together in the past!"'
	db	00
L00E0:	db	'name'
	db	00
L00E5:	db	'job'
	db	00
L00E9:	db	'"When I am not adventuring with old friends, I am a trainer '
	db	'in Britain. I specialize in combat involving swordsmanship. '
	db	'I am quite good at that, as thou dost remember."'
	db	00
L0192:	db	'"But I would drop everything to join thy group if thou art n'
	db	'ot too encumbered."'
	db	00
L01E2:	db	'join'
	db	00
L01E7:	db	'friends'
	db	00
L01EF:	db	'train'
	db	00
L01F5:	db	'swordsmanship'
	db	00
L0203:	db	'Britain'
	db	00
L020B:	db	'friends'
	db	00
L0213:	db	'"I do not see our old friends Iolo, Shamino, or Dupre much."'
	db	00
L0250:	db	'friends'
	db	00
L0258:	db	'Dupre'
	db	00
L025E:	db	'Shamino'
	db	00
L0266:	db	'Iolo'
	db	00
L026B:	db	'swordsmanship'
	db	00
L0279:	db	'Sentri draws his sword so quickly it is like a flash of ligh'
	db	'tning. He does a few fancy moves, slashing the air with the '
	db	'blade. "No foe shall stand after I am finished with him!"'
	db	00
L032B:	db	'swordsmanship'
	db	00
L0339:	db	'join'
	db	00
L033E:	db	'Sentri bows. "I am very pleased to join thy group."'
	db	00
L0372:	db	'leave'
	db	00
L0378:	db	'"I like small crowds, Avatar. Thou art travelling with a gro'
	db	'up too large for my tastes. If thou shouldst lose someone al'
	db	'ong the way, return and I shall be happy to join thee."'
	db	00
L0428:	db	'join'
	db	00
L042D:	db	'leave'
	db	00
L0433:	db	'"Dost thou want me to wait here or go home?"'
	db	00
L0460:	db	'go home'
	db	00
L0468:	db	'wait here'
	db	00
L0472:	db	'wait here'
	db	00
L047C:	db	'"Very good. I shall wait here until thou dost return."*'
	db	00
L04B4:	db	'"Farewell, '
	db	00
L04C0:	db	'. If thou dost need my services again, I shall be only too h'
	db	'appy to comply."*'
	db	00
L050E:	db	'Britain'
	db	00
L0516:	db	'"I am becoming weary of the place. It is having growth pains'
	db	' of which the bourgeoisie are unaware. All is not as serene '
	db	'as the noblemen present it."'
	db	00
L05AB:	db	'Britain'
	db	00
L05B3:	db	'not serene'
	db	00
L05BE:	db	'not serene'
	db	00
L05C9:	db	'"Well, for example, try going to one of the smaller towns, s'
	db	'ay, Paws. It is a poor man\'s place. It reeks, too. And \'ti'
	db	's only just beyond the Britain town limits. More money shoul'
	db	'd be put into improving the land as a whole, not just in bui'
	db	'lding new buildings in the capitol city. I do not know what '
	db	'Lord British is thinking!"'
	db	00
L070E:	db	'not serene'
	db	00
L0719:	db	'Lord British'
	db	00
L0726:	db	'train'
	db	00
L072C:	db	'"My fee is 30 gold for a training session. Is this all right'
	db	'?"'
	db	00
L076B:	db	'"Then I shall rob someone else!" Sentri laughs aloud.'
	db	00
L07A1:	db	'"I am afraid I must adhere to my policy of training only dur'
	db	'ing my business hours. This applies to -all- of my friends."'
	db	00
L081A:	db	'train'
	db	00
L0820:	db	'"Since I am a member of thy group, I shall train thee for fr'
	db	'ee!"'
	db	00
L0861:	db	'Iolo'
	db	00
L0866:	db	'"How art thou, friend? Thou dost look like thou couldst use '
	db	'a little training thyself!"*'
	db	00
L08BF:	db	'"What is this? Everyone doth make fun of my physique!"*'
	db	00
L08F7:	db	'"I am not making fun, Iolo. I am serious!" Sentri laughs.'
	db	00
L0931:	db	'"I miss that fellow!"'
	db	00
L0947:	db	'Iolo'
	db	00
L094C:	db	'Shamino'
	db	00
L0954:	db	'"Say, Shamino, art thou still spending thy time dressing in '
	db	'women\'s clothes?"*'
	db	00
L09A3:	db	'"-What-?!?!"*'
	db	00
L09B1:	db	'"Or art thou wasting away thy life in a healer\'s den, now t'
	db	'hat thou art in thy middle ages?"*'
	db	00
L0A0F:	db	'"Careful, friend. Those are fighting words!"*'
	db	00
L0A3D:	db	'Sentri punches Shamino good-naturedly. "And that is all they'
	db	' are, my dear friend. Words! \'Tis good to see thee!"'
	db	00
L0AAE:	db	'"\'Twould be good to share a joke or two with him!"'
	db	00
L0AE1:	db	'Shamino'
	db	00
L0AE9:	db	'Dupre'
	db	00
L0AEF:	db	'"Ah, my good friend Dupre! Hast thou some good ale on thee?"'
	db	'*'
	db	00
L0B2D:	db	'"Art thou joking? I -always- have ale!"*'
	db	00
L0B56:	db	'"Then we should have some before someone else does!"'
	db	00
L0B8B:	db	'"\'Twould be a pleasure. However, I must be prudent and save'
	db	' the ale for when we need it."*'
	db	00
L0BE6:	db	'Sentri feels of Dupre\'s head. "Art thou feeling all right, '
	db	'Dupre? Or has knighthood done something to thy brain?"'
	db	00
L0C58:	db	'"No, but I would be glad to stop in a pub and share a few pi'
	db	'nts with thee!"*'
	db	00
L0CA5:	db	'"Mmmm! Sounds good to me! Next time we pass a place, let us '
	db	'stop!"'
	db	00
L0CE8:	db	'"I want to see that no-good trouble-maker! He is a knight no'
	db	'w, I hear! Sir Dupre indeed!"'
	db	00
L0D42:	db	'Dupre'
	db	00
L0D48:	db	'Lord British'
	db	00
L0D55:	db	'"I never see him much. He stays in that castle of his all th'
	db	'e time. He never gets out. No wonder he hasn\'t a clue what '
	db	'is going on in this country."'
	db	00
L0DEA:	db	'Lord British'
	db	00
L0DF7:	db	'bye'
	db	00
L0DFB:	db	'"Until later."*'
	db	00
