labelFunc0282_0756:
	if (!(var0002 == 0x0052)) goto labelFunc0282_0768;
	message("~~ ~~《向上就是向外》~~ ~~Goodefellow 着*");
	say();
	message("     此处讨论了关于引力和质量的最新理论。经过多年的学习和研究，作者终于将他劳动的成果写在这本书的书页上，其中包括他对掉落苹果的讨论。");
