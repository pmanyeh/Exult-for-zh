labelFunc0282_0037:
	if (!(var0002 == 0x0000)) goto labelFunc0282_004D;
	message("~~ ~~《未完成小说指南》~~  ~~Morgan 着*");
	say();
	message("~~     一篇关于空白书卷之谜的启发性论述。");
	say();
	message("~从迄今尚未解开的空白之谜开始...*第 2 页*第 3 页*第 4 页*第 5 页*第 6 页*第 7 页");
	say();
labelFunc0282_004D:
	if (!(var0002 == 0x0001)) goto labelFunc0282_006F;
	message("~~ ~~ 《死亡如何影响那些经常在它周围工作的人》*");
	say();
	message("第 1 天：受试者 (Tiery) 似乎相当友善，并且愿意接受我的陪伴。~");
	say();
	message("第 2 天：受试者表现出奇怪的幽默感，非常病态。~");
	say();
	message("第 3 天：没有与受试者接触。~");
	say();
	message("第 4 天：受试者不断提到最近与墓地居住者的对话。~");
	say();
	message("第 5 天：...");
	say();
labelFunc0282_006F:
	if (!(var0002 == 0x0002)) goto labelFunc0282_00A9;
	message("《我的笔记本》 Alagner 着~~");
	say();
	message("     这些是我关于一个名为「友谊会」的组织的观察。");
	say();
	message("虽然友谊会预示着自己是一个乐观主义者的团体，其理念被称为『内在力量的三位一体 (Triad of Inner Strength)』，但仔细审视该团体的『价值观』，可以发现许多谬误。");
	say();
	message("第一个价值观是『致力合一 (Strive For Unity)』。这暗示我们都应该和谐地一起工作，朝着人生中的同一个目标迈进。然而，仔细审视这项原则会发现，友谊会的成员认为自己是一个菁英团体，而且带有偏见。他们倾向于认为，如果一个人不支持他们，那么那个人就是反对他们！而如果一个人反对他们，那么愿好运与那个人同在，因为他/她很可能会落得个悲惨的下场！");
	say();
	message("第二个价值观是『信赖你的兄弟 (Trust Thy Brother)』。这暗示每个成员都绝对信任其他友谊会成员，而且每个人都会无条件地为另一个人帮忙或做事。另一方面，这可能意味着一个成员应该听从另一个人的指示，无论该行为的含义为何。换句话说，『照我说的做，不要质疑！』似乎是这项原则潜在的潜台词。");
	say();
	message("第三个价值观是『价值先行于报偿 (Worthiness Precedes Reward)』。如果一个人为友谊会做了好事，那么他就会得到回报。当然，硬币的另一面是，如果一个人没有为友谊会做好事，那么他将得到他『应得的』回报！在友谊会中，『回报』可以是『好』的，也可以是『坏』的！");
	say();
	message("二十年来，友谊会一直在欺骗不列颠尼亚的大众。他们变得越来越强大。经过仔细研究，我得出了一个结论：这个团体正在为某个更高级、邪恶的实体服务，该组织的内部内核圈将其称为『守护者 (The Guardian)』。需要取得更多关于守护者的信息，但我确信他非常危险。");
	say();
	message("友谊会似乎被组织成三个不同等级的成员。第一级是由加入的那些天真无邪的群众组成，他们以为自己可悲的小生活会以某种方式得到帮助。第二级由组成友谊会领导人内部内核圈的各个分部领导人组成。");
	say();
	message("还有第三级——那些在团体中担任行政职务的友谊会领导人：例如巴特林，以及神秘的 Elizabeth 和 Abraham 夫妇，他们在全国各地分发友谊会的资金。（对这两个人所知不多——据说他们是双胞胎——兄妹或姐弟。）我相信这少数的第三级成员与守护者有直接的联系，并相信如果守护者最终获得这片土地的权力，他们将成为他的副手。");
	say();
	message("守护者已经展现出成为一个强大威胁的迹象。在过去几年里，不列颠尼亚的魔法出现了恶化的情况。我相信守护者做了一些事情来导致这种疾病。没有多少人注意到不列颠尼亚的月门问题——它们变得如此不可靠——也大约发生在同一时间。由此推断，守护者很可能是造成这场严重灾难的罪魁祸首。");
	say();
	message("守护者还拥有一种特殊的力量，让他能够与天真无邪的人交谈并『魅惑』他们，让他们乐意加入友谊会并成为第一级成员。如果守护者有朝一日掌权，这些不幸的羔羊很可能会成为他的奴隶。");
	say();
	message("在我获得足够的证据来证明我关于友谊会的理论后，我将把这本笔记本呈给不列颠王本人，让不列颠尼亚摆脱这些非常危险、满口谎言的法西斯分子。");
	say();
labelFunc0282_00A9:
	if (!(var0002 == 0x0003)) goto labelFunc0282_00D3;
	message("法师 Rudyom 的《黑石观察》~~");
	say();
	message("     被称为「黑石」的神秘物质是完全坚不可摧的。只有通过魔法手段，它才能被塑造和成型。");
	say();
	message("黑石在地底下的数量很少，有时可以在铁矿脉或铅矿脉附近找到。");
	say();
	message("黑石可以用传统方法挖掘，但将其熔化成具延展性的物质是不可能的，除非通过魔法。");
	say();
	message("我发现电能和磁能的结合对这种物质有深远的影响。这些属性加在一起会使黑石变得具有渗透性，也就是说，人们可以将手穿过这种物质，就像它是水一样！");
	say();
	message("进一步的研究显示，如果魔法、电能、磁能和天体的正确排列共同作用于该物质，黑石可能会作为一种发送设备。这个理论还有待测试。");
	say();
	message("我用一根旧魔杖改造而成的黑石转化器无法运作。它原本的目的是将电磁电荷射入黑石中，但它唯一能做的就是让物质爆炸！（我必须小心不要让转化器落入坏人手中。将它指向大量的黑石可能会产生毁灭性的爆炸！）");
	say();
	message("今天我必须停工了。一直困扰我的头痛变得更严重了。我忘记的事情越来越多。我很害怕，很快我就会忘记如何施展简单的法术。我相信可能有什么东西正在影响魔法以太。但我不敢确定...");
	say();
labelFunc0282_00D3:
	if (!(var0002 == 0x0004)) goto labelFunc0282_00E5;
	message("~~ ~~ 《异乡异客》~~ ~~Robert Heinlein 着~~初版*");
	say();
	message("  这本书讲述了一个来自外星球的个体，在难以融入他的新社会和文化市时所经历的挣扎。");
	say();
labelFunc0282_00E5:
	if (!(var0002 == 0x0005)) goto labelFunc0282_00F7;
	message("~~ ~~《飞天老爷车》(CHITTY-CHITTY-BANG-BANG)~~ ~~Ian Fleming 着*");
	say();
	message("    这个关于一辆会飞的汽车的美妙童话故事，世世代代以来一直深受着儿童和成人的喜爱。");
	say();
labelFunc0282_00F7:
	if (!(var0002 == 0x0006)) goto labelFunc0282_0109;
	message("~~ ~~《绿野仙踪》 ~~ ~~Frank L. Baum 着*");
	say();
	message("     这是一个关于小女孩 Dorothy，和她的狗 Toto 一起，穿越旋风和魔法来到一个叫做 Oz 的奇妙土地的故事。Dorothy 在这片土地上寻找理想的过程，让她赢得了三个新朋友。第一个是一个没有大脑的稻草人，他最终的智能教会了她真理的原则。第二个是一个没有心的锡人，他永恒的奉献向她展示了爱的原则。最后，Dorothy 遇到了一只胆小的狮子，牠面对一切危险来拯救她，展现了勇气的原则。");
	say();
labelFunc0282_0109:
	if (!(var0002 == 0x0007)) goto labelFunc0282_0123;
	message("~~ ~~ 《Hubert 令人毛骨悚然的冒险》 ~~ ~~Bill Peet 着*");
	say();
	message("狮子 Hubert 傲慢又虚荣，尤其对他优雅的鬃毛感到自豪。~但这种自负一点也不合适，所以狮子 Hubert 注定要摔一跤。~有一天，当他在岩石上磨爪子时，他受到了最可怕、最糟糕的惊吓。");
	say();
	message("~一朵燃烧的火花飞到了空中，落在了他的头上，点燃了他的头发。~伴随着一声惊讶的咆哮，他像一阵风一样跑开了，穿过丛林来到了 Zamboozi 溪流。~他扑通一声跳了进去！溅起了一阵水花，然后带着满头短髭浮了上来。~起初，他只是张大嘴巴盯着，看着那团黑烟向南飘去。");
	say();
	message("然后他用爪子摸了摸耳后，突然意识到了他最深的恐惧。~『我全毁了，』他大喊道，『哦，我该怎么办！我宁愿死了，或者去动物园生活！~如果有人看到我，哦，那是多么可耻，所以我最好找个好地方躲起来！』");
	say();
labelFunc0282_0123:
	if (!(var0002 == 0x0008)) goto labelFunc0282_0149;
	message("~~Yew 高等法院的记录~~ ~~ ~~");
	say();
	gflags[0x0126] = true;
	message("... Hook -- Hook 被认为是一名极度危险的杀手，一名离开了自己的一帮无赖，成为任何能出得起价钱的人的自由刺客的海盗。据信他与不列颠尼亚至少十四起谋杀案有关。所有的受害者都被一种锋利的物体割伤，据信这是一只钩子手的手笔。");
	say();
	message("     目前尚不清楚 Hook 居住在哪里，但许多人认为他在海盗巢穴 (Buccaneer's Den)有一个秘密藏身处。他最近一次被目击证实，他正与一名名叫 Forskis 的战士石像鬼同行。~~");
	say();
	message("... Kellin... 在几个城镇因盗窃罪被通缉。他使用过许多化名，包括 Tervis、Kreg 和 Hodge。他最后一次被看见是在 Yew 的森林附近，据信他已经躲藏起来了。~~");
	say();
	message("... Sullivan... 在几个城镇因诈欺、盗窃和其他轻微罪行被通缉。已知他是友谊会的成员，尽管友谊会否认有这样一名成员存在。在许多关于该男子犯罪的报告中，受害者都表示他自称是圣者。");
	say();
	gflags[0x0159] = true;
