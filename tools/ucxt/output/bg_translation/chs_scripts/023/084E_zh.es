	message("「这些问题都是假设性的。不要让它们使你困惑或不安。~~第一个问题：你现在感到很沮丧。最可能的原因是 -~１：你让朋友失望了，或者~２：朋友让你失望了？」");
	say();
	var0001 = Func090B(["１：我让朋友失望了", "２：朋友让我失望了"]);
	if (!(var0001 == "１：我让朋友失望了")) goto labelFunc084E_0034;
	message("「我从你的回答中可以看出，你是一个对他人责任看得很重的人，而且可能倾向于给自己太大的压力去取悦别人。」巴特林微笑着点点头。");
	say();
	goto labelFunc084E_0038;
labelFunc084E_0034:
	message("「我从你的回答中可以看出，你是一个倾向于信任别人，且经常愿意给别人第二次机会的人——即使在充分证明他们不值得这样对待之后。」巴特林微笑着点点头。");
	say();
labelFunc084E_0038:
	UI_clear_answers();
	message("「第二个问题：你正在参加一个由当地高端官员主办的宴会。你认为他点的食物简直像馊水，而且你注意到其他客人显然也这么认为。当主人问你喜不喜欢这些食物时，你会~１：说实话，或者~２：对他说谎？」");
	say();
	var0002 = Func090B(["１：说实话", "２：对他说谎"]);
	if (!(var0002 == "１：说实话")) goto labelFunc084E_0060;
	message("「你的回答显示，你是一个直言不讳的诚实人，有时可能会说出别人不爱听的话，但你的意图是高尚的。」巴特林用手做了一个夸张的手势。");
	say();
	goto labelFunc084E_0064;
labelFunc084E_0060:
	message("「你的回答显示，你是一个非常关心他人感受的人，一个把礼貌和优雅看得比什么都重要的人。」巴特林用手做了一个夸张的手势。");
	say();
labelFunc084E_0064:
	UI_clear_answers();
	message("「第三个问题：你住进了旅店里最后一间空房。进去后你发现房间很脏。现在是半夜，没有人能打扫，也没有其他地方可以住了。你会~１：自己动手打扫一下，至少清理一部分，然后再休息，或者~２：你就直接睡觉，让房间保持原样？」");
	say();
	var0003 = Func090B(["１：自己打扫房间", "２：让房间保持原样"]);
	if (!(var0003 == "１：自己打扫房间")) goto labelFunc084E_008C;
	message("「你已经暴露出，你是一个本能地认为，自己要对任何出错的事情负责的人，并且认为把整个世界拉回正轨是你的责任。」巴特林叹了口气。");
	say();
	goto labelFunc084E_0090;
labelFunc084E_008C:
	message("「你已经暴露出，你是一个当生活显得不公时，倾向于自满地接受命运的人。你自然而然地假设生活是不友善的，以此作为生活真的不友善时的保护。」巴特林叹了口气。");
	say();
labelFunc084E_0090:
	UI_clear_answers();
	message("「第四个问题：在一个节日聚会上，你讲了一个幽默的轶事，而且你讲得非常好，带来了很多欢乐。你讲这个喜剧故事是因为~１：你喜欢听众给你的反应，或者~２：因为你想取悦你的朋友？」");
	say();
	var0004 = Func090B(["１：我喜欢听众的反应", "２：我想取悦朋友"]);
	if (!(var0004 == "１：我喜欢听众的反应")) goto labelFunc084E_00B8;
	message("「你的回答显示，你是一个本能地把朋友视为满足自己欲望工具的人。」巴特林微微皱眉。");
	say();
	goto labelFunc084E_00BC;
labelFunc084E_00B8:
	message("「你的回答显示，你是一个本能地觉得自己不配拥有朋友的人。你必须不断地通过取悦他们来买取他们的注意力。」巴特林微微皱眉。");
	say();
labelFunc084E_00BC:
	UI_clear_answers();
	message("「第五个问题：如果你成为一个累积了惊人财富的人，最可能的原因是~１：你发现了一种绝对不会失败的偷钱方法，或者~２：你发现了一种绝对不会失败的非法拷贝王国硬币的方法？」");
	say();
	var0005 = Func090B(["１：我偷了别人的钱", "２：我拷贝了硬币"]);
	if (!(var0005 == "１：我偷了别人的钱")) goto labelFunc084E_00E4;
	message("「从第五个问题我们了解到，你是一个本能地认为自己无法获得成功的人，一个觉得只能通过剥削他人来获利的人。」巴特林慢慢地摇了摇头。");
	say();
	goto labelFunc084E_00E8;
labelFunc084E_00E4:
	message("「从第五个问题我们了解到，你是一个本能地认为自己无法获得成功的人，充其量只能呈现出成功的幻觉。」巴特林慢慢地摇了摇头。");
	say();
labelFunc084E_00E8:
	UI_clear_answers();
	message("「第六个问题：在旅行时，你发现一个男人正处于极度痛苦之中。他的手臂受了重伤。一位照顾他的治疗师告诉你，这个男人的手臂必须被切除，并且需要你的帮助来完成。这个男人说他的伤会恢复的，并要求你不要让治疗师切除他的手臂。你会~１：听从治疗师的建议，或者~２：尊重这个受伤男人的意愿？」");
	say();
	var0006 = Func090B(["１：听从治疗师的建议", "２：尊重那个人的意愿"]);
	if (!(var0006 == "１：听从治疗师的建议")) goto labelFunc084E_0110;
	message("「从你的回答来看，你是一个即使在不容易的情况下也相信仁慈的人，也是一个努力让自己有信念与勇气的人。」巴特林给了你一个会意的眼神。");
	say();
	goto labelFunc084E_0114;
labelFunc084E_0110:
	message("「从你的回答来看，你是一个深信人类生命价值的人，也是一个对生命不断赋予我们的可能性抱有强烈信念的人。」巴特林给了你一个会意的眼神。");
	say();
labelFunc084E_0114:
	UI_clear_answers();
	message("「第七个问题：你刚用石头砸死了一只小狗。你之所以这么做，最可能的原因是~１：那只狗要攻击你，或者~２：那只狗要攻击别人？」");
	say();
	var0007 = Func090B(["１：牠要攻击我", "２：牠要攻击别人"]);
