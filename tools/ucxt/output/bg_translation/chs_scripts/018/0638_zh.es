labelFunc0638_0077:
	UI_play_sound_effect2(0x000E, item);
	UI_book_mode(item);
	
	// 攔截 149 號！
	if (!(var0000 == 149)) goto labelFunc0638_OriginalCheck;
	message("~~ ~~《不列颠尼亚古文译本》~~ ~~皇家翻译局 发行~~");
	say();
	message("     这本古老的辞典，记载着古老卢恩文本，与通用文本的对照。");
	say();
	message("翻开至内核扉页，其上绘有一道复杂而华丽的几何魔法阵；纵然岁月使其有些许斑驳与磨损，但在微光下，那古老的魔力纹路依然隐隐泛着紫色的幽芒，正静候着与汝之意识产生共鸣。");
	say();
	message("…是在魔法的作用下，似乎不仅对卢恩符文有效…");
	say();
	message("     只要将此书携带在队伍中，您便能奇迹般地，再脑中浮现你所熟悉的文本。");
	say();
	goto labelFunc0638_0627;

labelFunc0638_OriginalCheck:
	if (!(var0000 > 0x0094)) goto labelFunc0638_0092;
	message("这『不是』一本有效的书");
	say();
labelFunc0638_0092:
	if (!(var0000 == 0x0064)) goto labelFunc0638_00AC;
	message("~~ ~~龙类图鉴~~ ~~Perrin 着*");
	say();
	message("     几乎只在 Destard 地城中被发现，龙是一种古老的大型爬虫类种族。牠们拥有极高的智商，其中少数还会使用魔法，有时会召唤其他生物与牠们一同战斗——或是为牠们战斗。~");
	say();
	message("     然而，在战斗中，即使没有任何援助，牠们也相当难以对付。因为除了锋利的爪子和满口如剃刀般的牙齿外，牠们还能喷吐出大片致命的火焰。这点，再加上牠们隐形的能力，让牠们足以应付任何愚蠢到敢于招惹牠们的人。~");
	say();
	message("     如果你能找到一只愿意与你谈判的龙，我强烈建议你这么做，因为很少有人能在与这些可怕蜥蜴的战斗中幸存下来，更不用说取得胜利了。");
	say();
labelFunc0638_00AC:
	if (!(var0000 == 0x0065)) goto labelFunc0638_00EE;
	message("~~ ~~Garret Moore 日记*");
	say();
	message("第 1 天：我抵达了这座被遗弃的岛屿。~~");
	say();
	message("第 3 天：发现了一座建筑的废墟。是座塔？~~");
	say();
	message("第 4 天：需要庇护所。开始重建这座塔。~~");
	say();
	message("第 7 天：塔。~~");
	say();
	message("第 12 天：塔。~~");
	say();
	message("第 21 天：基础支撑几乎完成。明天从临时庇护所搬离。~~");
	say();
	message("第 29 天：扩建塔楼。开始研究与实验，以繁殖作为食物的家畜品种。~~");
	say();
	message("第 45 天：塔楼完工。实验差点就成功了。很快就会有生命诞生，我确信！~~");
	say();
	message("第 73 天：我成功了！一种不需我协助就能繁殖的细胞组合！自给自足的生命不远了！~~");
	say();
	message("第 97 天：我接近答案了，毫无疑问。但还有其他人想看我失败！他们把天空变成紫色，并向我投掷闪电。~~");
	say();
	message("第 111 天：其他人仍在试图阻挠我！我听到他们的声音命令我停止。在我完成之前，我绝不休息！~~");
	say();
	message("第 101 天：他们又来了。他们派了一名魅魔来诱惑我。她只会反复说着：『吻我，吻我。』我的回答只有一个：『不。』我会保持坚强！");
	say();
	message("第 40232 天：哈！那些声音现在在乞求，但在他离开之前我不会结束。夜晚是我的避风港，狗儿会吠叫！~~");
	say();
labelFunc0638_00EE:
	if (!(var0000 == 0x0066)) goto labelFunc0638_0100;
	message("~~ ~~变形吸血鬼，Karen Elizabeth Gordon 着*");
	say();
	message("     这本细节丰富的巨著，是一本『专为无辜者、渴望者与命运注定受苦者所编纂的语法手册』。");
	say();
labelFunc0638_0100:
	if (!(var0000 == 0x0067)) goto labelFunc0638_0116;
	message("~~ ~~亡者之书~~ ~~Suvol Shadowface 着*");
	say();
	message("     这本书皱巴巴的书页似乎是由一种奇特的皮革制成的。它包含了各种关于如何处理死者，特别是遗体的文章。");
	say();
	message("     其中一章名为《人类心脏的 101 种用途》。另一段落描述了如何将人皮揉制并压实，作为书写材料的方法……");
	say();
labelFunc0638_0116:
	if (!(var0000 == 0x0068)) goto labelFunc0638_0130;
	message("~~ ~~黑暗神器~~ ~~Mordra Morgaelin 着*");
	say();
	message("     在这本手抄书的书页中，有许多关于具有毁灭性力量设备的参考。其中包括了 Mondain 的头骨与不朽宝石、Minax 的水晶戒指，以及 Exodus 记忆的黑暗内核。");
	say();
	message("     较近期的条目描述了巫妖王之冠、灵魂之井，以及一把神秘的黑石剑，显然这把剑拥有能够杀死像不列颠王这样强大人物的力量。");
	say();
	message("     一篇简短的文章提到一块挂在门上方的金属板，解释了一种似乎更简单的方法来解决这位高贵的君主。");
	say();
labelFunc0638_0130:
	if (!(var0000 == 0x0069)) goto labelFunc0638_0142;
	message("~~ ~~黎明之光~~ ~~Drennal 着*");
	say();
	message("     这是一本简短的书，详细探讨了不列颠尼亚的两颗月亮：Trammel 和 Felucca，解释了它们的轨道、大致大小及预期的成分。此外，还有一篇短文讨论了这些月球上是否可能有人居住，以及如何联系他们。这部作品还包含了一个关于一位女巫发现改变 Felucca 颜色方法的短篇故事。在测试了她的观察后，她很快就了解到这些改变对任何人或事物都没有什么影响。");
	say();
labelFunc0638_0142:
	if (!(var0000 == 0x006A)) goto labelFunc0638_0154;
	message("~~ ~~Codavar~~ ~~Nexa 着*");
	say();
	message("     这本小说的书页中包含了一个关于篡位领主的故事，似乎是受到两百多年前不列颠王失踪期间 Blackthorn 暴虐统治的启发。");
	say();
labelFunc0638_0154:
	if (!(var0000 == 0x006B)) goto labelFunc0638_016A;
	message("~~ ~~仪式魔法~~ ~~Nicodemus 着*");
	say();
	message("     将自身力量与另一位法师力量结合的能力，是施展结界的基础。站在五芒星外围的三角形中，最多五名巫师可以增强他们法术的效果。必须从山羊、绵羊或猫中放血——每位法师一只——此外还要消耗第三型酸性蛞蝓的分泌物。~");
	say();
	message("     一旦所有材料收集齐全，每位法师必须站在由龙腿骨粉末画成的五芒星的五个角落之一……");
	say();
labelFunc0638_016A:
	if (!(var0000 == 0x006C)) goto labelFunc0638_0180;
	message("~~ ~~位面旅行途径~~ ~~Nicodemus 着*");
	say();
	message("     这里有许多在众多不同存在位面之间旅行和穿越所需的复杂公式。每个位面都由月门进入，甚至我们自己的不列颠王也是通过月门从这些位面之一来到不列颠尼亚的。~");
	say();
	message("     然而，这也引发了一些担忧。到目前为止，每一个从其他位面进入不列颠尼亚的人都是仁慈的（最著名的是不列颠王和圣者）。但如果他们有能力使用这些发送门，难道就没有其他邪恶的生物也可能随意闯入我们这片美好土地的机会吗？这是一个未来必须考虑的问题。");
	say();
labelFunc0638_0180:
	if (!(var0000 == 0x006D)) goto labelFunc0638_0196;
	message("~~ ~~家用物品附魔~~ ~~Nicodemus 着*");
	say();
	message("     这部典籍的书页上记载了许多关于制造『世俗』魔法器具与设备的配方，其中包括诸如『自动扫帚』、『幽灵书写羽毛笔』以及『警报宝石』等物品。");
	say();
	message("在书本未完成的结尾部分，内容变得不稳定且几乎难以辨认，仿佛是匆忙写下的。后面的许多物品似乎有些疯狂：巨大的黑曜石苍蝇拍、会爆炸的玉米棒架，以及多刃梳子。看来这位法师在施法时可能并没有准备好他所有的施法材料。");
	say();
labelFunc0638_0196:
	if (!(var0000 == 0x006E)) goto labelFunc0638_01A8;
	message("~~ ~~杂项小戏法~~ ~~佚名*");
	say();
	message("     如标题所示，这本书描述了属于江湖骗子和魔术师职责范围内的小法术。");
	say();
labelFunc0638_01A8:
	if (!(var0000 == 0x006F)) goto labelFunc0638_01BA;
	message("~~ ~~现代死灵法术~~ ~~Horance 着*");
	say();
	message("     这本充满诗意的论文作者试图展示死灵法术多年来是如何被污名化的，并解释了通过研究魔法对无生命尸体的影响可以获得的有益知识，其中包括最近一种将生命归还给已死同伴的技艺，也就是所谓的复活。");
	say();
labelFunc0638_01BA:
	if (!(var0000 == 0x0070)) goto labelFunc0638_01CC;
	message("~~ ~~符文符号学~~ ~~Smidgeon the Green 着*");
	say();
	message("     里面可以找到用于理解和翻译符文的完整术语词典。此外，这部作品深入探讨了符文与魔法之间的关系。从里面强烈的文本来看，作者要么是个彻头彻尾的笨蛋，要么就是个单纯的天才。");
	say();
